<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diana_arm">

  <xacro:include filename="$(find diana_description)/robots/common/utils.xacro" />

  <xacro:macro name="diana_collision_capsules" params="caps_list i safety_distance:=0.03">
    <xacro:unless value="${i >= len(caps_list)}">
      <xacro:property name="c" value="${caps_list[i]}" lazy_eval="false"/>
      <xacro:collision_capsule
          xyz="${c.xyz}"
          direction="${c.direction}"
          radius="${c.radius + safety_distance}"
          length="${c.length}" />
      <xacro:diana_collision_capsules caps_list="${caps_list}" i="${i+1}"
                                      safety_distance="${safety_distance}" />
    </xacro:unless>
  </xacro:macro>

  <!-- safety_distance: Minimum safety distance in [m] by which the collision volumes are expanded and which is enforced during robot motions -->
  <!-- robot_type: the diana robot arm type -->
  <!-- joint_limits: description of the joint limits that comes from a YAML file. Example definition: ${xacro.load_yaml('$(find diana_description)/robots/diana3/joint_limits.yaml')} -->
  <!-- kinematics: description of the kinematics that comes from a YAML file. Example definition: ${xacro.load_yaml('$(find diana_description)/robots/diana3/kinematics.yaml')} -->
  <!-- inertials: description of the inertials that comes from a YAML file. Example definition: ${xacro.load_yaml('$(find diana_description)/robots/diana3/inertials.yaml')} -->
  <!-- dynamics: description of the dynamics that comes from a YAML file. Example definition: ${xacro.load_yaml('$(find diana_description)/robots/diana3/dynamics.yaml')} -->

  <xacro:macro name="diana_arm" params="robot_type arm_prefix:='' no_prefix:=false description_pkg:='diana_description' connected_to:='base' xyz:='0 0 0' rpy:='0 0 0' gazebo:='false' safety_distance:=0 with_sc:=false" >

    <xacro:property name="joint_limits" value="${xacro.load_yaml('$(find diana_description)/robots/' + robot_type + '/joint_limits.yaml')}"/>
    <xacro:property name="inertials" value="${xacro.load_yaml('$(find diana_description)/robots/' + robot_type  + '/inertials.yaml')}"/>
    <xacro:property name="kinematics" value="${xacro.load_yaml('$(find diana_description)/robots/' + robot_type + '/kinematics.yaml')}"/>
    <xacro:property name="accelerometer_config" value="${xacro.load_yaml('$(find diana_description)/robots/' + robot_type + '/accelerometers.yaml')}"/>
    <xacro:property name="dynamics" value="${xacro.load_yaml('$(find diana_description)/robots/' + robot_type + '/dynamics.yaml')}"/>
    <xacro:property name="collision_capsule" value="${xacro.load_yaml('$(find diana_description)/robots/' + robot_type + '/collision_capsule.yaml')}" />

    <!-- Define a property that defaults to 'arm_prefix_robot_type' concatenated with an underscore if 'no_prefix' is not set -->
    <xacro:property name="prefix" value="${'' if no_prefix else arm_prefix + robot_type + '_'}" />
    <xacro:property name="with_accelerometers" value="${'false' if accelerometer_config == 'none' else 'true'}" />

    <xacro:if value="${gazebo and connected_to == 'base'}">
      <xacro:property name="connected_to" value="" />
    </xacro:if>

    <xacro:unless value="${not connected_to}">
      <link name="${connected_to}">
      </link>
      <joint name="${prefix}${connected_to}_joint" type="fixed">
        <parent link="${connected_to}"/>
        <child link="${prefix}link0"/>
        <origin rpy="${rpy}" xyz="${xyz}"/>
      </joint>
    </xacro:unless>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link0" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="${with_accelerometers}">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link0}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link1" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="${with_accelerometers}">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link1}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint1" type="revolute">
      <xacro:diana-kinematics name="joint1" config="${kinematics}" />
      <parent link="${prefix}link0" />
      <child link="${prefix}link1" />
      <axis xyz="0 0 1" />
      <xacro:diana-limits name="joint1" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint1" config="${dynamics}" />
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link2" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="${with_accelerometers}">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link2}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint2" type="revolute">
      <xacro:diana-kinematics name="joint2" config="${kinematics}" />
      <parent link="${prefix}link1" />
      <child link="${prefix}link2" />
      <axis xyz="0 0 1" />
      <xacro:diana-limits name="joint2" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint2" config="${dynamics}" />
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link3" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="${with_accelerometers}">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link3}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint3" type="revolute">
      <xacro:diana-kinematics name="joint3" config="${kinematics}" />
      <parent link="${prefix}link2" />
      <child link="${prefix}link3" />
      <axis xyz="0 0 1" />
      <xacro:diana-limits name="joint3" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint3" config="${dynamics}" />
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link4" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="${with_accelerometers}">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link4}" i="0" safety_distance="${safety_distance}"/>
     </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint4" type="revolute">
      <xacro:diana-kinematics name="joint4" config="${kinematics}" />
      <parent link="${prefix}link3" />
      <child link="${prefix}link4" />
      <axis xyz="0 0 1" />
      <xacro:diana-limits name="joint4" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint4" config="${dynamics}" />
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link5" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="${with_accelerometers}">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link5}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint5" type="revolute">
      <xacro:diana-kinematics name="joint5" config="${kinematics}" />
      <parent link="${prefix}link4" />
      <child link="${prefix}link5" />
      <axis xyz="0 0 1" />
      <xacro:diana-limits name="joint5" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint5" config="${dynamics}" />
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link6" gazebo="${gazebo}" with_sc="${with_sc}" with_accelerometers="false">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link6}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint6" type="revolute">
      <xacro:diana-kinematics name="joint6" config="${kinematics}" />
      <parent link="${prefix}link5" />
      <child link="${prefix}link6" />
      <axis xyz="0 0 1" />
      <xacro:diana-limits name="joint6" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint6" config="${dynamics}" />
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link7" gazebo="${gazebo}" rpy="0 0 0" with_sc="${with_sc}" with_accelerometers="false">
      <self_collision_geometries>
        <xacro:diana_collision_capsules caps_list="${collision_capsule.link7}" i="0" safety_distance="${safety_distance}"/>
      </self_collision_geometries>
    </xacro:link_with_sc>

    <joint name="${prefix}joint7" type="revolute">
      <xacro:diana-kinematics name="joint7" config="${kinematics}" />
      <parent link="${prefix}link6"/>
      <child link="${prefix}link7"/>
      <axis xyz="0 0 1"/>
      <xacro:diana-limits name="joint7" config="${joint_limits}" />
      <xacro:diana-dynamics name="joint7" config="${dynamics}" />
    </joint>

    <link name="${prefix}link8"/>

    <joint name="${prefix}joint8" type="fixed">
      <xacro:diana-kinematics name="joint8" config="${kinematics}" />
      <parent link="${prefix}link7" />
      <child link="${prefix}link8" />
    </joint>
  </xacro:macro>
</robot>
