+#: read_file is sent non-strict upstream; a malformed call gets this error back.
+READ_FILE_SHAPE_ERROR = (
+    "ERROR: read_file takes an object: path=\"<file or page name>\" (a string), optional "
+    "offset and limit (whole numbers >= 1). Call it again in that shape."
+)
+#: request_render is sent non-strict (its ``pose`` map cannot be strict), so the API no longer
+#: guarantees its argument shape: a malformed call gets this error back instead of raising.
+REQUEST_RENDER_SHAPE_ERROR = (
+    "ERROR: request_render takes an object: views=[view names] (required), optional "
+    "focus=[part or joint names], pose={joint name: number}, camera={azimuth_deg, "
+    "elevation_deg, distance_mult} and segment=true/false. Call it again in that shape."
+)
+
+
+def _request_render_arguments_error(args: Any) -> str | None:
+    """None for a well-formed request_render call; otherwise the error the model can act on."""
+    if not isinstance(args, dict):
+        return REQUEST_RENDER_SHAPE_ERROR
+    for key in ("views", "focus"):
+        value = args.get(key)
+        if value is not None and not (
+            isinstance(value, list) and all(isinstance(item, str) for item in value)
+        ):
+            return REQUEST_RENDER_SHAPE_ERROR
+    pose = args.get("pose")
+    if pose is not None and not (
+        isinstance(pose, dict)
+        and all(
+            isinstance(name, str)
+            and isinstance(value, (int, float))
+            and not isinstance(value, bool)
+            and abs(value) <= sys.float_info.max
+            for name, value in pose.items()
+        )
+    ):
+        return REQUEST_RENDER_SHAPE_ERROR
+    return None
+
 
