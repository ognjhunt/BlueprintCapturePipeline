+def _raise_for_unusable_stop(response: Any) -> None:
+    stop_reason = _get(response, "stop_reason")
+    if stop_reason == "refusal":
+        details = _get(response, "stop_details")
+        category = _get(details, "category")
+        explanation = _get(details, "explanation")
+        raise AnthropicRefusalError(
+            category=category if isinstance(category, str) else None,
+            explanation=explanation if isinstance(explanation, str) else None,
+            message_id=_get(response, "id"),
+            usage=_extract_usage(response),
+        )
+    if stop_reason == "max_tokens":
+        content = _get(response, "content") or []
+        if any(_get(block, "type") == "tool_use" for block in content):
+            raise AnthropicIncompleteToolCallError(
