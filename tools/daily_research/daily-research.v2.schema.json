{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blueprint.daily-research.v2.schema.json",
  "title": "Parent-reviewed Blueprint research v2",
  "description": "Shape only. Runtime additionally pins exact snapshot facts/source dates/freshness, run-date live checks, observed-time upper bounds, candidate role coverage and claim ceilings.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "blueprint.daily-research.v2"
    },
    "snapshot_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checked_date": {
      "type": "string",
      "format": "date"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "proposed_next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "maxItems": 3
    },
    "proposed_knowledge_deltas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/delta"
      },
      "maxItems": 10
    }
  },
  "required": [
    "schema_version",
    "snapshot_content_hash",
    "checked_date",
    "findings",
    "blockers",
    "proposed_next_actions",
    "candidates",
    "proposed_knowledge_deltas"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_date": {
          "type": "string",
          "format": "date"
        },
        "classification": {
          "enum": [
            "operator",
            "vendor",
            "independent"
          ]
        },
        "claim_kind": {
          "enum": [
            "fact",
            "vendor_claim",
            "hypothesis"
          ]
        },
        "role": {
          "enum": [
            "task",
            "capability",
            "geography"
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "live",
            "snapshot"
          ]
        },
        "evidence_level": {
          "enum": [
            "current_availability",
            "demonstrated_capability",
            "named_deployment",
            "unknown",
            "vendor_claim"
          ]
        },
        "source_checked_at": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "snapshot_loaded_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revalidated_at": {
          "anyOf": [
            {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_fact_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "claim",
        "url",
        "publisher",
        "source_date",
        "checked_date",
        "classification",
        "claim_kind",
        "role",
        "quote",
        "origin",
        "evidence_level",
        "source_checked_at",
        "snapshot_loaded_at",
        "revalidated_at",
        "snapshot_record_id",
        "snapshot_fact_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "live"
              }
            }
          },
          "then": {
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "snapshot_loaded_at": {
                "type": "null"
              },
              "snapshot_record_id": {
                "type": "null"
              },
              "snapshot_fact_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "role": {
                "const": "capability"
              },
              "snapshot_loaded_at": {
                "type": "string",
                "format": "date-time"
              },
              "snapshot_record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "snapshot_fact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "organization_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "site": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "potential_robot_match": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "proposed_next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "qualification_status": {
          "enum": [
            "unqualified",
            "needs_review"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 20,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 12,
          "minItems": 3
        }
      },
      "required": [
        "organization",
        "organization_url",
        "site",
        "location",
        "task",
        "potential_robot_match",
        "proposed_next_action",
        "qualification_status",
        "confidence",
        "unknowns",
        "evidence"
      ]
    },
    "deltaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "publication_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_checked_at": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "classification": {
          "enum": [
            "operator",
            "vendor",
            "independent"
          ]
        },
        "evidence_level": {
          "enum": [
            "current_availability",
            "demonstrated_capability",
            "named_deployment",
            "unknown",
            "vendor_claim"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "url",
        "publisher",
        "publication_date",
        "source_checked_at",
        "classification",
        "evidence_level",
        "quote"
      ]
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "fact_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "gap",
            "conflict",
            "stale",
            "unsupported",
            "discovery",
            "consequential"
          ]
        },
        "proposed_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 20,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deltaEvidence"
          },
          "maxItems": 4,
          "minItems": 1
        }
      },
      "required": [
        "record_id",
        "fact_id",
        "reason",
        "proposed_statement",
        "unknowns",
        "evidence"
      ]
    }
  }
}
