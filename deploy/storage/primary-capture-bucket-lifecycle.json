{
  "rule": [
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "NEARLINE"
      },
      "condition": {
        "age": 30,
        "matchesPrefix": ["scenes/", "targets/"]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "COLDLINE"
      },
      "condition": {
        "age": 90,
        "matchesPrefix": ["scenes/", "targets/"]
      }
    },
    {
      "action": {
        "type": "SetStorageClass",
        "storageClass": "ARCHIVE"
      },
      "condition": {
        "age": 365,
        "matchesPrefix": ["scenes/", "targets/"]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 14,
        "matchesPrefix": ["tmp/", "staging/", "debug/"]
      }
    },
    {
      "action": {
        "type": "Delete"
      },
      "condition": {
        "age": 365,
        "matchesPrefix": [
          "buyer_delivery/",
          "marketplace/",
          "hosted_sessions/",
          "robot_eval_jobs/"
        ]
      }
    }
  ]
}
