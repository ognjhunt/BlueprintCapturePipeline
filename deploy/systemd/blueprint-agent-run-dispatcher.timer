[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-agent-run-dispatcher.timer.json
Description=Poll WebApp for admitted agent runs

[Timer]
OnBootSec=2min
OnUnitActiveSec=30s
RandomizedDelaySec=5s
Persistent=true
Unit=blueprint-agent-run-dispatcher.service

[Install]
WantedBy=timers.target
