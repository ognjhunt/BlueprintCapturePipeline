[Unit]
Description=Advance authenticated persistent scene intents into bounded preparation
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/blueprint/task-evaluation-scene-progression.json

[Service]
ReadOnlyPaths=-/var/lib/blueprint/pipeline-control-plane/release-retention
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadOnlyPaths=/etc/blueprint
ReadWritePaths=/var/lib/blueprint/pipeline-control-plane /var/lib/blueprint/task-evaluation-inputs
ReadWritePaths=/var/lib/blueprint/task-evaluation-inputs/sam31-profile-registry
TasksMax=512
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=90min
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_TASK_EVALUATION_SAM31_PREPARATION_PROFILE_DIR=/var/lib/blueprint/task-evaluation-inputs/sam31-profile-registry
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-configuration-release.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-progression.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_ACCESS_KEY_ID_FILE=/etc/blueprint/provider-secrets/backblaze_b2_key_id
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_SECRET_ACCESS_KEY_FILE=/etc/blueprint/provider-secrets/backblaze_b2_application_key
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_ENDPOINT_URL_FILE=/etc/blueprint/provider-secrets/backblaze_b2_s3_endpoint_url
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_BUCKET_FILE=/etc/blueprint/provider-secrets/backblaze_b2_bucket
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_REGION_FILE=/etc/blueprint/provider-secrets/backblaze_b2_region
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_EXPECTED_BUCKET=blueprint-task-evaluation-artifacts-prod
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.task_evaluation_scene_progression --config /etc/blueprint/task-evaluation-scene-progression.json'
