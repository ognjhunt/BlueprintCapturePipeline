[Unit]
Description=Advance authenticated persistent scene intents into bounded preparation
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/blueprint/task-evaluation-scene-progression.json

[Service]
ReadOnlyPaths=-/var/lib/blueprint/pipeline-control-plane/release-retention
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadOnlyPaths=/etc/blueprint
ReadWritePaths=/var/lib/blueprint/pipeline-control-plane /var/lib/blueprint/task-evaluation-inputs
TasksMax=512
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=10min
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.task_evaluation_scene_progression --config /etc/blueprint/task-evaluation-scene-progression.json'
