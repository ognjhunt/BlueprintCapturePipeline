[Unit]
Description=Blueprint GPU spend guard and orphan reaper
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
TasksMax=512
LimitNOFILE=65536
MemoryMax=8G
CPUQuota=200%
Type=oneshot
Environment=BLUEPRINT_PIPELINE_REPO=/opt/blueprint/BlueprintCapturePipeline
Environment=BLUEPRINT_GPU_SPEND_GUARD_REPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/latest.json
Environment=BLUEPRINT_GPU_SPEND_GUARD_SNAPSHOT_PATH=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/latest.json
Environment=BLUEPRINT_GPU_SPEND_LEDGER=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/spend_ledger.json
Environment=BLUEPRINT_GPU_BILLING_EXPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/provider_billing_export.json
Environment=BLUEPRINT_PAID_SPEND_ADMISSION_LOCK_PATH=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/paid_spend_admission_lock.json
Environment=BLUEPRINT_GPU_SPEND_GUARD_PAGE_AUDIT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/page_event_audit.json
Environment=BLUEPRINT_GPU_PROVIDER_SECRETS_DIR=/etc/blueprint/provider-secrets
Environment=BLUEPRINT_GPU_SPEND_GUARD_MAX_BOOT_SECONDS=480
Environment=BLUEPRINT_GPU_SPEND_GUARD_MAX_BOOTED_ORPHAN_SECONDS=14400
Environment=BLUEPRINT_GPU_ORPHAN_BOOTED_MAX_AGE_SECONDS=14400
Environment=BLUEPRINT_GPU_FLEET_MAX_LIVE_INSTANCES=10
Environment=BLUEPRINT_GPU_FLEET_MAX_BURN_USD_PER_HOUR=10.0
Environment=BLUEPRINT_GPU_FLEET_MAX_DAILY_SPEND_USD=100.0
Environment=BLUEPRINT_GPU_FLEET_MAX_TOTAL_SPEND_USD=5000.0
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd "$${BLUEPRINT_PIPELINE_REPO}" && mkdir -p "$$(dirname "$${BLUEPRINT_GPU_SPEND_GUARD_REPORT}")" "$$(dirname "$${BLUEPRINT_GPU_SPEND_LEDGER}")" "$$(dirname "$${BLUEPRINT_PAID_SPEND_ADMISSION_LOCK_PATH}")" && ARGS=(scripts/gpu_spend_guard.py --reap --max-boot-seconds "$${BLUEPRINT_GPU_SPEND_GUARD_MAX_BOOT_SECONDS}" --orphan-booted-max-age-seconds "$${BLUEPRINT_GPU_ORPHAN_BOOTED_MAX_AGE_SECONDS:-$${BLUEPRINT_GPU_SPEND_GUARD_MAX_BOOTED_ORPHAN_SECONDS}}" --max-live-instances "$${BLUEPRINT_GPU_FLEET_MAX_LIVE_INSTANCES}" --max-burn-usd-per-hour "$${BLUEPRINT_GPU_FLEET_MAX_BURN_USD_PER_HOUR}" --spend-ledger "$${BLUEPRINT_GPU_SPEND_LEDGER}" --max-daily-spend-usd "$${BLUEPRINT_GPU_FLEET_MAX_DAILY_SPEND_USD}" --max-total-spend-usd "$${BLUEPRINT_GPU_FLEET_MAX_TOTAL_SPEND_USD}" --billing-export "$${BLUEPRINT_GPU_BILLING_EXPORT}" --require-billing-reconciliation --admission-lock-report "$${BLUEPRINT_PAID_SPEND_ADMISSION_LOCK_PATH}" --json-report "$${BLUEPRINT_GPU_SPEND_GUARD_REPORT}") && if [ -n "$${BLUEPRINT_PAID_SPEND_OVERRIDE_PATH:-}" ]; then ARGS+=(--admission-override "$${BLUEPRINT_PAID_SPEND_OVERRIDE_PATH}"); fi && if [ -x .venv/bin/python ]; then exec .venv/bin/python "$${ARGS[@]}"; fi; exec env PYTHONPATH=src python3 "$${ARGS[@]}"'
ExecStartPost=/bin/bash -lc 'cd "$${BLUEPRINT_PIPELINE_REPO}" && exec /bin/bash deploy/systemd/blueprint-gpu-spend-guard-postchecks.sh'
ExecStopPost=/bin/bash -lc 'cd "$${BLUEPRINT_PIPELINE_REPO}" && ARGS=(-m blueprint_pipeline.live_pipeline_manifest_alert --manifest-path "$${BLUEPRINT_PAID_SPEND_ADMISSION_LOCK_PATH}" --output-path "$${BLUEPRINT_GPU_SPEND_GUARD_PAGE_AUDIT}") && if [ -x .venv/bin/python ]; then exec .venv/bin/python "$${ARGS[@]}"; fi; exec env PYTHONPATH=src python3 "$${ARGS[@]}"'
Nice=10
