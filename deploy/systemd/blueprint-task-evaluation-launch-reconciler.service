[Unit]
Description=Reconcile Blueprint Task Evaluation launch liveness and provider-zero
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target blueprint-gpu-spend-guard.service
After=network-online.target blueprint-gpu-spend-guard.service

[Service]
ReadOnlyPaths=-/var/lib/blueprint/pipeline-control-plane/release-retention
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/task-evaluation-launch-profiles /etc/blueprint/provider-secrets
TasksMax=512
LimitNOFILE=4096
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=2min
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR=/etc/blueprint/task-evaluation-launch-profiles
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs
Environment=BLUEPRINT_GPU_SPEND_GUARD_REPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/latest.json
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_RECONCILIATION_REPORT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-reconciliation/latest.json
# Keep terminal offering publication and progress projection reachable after a
# clean production rebuild; EnvironmentFile remains the operator override.
Environment=PIPELINE_TASK_EVALUATION_LAUNCH_WEBAPP_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launches
Environment=PIPELINE_TASK_EVALUATION_LAUNCH_PROGRESS_WEBAPP_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launch-progress
Environment=PIPELINE_SYNC_TOKEN_FILE=/etc/blueprint/provider-secrets/pipeline_sync_token
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && ARGS=(-m blueprint_pipeline.task_evaluation_launch_reconciler --queue-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT}" --profile-dir "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR}" --state-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT}" --guard-report "$${BLUEPRINT_GPU_SPEND_GUARD_REPORT}" --report-out "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_RECONCILIATION_REPORT}") && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" "$${ARGS[@]}"'
