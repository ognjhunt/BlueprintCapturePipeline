[Unit]
Description=Keep the website scene stage moving and deliver its held notices
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-scene-stage-maintenance.timer.json

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
AccuracySec=10s
Unit=blueprint-scene-stage-maintenance.service

[Install]
WantedBy=timers.target
