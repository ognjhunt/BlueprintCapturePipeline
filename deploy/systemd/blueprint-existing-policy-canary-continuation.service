[Unit]
Description=Continue one explicitly handed-off existing Blueprint policy canary
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/provider-secrets
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=/etc/blueprint/existing-policy-canary-continuation.env
Environment=VAST_API_KEY_FILE=/etc/blueprint/provider-secrets/vast_api_key
Environment=BLUEPRINT_GPU_PROVIDER_SECRETS_DIR=/etc/blueprint/provider-secrets
TimeoutStartSec=75min
MemoryMax=8G
TasksMax=128
LimitNOFILE=65536
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.operator_policy_canary_continuation run --intent "$${BLUEPRINT_EXISTING_POLICY_CANARY_INTENT}"'
