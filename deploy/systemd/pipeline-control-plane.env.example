# Blueprint live pipeline control-plane env file.
# Copy to /etc/blueprint/pipeline-control-plane.env on the droplet.
# Do not commit a filled copy of this file.

BLUEPRINT_PIPELINE_REPO=/opt/blueprint/BlueprintCapturePipeline
BLUEPRINT_LAUNCH_PROOF_MODE=production
PRIVACY_PIPELINE_ENABLED=true
PRIVACY_FAIL_CLOSED=true
PIPELINE_SYNC_REQUIRED=true
RETRIEVAL_REQUIRE_PRIVACY_SAFE_VIDEO=true
BLUEPRINT_CONTROL_PLANE_OUTPUT_PATH=/var/lib/blueprint/pipeline-control-plane/live_pipeline_control_plane_manifest.json
# Required in production: blocked control-plane manifests must notify an
# operator. If the webhook is absent and a pass is blocked, the post-check makes
# the systemd unit fail instead of silently exiting 0.
BLUEPRINT_OPERATOR_ALERT_REQUIRE_WEBHOOK=true
# BLUEPRINT_OPERATOR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Non-secret control-plane paths created by scripts/install_live_pipeline_control_plane.sh.
BLUEPRINT_ROBOT_EVAL_JOB_REQUEST_INBOX=/var/lib/blueprint/pipeline-control-plane/robot-eval-job-requests
BLUEPRINT_LIVE_PIPELINE_STAGED_INPUTS_PATH=/var/lib/blueprint/pipeline-control-plane/live_pipeline_staged_inputs.json

# GPU spend guard timer. The systemd timer runs scripts/gpu_spend_guard.py
# with --reap and persists a gpu_spend_guard.v1 snapshot. External launch
# gates should use this path as --spend-guard-pre-snapshot and
# --spend-guard-post-snapshot around paid/provider canaries.
BLUEPRINT_GPU_SPEND_GUARD_REPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/latest.json
BLUEPRINT_GPU_SPEND_LEDGER=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/spend_ledger.json
BLUEPRINT_GPU_BILLING_EXPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/provider_billing_export.json
BLUEPRINT_PROVIDER_BILLING_AUDIT_ROOT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/billing-audit
BLUEPRINT_PROVIDER_BILLING_COHORT_START_AT=2026-01-01T00:00:00Z
BLUEPRINT_PAID_SPEND_ADMISSION_LOCK_PATH=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/paid_spend_admission_lock.json
BLUEPRINT_REQUIRE_PAID_SPEND_ADMISSION_LOCK=true
BLUEPRINT_GPU_SPEND_GUARD_PAGE_AUDIT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/page_event_audit.json
# Read-only directory containing provider and runtime credential files.
# ProtectHome remains enabled for the services. The launch dispatcher binds
# its canonical allocator files explicitly so it never falls back to a user
# home: vast_api_key, ngc_api_key, docker_username, docker_pat, and
# huggingface_token.
BLUEPRINT_GPU_PROVIDER_SECRETS_DIR=/etc/blueprint/provider-secrets
VAST_API_KEY_FILE=/etc/blueprint/provider-secrets/vast_api_key
# Cross-process provider locks are runtime state. Keep them on the writable
# control-plane volume because the credential directory is mounted read-only.
VAST_LAUNCH_LOCK_FILE=/var/lib/blueprint/pipeline-control-plane/provider-locks/vast_paid_launch.lock
NGC_API_KEY_FILE=/etc/blueprint/provider-secrets/ngc_api_key
DOCKER_USERNAME_FILE=/etc/blueprint/provider-secrets/docker_username
DOCKER_PAT_FILE=/etc/blueprint/provider-secrets/docker_pat
HF_TOKEN_FILE=/etc/blueprint/provider-secrets/huggingface_token
# S3-compatible immutable bundle/output staging used by every Vast launch.
BLUEPRINT_WAM_OBJECT_STORE_ACCESS_KEY_ID_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_access_key_id
BLUEPRINT_WAM_OBJECT_STORE_SECRET_ACCESS_KEY_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_secret_access_key
BLUEPRINT_WAM_OBJECT_STORE_ENDPOINT_URL_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_endpoint_url
BLUEPRINT_WAM_OBJECT_STORE_BUCKET_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_bucket
BLUEPRINT_WAM_OBJECT_STORE_REGION_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_region
BLUEPRINT_GPU_SPEND_GUARD_MAX_BOOT_SECONDS=480
BLUEPRINT_GPU_SPEND_GUARD_MAX_BOOTED_ORPHAN_SECONDS=14400
BLUEPRINT_GPU_FLEET_MAX_LIVE_INSTANCES=10
BLUEPRINT_GPU_FLEET_MAX_BURN_USD_PER_HOUR=10.0
BLUEPRINT_GPU_FLEET_MAX_DAILY_SPEND_USD=100.0
BLUEPRINT_GPU_FLEET_MAX_TOTAL_SPEND_USD=5000.0
# Normally unset. If used, this must name a non-symlink, non-group/world-
# writable blueprint.paid_spend_override.v1 artifact with a <=4 hour expiry and
# distinct requester/approver identities.
# BLUEPRINT_PAID_SPEND_OVERRIDE_PATH=/etc/blueprint/paid-spend-override.json

# Optional HTTP intake service for WebApp job requests.
# Keep bound to localhost unless a reverse proxy/TLS layer owns public exposure.
# BLUEPRINT_LIVE_PIPELINE_INTAKE_TOKEN=
# Optional temporary compatibility flag. Default service behavior requires
# X-Blueprint-Pipeline-Timestamp/Nonce/Signature HMAC headers.
# BLUEPRINT_LIVE_PIPELINE_INTAKE_ALLOW_LEGACY_BEARER=false
# BLUEPRINT_LIVE_PIPELINE_INTAKE_MAX_CLOCK_SKEW_SECONDS=300
# BLUEPRINT_LIVE_PIPELINE_INTAKE_HOST=127.0.0.1
# PORT=8765
BLUEPRINT_LIVE_PIPELINE_INTAKE_WORK_DIR=/var/lib/blueprint/pipeline-control-plane/incoming_webapp_job_requests
# BLUEPRINT_ALLOW_LIVE_PIPELINE_INTAKE_TRIGGER=true
# BLUEPRINT_LIVE_PIPELINE_INTAKE_TRIGGER_COMMAND=/bin/systemctl start blueprint-pipeline-control-plane.service

# Required before the runner can do more than write a blocked/noop manifest:
# either set one capture root for single-capture audit mode, or configure the
# request inbox so each WebApp/PubSub request carries its own site_package.capture_root.
# BLUEPRINT_PIPELINE_CAPTURE_ROOT=/path/to/storage/bucket/scenes/<scene>/captures/<capture>

# Sim-only beta profile. Keep commented unless this control plane should route
# accepted uploads/job requests into autonomous MuJoCo task-eval runs.
# BLUEPRINT_SIM_ONLY_BETA_DEFAULT_TASK_EVAL=true
# BLUEPRINT_SIM_ONLY_BETA_AUTONOMY=true
# BLUEPRINT_ALLOW_SIMULATOR_EXECUTION=true
# BLUEPRINT_MUJOCO_G1_MODEL_ROOT=/path/to/mujoco_menagerie/unitree_g1
# Optional alternative to a local asset root:
# BLUEPRINT_MUJOCO_ALLOW_FETCH_G1_ASSETS=true
# Optional tuning:
# BLUEPRINT_MUJOCO_BETA_STEPS=32
# Sim-only beta needs per-episode visual review media, not sampled proof frames.
# Keep this at or above the selected scenario-eval run count.
# BLUEPRINT_MUJOCO_BETA_MAX_RENDERED_EPISODES=11
# BLUEPRINT_MUJOCO_BETA_MAX_RENDERED_STEPS=24
# BLUEPRINT_MUJOCO_BETA_SKIP_RENDER_FRAMES=false
# Explicit override if the packaged MuJoCo command is not enough:
# ROBOT_EVAL_JOB_DEFAULT_SIMULATOR_COMMAND=/path/to/custom-simulator-command

# OpenAI live operators. The repo API/SDK path uses OPENAI_API_KEY.
# OPENAI_API_KEY=
# BLUEPRINT_ALLOW_LIVE_AGENTS_SDK_OPERATORS=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_LIVE_AGENTS_SDK=true

# Codex CLI host OAuth is allowed only when the installed codex CLI is already
# authenticated by the host/user profile. No OAuth token is exported.
# BLUEPRINT_ALLOW_LIVE_CODEX_SDK_OPERATORS=true
# BLUEPRINT_ALLOW_CODEX_CLI_HOST_OAUTH=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_LIVE_CODEX_SDK=true

# Optional DigitalOcean read-only audit metadata. This is control-plane metadata
# only and is not simulator/GPU proof. Leave the read gate unset unless you want
# live droplet inventory verification; an unrequested read is advisory, not a
# setup blocker.
# DIGITALOCEAN_ACCESS_TOKEN=
# BLUEPRINT_CONTROL_PLANE_ALLOW_DIGITALOCEAN_READ=true
# BLUEPRINT_DIGITALOCEAN_DROPLET_NAME=paperclip-prod-01
# BLUEPRINT_DIGITALOCEAN_DROPLET_IP=206.81.11.69

# Explicit live action gates. Leave unset until the command hooks are real.
# BLUEPRINT_ALLOW_SIMULATOR_EXECUTION=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_SIMULATOR_EXECUTION=true
# BLUEPRINT_CONTROL_PLANE_SIMULATOR=isaac_lab_arena
# BLUEPRINT_ISAAC_LAB_ARENA_COMMAND=/path/to/isaac-lab-arena-wrapper --emit-results /path/to/results
# BLUEPRINT_SIMULATOR_COMMAND=/path/to/isaac-lab-arena-wrapper --help
# Existing owner-system Arena results can be ingested without opening the
# simulator-execution gate. They are package inputs, not simulator proof.
# BLUEPRINT_ARENA_RESULTS_DIR=/path/to/owner-system/isaac-lab-arena-results

# BLUEPRINT_ALLOW_ROLLOUT_VISION_LABELING=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_ROLLOUT_VISION_LABELING=true
# BLUEPRINT_ROLLOUT_VISION_LABELING_COMMAND=blueprint-label-rollout-vision-openai --output-dir .
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# BLUEPRINT_ALLOW_PACKAGE_DELIVERY_UPLOAD=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_DELIVERY_UPLOAD=true
# BLUEPRINT_LOCAL_DELIVERY_ROOT=/var/lib/blueprint/pipeline-control-plane/deliveries
# BLUEPRINT_PACKAGE_DELIVERY_UPLOAD_COMMAND=blueprint-deliver-arena-package-local --output-dir .

# Capture-bridge Pub/Sub handoff listener. The timer drains the pull
# subscription repeatedly so raw-upload-complete handoffs do not require a human
# to run blueprint-pubsub-handoff-listener per batch.
# Provision a dedicated pipeline-handoff-listener identity with subscriber on
# this exact subscription and objectViewer on the exact capture bucket. Store
# its JSON key outside the repository as root:blueprint mode 0640 and rotate it
# through the GCP key lifecycle; never reuse pipeline-runner credentials.
GOOGLE_APPLICATION_CREDENTIALS=/etc/blueprint/credentials/pipeline-handoff-listener.json
GOOGLE_CLOUD_PROJECT=blueprint-8c1ca
BLUEPRINT_PUBSUB_HANDOFF_SUBSCRIPTION=blueprint-pipeline-handoff-listener
BLUEPRINT_PUBSUB_HANDOFF_STORAGE_ROOT=/var/lib/blueprint/pubsub-handoffs
BLUEPRINT_PUBSUB_HANDOFF_PROVIDER=openai
BLUEPRINT_PUBSUB_HANDOFF_MAX_MESSAGES=10
# Production listener posture: Pub/Sub drains stage per-capture requests into the
# control-plane inbox; the control plane owns simulator/provider execution.
BLUEPRINT_PUBSUB_HANDOFF_STAGE_CONTROL_PLANE=true
BLUEPRINT_PUBSUB_HANDOFF_SKIP_RUN_E2E=true

# Production website Task Evaluation launch bridge. The WebApp can enqueue only
# immutable Pipeline-owned profiles. These two independent gates must both be
# explicitly enabled before the intake service starts the canonical dispatcher.
# The mutable build checkout may move with protected main. Stage the exact
# source commit first with scripts/stage_task_evaluation_control_plane_release.py
# and switch this link only after its matching immutable profile is published.
# The shared interpreter provides dependencies; PYTHONPATH in the units makes
# the release checkout, rather than the mutable checkout, the imported code.
BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_RELEASE_ROOT=/opt/blueprint/task-evaluation-control-plane-releases
BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_RELEASE_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-control-plane-releases
BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches
BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR=/etc/blueprint/task-evaluation-launch-profiles
BLUEPRINT_TASK_EVALUATION_LAUNCH_PUBLIC_CATALOG_PATH=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-profile-catalog.json
BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs
BLUEPRINT_TASK_EVALUATION_LAUNCH_TRIGGER_SYSTEMD_UNIT=blueprint-task-evaluation-launch-dispatcher.service
BLUEPRINT_TASK_EVALUATION_LAUNCH_TRIGGER_MODE=systemd_path
BLUEPRINT_TASK_EVALUATION_LAUNCH_RECONCILIATION_REPORT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-reconciliation/latest.json
# A terminal-blocked website launch may request deletion of one exact stopped
# Vast record. This queue has no launch profile and can never resume evaluation.
BLUEPRINT_TASK_EVALUATION_TERMINAL_RESOURCE_RELEASE_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-terminal-resource-releases
BLUEPRINT_TASK_EVALUATION_TERMINAL_RESOURCE_RELEASE_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-terminal-resource-releases-state
BLUEPRINT_TASK_EVALUATION_TERMINAL_RESOURCE_RELEASE_TRIGGER_SYSTEMD_UNIT=blueprint-task-evaluation-terminal-resource-release.service
# BLUEPRINT_ALLOW_TASK_EVALUATION_TERMINAL_RESOURCE_RELEASE_TRIGGER=true
# Non-secret identity of the canonical host secret profile. The dispatcher
# compares this to the immutable profile before any live allocator call; actual
# provider credentials remain in the canonical provider secret integration.
# BLUEPRINT_TASK_EVALUATION_SECRET_PROFILE_ID=canonical-vast-adp
# BLUEPRINT_ALLOW_TASK_EVALUATION_LAUNCH_TRIGGER=true
# The production unit enables the execute-capable dispatcher by default, but
# that is not spend authority: a queued launch must still match either an exact
# launch ID or a digest-bound, expiring standing authorization. Set the
# force-dry-run interlock for a host-wide temporary spend stop. The optional
# exact ID narrows the worker to one pending request and must be cleared after
# its binding is retained.
# BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE_ID=adp009d-example-paid-web-001
# PIPELINE_TASK_EVALUATION_LAUNCH_WEBAPP_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launches
# PIPELINE_TASK_EVALUATION_LAUNCH_SUPERVISION_WEBAPP_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launch-supervision

# Optional, read-only OpenAI Agents SDK supervisor. It has no tools and cannot
# launch, retry, approve spend/rights, or close teardown. Enabling it also
# requires the existing BLUEPRINT_ALLOW_LIVE_AGENTS_SDK gate and a finite budget.
# BLUEPRINT_TASK_EVALUATION_AGENT_SUPERVISOR_ENABLED=true
# BLUEPRINT_ALLOW_LIVE_AGENTS_SDK=true
# BLUEPRINT_TASK_EVALUATION_AGENT_SUPERVISOR_MODEL=gpt-5.6-terra
# BLUEPRINT_TASK_EVALUATION_AGENT_SUPERVISOR_BUDGET_USD=0.10
