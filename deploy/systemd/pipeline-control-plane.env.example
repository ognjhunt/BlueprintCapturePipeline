# Blueprint live pipeline control-plane env file.
# Copy to /etc/blueprint/pipeline-control-plane.env on the droplet.
# Do not commit a filled copy of this file.

BLUEPRINT_PIPELINE_REPO=/Users/nijelhunt_1/workspace/BlueprintCapturePipeline
BLUEPRINT_CONTROL_PLANE_OUTPUT_PATH=/var/lib/blueprint/pipeline-control-plane/live_pipeline_control_plane_manifest.json

# Required before the runner can do more than write a blocked/noop manifest.
# BLUEPRINT_PIPELINE_CAPTURE_ROOT=/path/to/storage/bucket/scenes/<scene>/captures/<capture>
# BLUEPRINT_ROBOT_EVAL_JOB_REQUEST_INBOX=/path/to/webapp/robot-eval-job-requests

# OpenAI live operators. The repo API/SDK path uses OPENAI_API_KEY.
# OPENAI_API_KEY=
# BLUEPRINT_ALLOW_LIVE_AGENTS_SDK_OPERATORS=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_LIVE_AGENTS_SDK=true

# Codex CLI host OAuth is allowed only when the installed codex CLI is already
# authenticated by the host/user profile. No OAuth token is exported.
# BLUEPRINT_ALLOW_LIVE_CODEX_SDK_OPERATORS=true
# BLUEPRINT_ALLOW_CODEX_CLI_HOST_OAUTH=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_LIVE_CODEX_SDK=true

# Optional DigitalOcean read-only audit metadata. This is control-plane metadata
# only and is not simulator/GPU proof.
# DIGITALOCEAN_ACCESS_TOKEN=
# BLUEPRINT_CONTROL_PLANE_ALLOW_DIGITALOCEAN_READ=true
# BLUEPRINT_DIGITALOCEAN_DROPLET_NAME=paperclip-prod-01
# BLUEPRINT_DIGITALOCEAN_DROPLET_IP=206.81.11.69

# Explicit live action gates. Leave unset until the command hooks are real.
# BLUEPRINT_ALLOW_SIMULATOR_EXECUTION=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_SIMULATOR_EXECUTION=true
# BLUEPRINT_CONTROL_PLANE_SIMULATOR=isaac_lab_arena
# BLUEPRINT_ISAAC_LAB_ARENA_COMMAND=/path/to/isaac-lab-arena-wrapper --emit-results /path/to/results
# BLUEPRINT_SIMULATOR_COMMAND=/path/to/isaac-lab-arena-wrapper --help

# BLUEPRINT_ALLOW_ROLLOUT_VISION_LABELING=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_ROLLOUT_VISION_LABELING=true
# BLUEPRINT_ROLLOUT_VISION_LABELING_COMMAND=/path/to/vision-labeling-wrapper
# GEMINI_API_KEY=

# BLUEPRINT_ALLOW_PACKAGE_DELIVERY_UPLOAD=true
# BLUEPRINT_CONTROL_PLANE_ALLOW_DELIVERY_UPLOAD=true
# BLUEPRINT_PACKAGE_DELIVERY_UPLOAD_COMMAND=/path/to/delivery-wrapper
