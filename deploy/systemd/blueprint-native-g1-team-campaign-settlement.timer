[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-native-g1-team-campaign-settlement.timer.json
Description=Reconcile completed G1 team campaign billing and private review

[Timer]
OnBootSec=5min
OnUnitInactiveSec=5min
Unit=blueprint-native-g1-team-campaign-settlement.service
Persistent=true

[Install]
WantedBy=timers.target
