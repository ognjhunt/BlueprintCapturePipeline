[Unit]
Description=Plan the pruning of old scene-retirement runtime snapshots: measure and list, remove nothing
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline/blob/main/src/blueprint_pipeline/scene_retirement_runtime_prune.py
# Started by hand only (operator door: unit start), never by a timer or path unit, until the owner
# decides otherwise. Run the plan unit, read its plan.json, then this pair's apply unit.

[Service]
Type=oneshot
# Root reads the root-owned runtime trees, CURRENT.json and every process's descriptors and maps
# (CAP_SYS_PTRACE) for the in-use check, and writes only its report.
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_SYS_PTRACE
InaccessiblePaths=-/etc/blueprint/provider-secrets
ReadWritePaths=/var/lib/blueprint/pipeline-control-plane/storage-gc
TasksMax=32
# Host memory (8.3 GB, no swap): MemoryMax binds below the host, so a runaway
# is killed in this unit, not host-wide. Batch job, run by hand: +200.
MemoryMax=1G
OOMScoreAdjust=200
CPUQuota=100%
TimeoutStartSec=2h
Environment=PYTHONPATH=/opt/blueprint/task-evaluation-control-plane/src
ExecStart=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python -m blueprint_pipeline.scene_retirement_runtime_prune plan
