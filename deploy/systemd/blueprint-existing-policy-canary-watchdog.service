[Unit]
Description=Independent original-deadline watchdog for one existing Blueprint canary
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/provider-secrets
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=/etc/blueprint/existing-policy-canary-continuation.env
Environment=VAST_API_KEY_FILE=/etc/blueprint/provider-secrets/vast_api_key
Environment=BLUEPRINT_GPU_PROVIDER_SECRETS_DIR=/etc/blueprint/provider-secrets
Restart=on-failure
RestartSec=5s
MemoryMax=1G
TasksMax=64
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.operator_policy_canary_continuation watchdog --intent "$${BLUEPRINT_EXISTING_POLICY_CANARY_INTENT}"'

[Install]
WantedBy=multi-user.target
