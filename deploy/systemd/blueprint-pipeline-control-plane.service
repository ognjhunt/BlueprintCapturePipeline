[Unit]
Description=Blueprint live pipeline control-plane one-shot
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
TasksMax=512
LimitNOFILE=65536
# Host memory (8.3 GB, no swap): MemoryMax binds below the host, so a runaway
# is killed in this unit, not host-wide. Batch job, retried: +200, so it goes
# before the always-on services, paid work and the money-safety units.
# Measured: up to 569M on the host.
MemoryHigh=2G
MemoryMax=3G
OOMScoreAdjust=200
CPUQuota=200%
Type=oneshot
# The credential EnvironmentFile below names an archived checkout in
# BLUEPRINT_PIPELINE_REPO and, as an EnvironmentFile, overrides Environment=
# (PR #519). Locate the release through a key that file never sets and hand the
# resolved release to the guard, the pass and the postchecks (as PR #2011 did).
Environment=BLUEPRINT_LIVE_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_PIPELINE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_LAUNCH_PROOF_MODE=production
Environment=PRIVACY_PIPELINE_ENABLED=true
Environment=PRIVACY_FAIL_CLOSED=true
Environment=PIPELINE_SYNC_REQUIRED=true
Environment=RETRIEVAL_REQUIRE_PRIVACY_SAFE_VIDEO=true
Environment=BLUEPRINT_OPERATOR_ALERT_REQUIRE_WEBHOOK=true
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStartPre=/bin/bash -lc 'cd -P "$${BLUEPRINT_LIVE_CONTROL_PLANE_REPO}" && export BLUEPRINT_PIPELINE_REPO="$${PWD}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_PIPELINE_PYTHON}" && exec env PYTHONPATH=src "$${BLUEPRINT_PIPELINE_PYTHON}" -m blueprint_pipeline.production_runtime_env_guard'
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_LIVE_CONTROL_PLANE_REPO}" && export BLUEPRINT_PIPELINE_REPO="$${PWD}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_PIPELINE_PYTHON}" && exec env PYTHONPATH=src "$${BLUEPRINT_PIPELINE_PYTHON}" -m blueprint_pipeline.live_pipeline_control_plane'
ExecStartPost=/bin/bash -lc 'cd -P "$${BLUEPRINT_LIVE_CONTROL_PLANE_REPO}" && export BLUEPRINT_PIPELINE_REPO="$${PWD}" && exec /bin/bash deploy/systemd/blueprint-control-plane-postchecks.sh'
Nice=5
