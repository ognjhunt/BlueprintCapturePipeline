[Unit]
Description=Blueprint Firestore backup — scheduled managed export of the authoritative control-plane (R053)
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
TasksMax=512
LimitNOFILE=65536
MemoryMax=8G
CPUQuota=200%
# SCAFFOLD: this unit runs the committed emitter with --execute, which shells out to
# `gcloud firestore export`. It therefore requires gcloud installed on the host and an
# authenticated backup service account with roles/datastore.importExportAdmin plus write
# access to the backup bucket. Until that credential exists this unit fails closed (the
# export is not silently skipped). See Blueprint-WebApp/docs/runbooks/DATA_BACKUP_AND_DR_RUNBOOK.md.
Type=oneshot
Environment=BLUEPRINT_PIPELINE_REPO=/opt/blueprint/BlueprintCapturePipeline
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd "$${BLUEPRINT_PIPELINE_REPO}" && if [ -x .venv/bin/python ]; then exec .venv/bin/python scripts/emit_firestore_backup_command.py --execute; fi; exec env PYTHONPATH=src python3 scripts/emit_firestore_backup_command.py --execute'
Nice=10

[Install]
WantedBy=multi-user.target
