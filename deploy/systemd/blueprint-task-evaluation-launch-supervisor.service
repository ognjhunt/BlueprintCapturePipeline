[Unit]
Description=Optionally supervise Blueprint Task Evaluation launches with OpenAI Agents SDK
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target blueprint-task-evaluation-launch-reconciler.service

[Service]
ReadOnlyPaths=-/var/lib/blueprint/pipeline-control-plane/release-retention
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-supervision
# Imported replay consumers read these production roots; all replay writes stay
# under task-evaluation-launch-supervision. Do not grant launch/spend writes.
ReadOnlyPaths=-/var/lib/blueprint/pipeline-control-plane/sam31-preparation-executions -/var/lib/blueprint/pipeline-control-plane/standing-authorizations -/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-preparations -/var/lib/blueprint/task-evaluation-inputs/sam31-preparations -/var/lib/blueprint/pipeline-control-plane/capture-reconstruction-derived -/var/lib/blueprint/pipeline-control-plane/capture-reconstruction-queue -/var/lib/blueprint/pipeline-control-plane/capture-reconstruction-runs -/var/lib/blueprint/pubsub-handoffs -/var/lib/blueprint/spend-authority -/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-activations -/var/lib/blueprint/pipeline-control-plane/task-evaluation-terminal-resource-releases -/var/lib/blueprint/pipeline-control-plane/task-evaluation-terminal-resource-releases-state
ReadOnlyPaths=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches /var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs /var/lib/blueprint/pipeline-control-plane/gpu_spend_guard -/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-profile-catalog.json /etc/blueprint/task-evaluation-launch-profiles /etc/blueprint/provider-secrets
ReadOnlyPaths=/var/lib/blueprint/task-evaluation-inputs/sam31-profile-registry
TasksMax=512
LimitNOFILE=4096
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=2min
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR=/etc/blueprint/task-evaluation-launch-profiles
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PUBLIC_CATALOG_PATH=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-profile-catalog.json
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs
Environment=BLUEPRINT_GPU_SPEND_GUARD_REPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/latest.json
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_SUPERVISION_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-supervision
# Keep supervision receipts projected to the production Website after a clean
# rebuild; EnvironmentFile remains the operator override.
Environment=PIPELINE_TASK_EVALUATION_LAUNCH_SUPERVISION_WEBAPP_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launch-supervision
Environment=PIPELINE_SYNC_TOKEN_FILE=/etc/blueprint/provider-secrets/pipeline_sync_token
Environment=BLUEPRINT_TASK_EVALUATION_SAM31_PREPARATION_PROFILE_DIR=/var/lib/blueprint/task-evaluation-inputs/sam31-profile-registry
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && ARGS=(-m blueprint_pipeline.task_evaluation_launch_supervisor --profile-dir "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR}" --public-catalog "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_PUBLIC_CATALOG_PATH}" --queue-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT}" --state-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT}" --guard-report "$${BLUEPRINT_GPU_SPEND_GUARD_REPORT}" --output-dir "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_SUPERVISION_ROOT}/recommendations" --latest-out "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_SUPERVISION_ROOT}/latest.json") && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" "$${ARGS[@]}"'
