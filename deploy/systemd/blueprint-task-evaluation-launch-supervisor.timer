[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-task-evaluation-launch-supervisor.timer.json
Description=Optionally inspect Blueprint Task Evaluation launch state

[Timer]
OnBootSec=5min
OnUnitInactiveSec=5min
RandomizedDelaySec=30s
Persistent=true
Unit=blueprint-task-evaluation-launch-supervisor.service

[Install]
WantedBy=timers.target
