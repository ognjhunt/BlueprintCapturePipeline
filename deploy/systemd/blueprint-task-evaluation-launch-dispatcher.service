[Unit]
Description=Dispatch one Blueprint Task Evaluation launch through the canonical allocator
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target blueprint-gpu-spend-guard.service
After=network-online.target blueprint-gpu-spend-guard.service

[Service]
Type=oneshot
User=blueprint
Group=blueprint
# The dispatcher may hand a retained paid allocation to its independently
# armed hard-TTL watchdog.  setsid/nohup do not escape a systemd cgroup: with
# the default KillMode=control-group systemd killed that watchdog child as soon
# as this oneshot caller exited, despite a retained_until_hard_ttl handoff.
# Preserve child watchdogs while stopping only the dispatcher main process;
# normal terminal close still asks the exact child to exit and verifies it.
KillMode=process
Environment=BLUEPRINT_VAST_WATCHDOG_CALLER_EXIT_SURVIVAL=systemd_dispatcher_kill_mode_process
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/task-evaluation-launch-profiles /etc/blueprint/provider-secrets -/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-profile-catalog.json
TasksMax=512
LimitNOFILE=65536
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=5h
# The mutable build checkout may advance with protected main. The dispatcher
# runs only through this atomically promoted, detached release link so its
# allocator identity cannot drift after a profile has been published.
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR=/etc/blueprint/task-evaluation-launch-profiles
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PUBLIC_CATALOG_PATH=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-profile-catalog.json
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PREPARATION_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-preparations
Environment=BLUEPRINT_TASK_EVALUATION_SCENE_CONSTRUCTION_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-scene-constructions
# Serial remains the safe default. Operators may explicitly raise this to 2 or
# 3; the dispatcher rejects every other value before claiming a request, and
# each worker still crosses the canonical allocator's independent spend,
# authority, provider-lock, and paid-slot gates.
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_MAX_CONCURRENCY=1
# A paid execution window names one immutable launch ID, or is admitted by a
# standing per-profile authorization -- which is digest-bound, expiring, and
# bounded in launch count and spend. Requiring the ID unconditionally made
# that authorization unreachable: the queue worker refused before the
# dispatcher could consult it, so every paid run still needed a hand-edited
# env var and a unit restart. A bare --execute is still not a blanket
# authority; the dispatcher refuses a launch carrying neither.
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE=true
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE_ID=
# The hardened service cannot read a user home. Bind every allocator/runtime
# credential to the canonical read-only secret directory. The allocator still
# fails closed when a required file is absent; these paths grant no authority.
Environment=VAST_API_KEY_FILE=/etc/blueprint/provider-secrets/vast_api_key
Environment=BLUEPRINT_VAST_CREDIT_GUARD_ENABLED=true
Environment=BLUEPRINT_VAST_SSH_IDENTITY_FILE=/etc/blueprint/provider-secrets/vast_ssh_id_ed25519
Environment=VAST_LAUNCH_LOCK_FILE=/var/lib/blueprint/pipeline-control-plane/provider-locks/vast_paid_launch.lock
Environment=NGC_API_KEY_FILE=/etc/blueprint/provider-secrets/ngc_api_key
Environment=DOCKER_USERNAME_FILE=/etc/blueprint/provider-secrets/docker_username
Environment=DOCKER_PAT_FILE=/etc/blueprint/provider-secrets/docker_pat
Environment=HF_TOKEN_FILE=/etc/blueprint/provider-secrets/huggingface_token
# The Content Agents config preflight proves live model access before that
# lane may allocate. This unit runs with ProtectHome=true and home
# /nonexistent, so a secret resolved from a developer home cannot be read
# here; name it the way every other credential on this unit is named.
Environment=OPENAI_API_KEY_FILE=/etc/blueprint/provider-secrets/openai_api_key
# Scene configuration reserves and settles OpenAI cost against an operator-
# attested, project/key-scoped official Costs API window.  Keep the billing
# credential and human attestation in the same canonical read-only secret
# directory; project and key IDs remain non-secret values in the environment
# file loaded below.
Environment=OPENAI_ADMIN_API_KEY_FILE=/etc/blueprint/provider-secrets/openai_admin_api_key
Environment=BLUEPRINT_OPENAI_COST_SCOPE_ATTESTATION_FILE=/etc/blueprint/provider-secrets/openai_cost_scope_attestation.json
Environment=OPENAI_ARTIFIXER_SEMANTIC_TEACHER_API_KEY_FILE=/etc/blueprint/provider-secrets/openai_api_key_artifixer_semantic_teacher
Environment=OPENAI_ARTIFIXER_VISUAL_REVIEW_API_KEY_FILE=/etc/blueprint/provider-secrets/openai_api_key_artifixer_visual_review
Environment=OPENAI_CONTENT_AGENTS_API_KEY_FILE=/etc/blueprint/provider-secrets/openai_api_key_content_agents
Environment=BLUEPRINT_OPENAI_ARTIFIXER_SEMANTIC_TEACHER_COST_SCOPE_ATTESTATION_FILE=/etc/blueprint/provider-secrets/openai_cost_scope_attestation_artifixer_semantic_teacher.json
Environment=BLUEPRINT_OPENAI_ARTIFIXER_VISUAL_REVIEW_COST_SCOPE_ATTESTATION_FILE=/etc/blueprint/provider-secrets/openai_cost_scope_attestation_artifixer_visual_review.json
Environment=BLUEPRINT_OPENAI_CONTENT_AGENTS_COST_SCOPE_ATTESTATION_FILE=/etc/blueprint/provider-secrets/openai_cost_scope_attestation_content_agents.json
# The configured directory is authoritative, so a key that exists only on
# somebody's workstation cannot stand in for one the deployment never
# installed. Three sibling units already declare it.
Environment=BLUEPRINT_GPU_PROVIDER_SECRETS_DIR=/etc/blueprint/provider-secrets
Environment=BLUEPRINT_WAM_OBJECT_STORE_ACCESS_KEY_ID_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_access_key_id
Environment=BLUEPRINT_WAM_OBJECT_STORE_SECRET_ACCESS_KEY_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_secret_access_key
Environment=BLUEPRINT_WAM_OBJECT_STORE_ENDPOINT_URL_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_endpoint_url
Environment=BLUEPRINT_WAM_OBJECT_STORE_BUCKET_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_bucket
Environment=BLUEPRINT_WAM_OBJECT_STORE_REGION_FILE=/etc/blueprint/provider-secrets/digitalocean_spaces_region
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_ACCESS_KEY_ID_FILE=/etc/blueprint/provider-secrets/backblaze_b2_key_id
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_SECRET_ACCESS_KEY_FILE=/etc/blueprint/provider-secrets/backblaze_b2_application_key
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_ENDPOINT_URL_FILE=/etc/blueprint/provider-secrets/backblaze_b2_s3_endpoint_url
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_BUCKET_FILE=/etc/blueprint/provider-secrets/backblaze_b2_bucket
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_REGION_FILE=/etc/blueprint/provider-secrets/backblaze_b2_region
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_EXPECTED_BUCKET=blueprint-task-evaluation-artifacts-prod
# A completed scene configuration must remain publishable to the canonical
# Website offering surface after a clean host rebuild. EnvironmentFile can
# override this deployment default for non-production installations.
Environment=PIPELINE_TASK_EVALUATION_LAUNCH_WEBAPP_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launches
Environment=PIPELINE_TASK_EVALUATION_LAUNCH_PUBLICATION_READINESS_URL=https://tryblueprint.io/api/internal/pipeline/task-evaluation-launch-publication-readiness
Environment=PIPELINE_SYNC_TOKEN_FILE=/etc/blueprint/provider-secrets/pipeline_sync_token
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
# A runtime drop-in may set FORCE_DRY_RUN=true while the canonical environment
# file still permits execution.  EnvironmentFile values override Environment=
# values in systemd, so a separate positive dry interlock is required; never
# rely on an Environment=...EXECUTE=false drop-in as a spend stop.
ExecStartPre=/bin/bash -lc 'test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -c "import optuna; assert optuna.__version__ == str(4)+chr(46)+str(9)+chr(46)+str(0)"'
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && ARGS=(-m blueprint_pipeline.task_evaluation_launch_dispatcher --queue-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT}" --profile-dir "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR}" --public-catalog "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_PUBLIC_CATALOG_PATH}" --state-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT}" --max-messages 10 --max-concurrency "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_MAX_CONCURRENCY:-1}") && if [ "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_FORCE_DRY_RUN:-}" != true ] && [ "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE:-}" = true ]; then ARGS+=(--execute); if [ -n "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE_ID:-}" ]; then ARGS+=(--execute-launch-id "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE_ID}"); fi; fi; exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" "$${ARGS[@]}"'
# KillMode=process deliberately preserves a valid hard-TTL watchdog. Reap every
# other remaining allocator/provider descendant before the oneshot is closed or
# restarted, and retain a secret-free reconciliation receipt.
ExecStopPost=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.task_evaluation_dispatcher_cgroup_cleanup --state-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT}" --receipt-dir "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT}/watchdog-cgroup-cleanup"'
