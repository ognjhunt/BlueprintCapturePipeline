[Unit]
Description=Dispatch one Blueprint Task Evaluation launch through the canonical allocator
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target blueprint-gpu-spend-guard.service
After=network-online.target blueprint-gpu-spend-guard.service

[Service]
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/task-evaluation-launch-profiles /etc/blueprint/provider-secrets
TasksMax=512
LimitNOFILE=65536
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=5h
Environment=BLUEPRINT_PIPELINE_REPO=/opt/blueprint/BlueprintCapturePipeline
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR=/etc/blueprint/task-evaluation-launch-profiles
Environment=BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs
# The hardened service cannot read a user home. Bind every allocator/runtime
# credential to the canonical read-only secret directory. The allocator still
# fails closed when a required file is absent; these paths grant no authority.
Environment=VAST_API_KEY_FILE=/etc/blueprint/provider-secrets/vast_api_key
Environment=NGC_API_KEY_FILE=/etc/blueprint/provider-secrets/ngc_api_key
Environment=DOCKER_USERNAME_FILE=/etc/blueprint/provider-secrets/docker_username
Environment=DOCKER_PAT_FILE=/etc/blueprint/provider-secrets/docker_pat
Environment=HF_TOKEN_FILE=/etc/blueprint/provider-secrets/huggingface_token
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd "$${BLUEPRINT_PIPELINE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${BLUEPRINT_PIPELINE_REPO}" && ARGS=(-m blueprint_pipeline.task_evaluation_launch_dispatcher --queue-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_QUEUE_ROOT}" --profile-dir "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_PROFILE_DIR}" --state-root "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_STATE_ROOT}" --max-messages 10) && if [ "$${BLUEPRINT_TASK_EVALUATION_LAUNCH_EXECUTE:-}" = true ]; then ARGS+=(--execute); fi; if [ -x .venv/bin/python ]; then exec .venv/bin/python "$${ARGS[@]}"; fi; exec env PYTHONPATH=src python3 "$${ARGS[@]}"'
