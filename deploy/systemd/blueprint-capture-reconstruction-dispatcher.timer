[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-capture-reconstruction-dispatcher.timer.json
Description=Resume incomplete Blueprint capture reconstruction checkpoints

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
Unit=blueprint-capture-reconstruction-dispatcher.service
Persistent=true

[Install]
WantedBy=timers.target
