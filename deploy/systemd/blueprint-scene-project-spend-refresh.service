[Unit]
Description=Refresh retained scene spend exposure from local receipts

[Service]
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~ptrace process_vm_readv process_vm_writev
TasksMax=32
# Host memory (8.3 GB, no swap): MemoryMax binds below the host, so a runaway
# is killed in this unit, not host-wide. It holds paid work, a money ledger or
# the WebApp's intake: -200, after batch jobs, before the money-safety units.
# Measured: reaches its cap: page cache of the receipts.
MemoryMax=512M
OOMScoreAdjust=-200
CPUQuota=100%
# Retained cancellation closure took 174 seconds on the four-vCPU host after
# scoped digest reuse. Leave bounded headroom for evidence growth and I/O jitter.
TimeoutStartSec=360
CapabilityBoundingSet=
AmbientCapabilities=
# Publishing an exposure snapshot takes the existing intake reservation lock.
# Only that lock file is writable; intent and reservation records stay read-only.
ReadWritePaths=/var/lib/blueprint/pipeline-control-plane/scene-project-spend /var/lib/blueprint/pipeline-control-plane/task-evaluation-scene-intents/.lock
Environment=PYTHONPATH=/opt/blueprint/task-evaluation-control-plane/src
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-progression.env
ExecStart=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python -c "from blueprint_pipeline.task_evaluation_scene_spend import refresh_configured_scene_project_spend; refresh_configured_scene_project_spend()"
