[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-pubsub-handoff-listener.timer.json
Description=Run Blueprint capture-bridge handoff listener repeatedly

[Timer]
OnActiveSec=30s
OnUnitInactiveSec=1min
RandomizedDelaySec=10s
Persistent=true
Unit=blueprint-pubsub-handoff-listener.service

[Install]
WantedBy=timers.target
