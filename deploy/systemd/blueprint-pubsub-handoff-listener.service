[Unit]
Description=Drain Blueprint capture-bridge Pub/Sub handoffs
# A failed or killed run is recorded and reported (blueprint-unit-failure@.service).
OnFailure=blueprint-unit-failure@%n.service
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
# Keep the independent geometry watchdog alive if the capture worker exits.
KillMode=process
Environment=BLUEPRINT_VAST_WATCHDOG_CALLER_EXIT_SURVIVAL=systemd_dispatcher_kill_mode_process
Environment=BLUEPRINT_VAST_CREDIT_GUARD_ENABLED=true
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
TasksMax=512
LimitNOFILE=65536
# Host memory (8.3 GB, no swap): website captures prepare in this unit
# (run_e2e, in-process); a preparation at production density passed 4.8 GB
# locally and a full room is not measured on the host.
# It runs in system-blueprintbatch.slice, which bounds the batch units
# together, and its own cap is the slice's (8G was above the host and never
# acted).
# Batch job, retried: +200, so it goes before the always-on services, paid
# work and the money-safety units.
Slice=system-blueprintbatch.slice
MemoryMax=5G
OOMScoreAdjust=200
CPUQuota=200%
Type=oneshot
# A run that never returned used to stop website hand-offs for good: the
# timer waits for this unit to go inactive (OnUnitInactiveSec). How long a
# full-room preparation takes on the host is not on record, so the bound is
# sized from the code: the longest capped step of a hand-off is the
# normalization encode, at one hour (website_source_video); its other
# capped steps (ffmpeg, hosted SAM 3.1, Gemini) are ten minutes or less;
# and the WebApp admits five new jobs a day. Five one-hour hand-offs in one
# tick, plus an hour, is 6h. systemd then stops only the main process
# (KillMode=process above), so a geometry watchdog keeps its deadline, and
# the unacknowledged message is delivered again.
TimeoutStartSec=6h
Environment=BLUEPRINT_PUBSUB_HANDOFF_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_PIPELINE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_LAUNCH_PROOF_MODE=production
Environment=PRIVACY_PIPELINE_ENABLED=true
Environment=PRIVACY_FAIL_CLOSED=true
Environment=PIPELINE_SYNC_REQUIRED=true
Environment=RETRIEVAL_REQUIRE_PRIVACY_SAFE_VIDEO=true
Environment=BLUEPRINT_PUBSUB_HANDOFF_SUBSCRIPTION=blueprint-pipeline-handoff-listener
Environment=BLUEPRINT_PUBSUB_HANDOFF_STORAGE_ROOT=/var/lib/blueprint/pubsub-handoffs
Environment=BLUEPRINT_PUBSUB_HANDOFF_PROVIDER=openai
Environment=BLUEPRINT_PUBSUB_HANDOFF_MAX_MESSAGES=10
Environment=BLUEPRINT_PUBSUB_HANDOFF_STAGE_CONTROL_PLANE=true
Environment=BLUEPRINT_PUBSUB_HANDOFF_SKIP_RUN_E2E=true
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-progression.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-configuration-release.env
WorkingDirectory=/
ExecStartPre=/bin/bash -lc 'cd -P "$${BLUEPRINT_PUBSUB_HANDOFF_REPO}" && export BLUEPRINT_PIPELINE_REPO="$${PWD}" && exec env PYTHONPATH=src "$${BLUEPRINT_PIPELINE_PYTHON}" -m blueprint_pipeline.production_runtime_env_guard'
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_PUBSUB_HANDOFF_REPO}" && export BLUEPRINT_PIPELINE_REPO="$${PWD}" && subscription="$${BLUEPRINT_PUBSUB_HANDOFF_SUBSCRIPTION:-blueprint-pipeline-handoff-listener}" && storage_root="$${BLUEPRINT_PUBSUB_HANDOFF_STORAGE_ROOT:-/var/lib/blueprint/pubsub-handoffs}" && provider="$${BLUEPRINT_PUBSUB_HANDOFF_PROVIDER:-openai}" && max_messages="$${BLUEPRINT_PUBSUB_HANDOFF_MAX_MESSAGES:-10}" && exec env PYTHONPATH=src "$${BLUEPRINT_PIPELINE_PYTHON}" -m blueprint_pipeline.task_evaluation_scene_retirement_supervisor --worker blueprint_pipeline.pubsub_handoff_listener -- --subscription "$${subscription}" --storage-root "$${storage_root}" --provider "$${provider}" --max-messages "$${max_messages}"'
Nice=5
