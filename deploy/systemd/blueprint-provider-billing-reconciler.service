[Unit]
Description=Refresh Blueprint provider billing evidence from official read-only APIs
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target
Before=blueprint-gpu-spend-guard.service

[Service]
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/provider-secrets
TasksMax=512
LimitNOFILE=65536
# Host memory (8.3 GB, no swap): MemoryMax binds below the host, so a runaway
# is killed in this unit, not host-wide. It holds paid work, a money ledger or
# the WebApp's intake: -200, after batch jobs, before the money-safety units.
# Measured: up to 1.7G on the host; not scene data, cause unverified.
MemoryHigh=3G
MemoryMax=4G
OOMScoreAdjust=-200
CPUQuota=200%
TimeoutStartSec=5m
# The billing export feeds provider-scoped admission, so it follows the same
# immutable Task Evaluation release identity as the guard. The reconciler's
# collector covers RunPod/Vast/DigitalOcean; AWS billing collection is
# unavailable and cannot authorize an AWS launch.
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_GPU_PROVIDER_SECRETS_DIR=/etc/blueprint/provider-secrets
Environment=BLUEPRINT_GPU_BILLING_EXPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/provider_billing_export.json
Environment=BLUEPRINT_PROVIDER_BILLING_AUDIT_ROOT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/billing-audit
Environment=BLUEPRINT_PROVIDER_BILLING_COHORT_START_AT=2026-01-01T00:00:00Z
# The spend guard wants this unit before every start (its one-minute timer and
# every unit that wants the guard), which ran a full refresh about every two
# minutes. A run now ends at once while this account's export is younger than
# the designed ten-minute cadence and covers every provider the guard's own last
# report found live; the guard and the admission lock accept evidence up to 24
# hours old. Set 0 in the environment file to refresh every run.
Environment=BLUEPRINT_PROVIDER_BILLING_MIN_REFRESH_SECONDS=600
# The guard's --json-report (blueprint-gpu-spend-guard.service), read only.
Environment=BLUEPRINT_GPU_SPEND_GUARD_REPORT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/latest.json
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && ARGS=(-m blueprint_pipeline.provider_billing_reconciler --secrets-dir "$${BLUEPRINT_GPU_PROVIDER_SECRETS_DIR}" --billing-export "$${BLUEPRINT_GPU_BILLING_EXPORT}" --audit-root "$${BLUEPRINT_PROVIDER_BILLING_AUDIT_ROOT}" --cohort-start-at "$${BLUEPRINT_PROVIDER_BILLING_COHORT_START_AT}" --min-refresh-interval-seconds "$${BLUEPRINT_PROVIDER_BILLING_MIN_REFRESH_SECONDS:-600}" --spend-guard-report "$${BLUEPRINT_GPU_SPEND_GUARD_REPORT}") && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" "$${ARGS[@]}"'
