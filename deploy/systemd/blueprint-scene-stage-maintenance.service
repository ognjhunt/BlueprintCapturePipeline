[Unit]
Description=Keep the website scene stage moving and tell each held job by name
# A failed or killed run is recorded and reported (blueprint-unit-failure@.service).
OnFailure=blueprint-unit-failure@%n.service
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
# No-spend (scene_stage_maintenance): the scene-packet queue's recovery and requeue with the site's
# success-rule confirmation exchange, the scene stage's held notices over the signed WebApp transport,
# an open job's scene run restored from cold storage, and a compiled packet's robot-free probe queued.
# No allocator, provider or GPU: the probe lane decides and pays under its own caps.
Type=oneshot
TimeoutStartSec=1h
User=blueprint
Group=blueprint
UMask=0077
EnvironmentFile=/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-configuration-release.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-progression.env
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
# The holds, the source states and their cursors stay where the trial's pass kept them.
Environment=BLUEPRINT_BETA_POLICY_SCREENING_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/beta-policy-screening
Environment=BLUEPRINT_TEAM_SCENE_PACKET_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/team-scene-packets
# Where a request's own intent is read: the site's success confirmation is written under it.
Environment=BLUEPRINT_TASK_EVALUATION_SCENE_INTAKE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-scene-intents
# Where a compiled packet's robot-free probe is queued (queued only; the probe runner launches it).
Environment=BLUEPRINT_RIGID_ROBOT_FREE_PROBE_QUEUE=/var/lib/blueprint/pipeline-control-plane/rigid-robot-free-probes
# Where the intake leaves a withdrawn site's tombstone: a withdrawn job's run is never restored (read only).
Environment=BLUEPRINT_WEBSITE_WITHDRAWAL_SITE_ROOTS=/var/lib/blueprint/pubsub-handoffs
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" || exit; export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}"; exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.scene_stage_maintenance'
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
# Scene runs restored in place, the packet and probe queues, the intents and the hold store are all
# under /var/lib/blueprint; nothing is written on the work volume.
ReadWritePaths=/var/lib/blueprint /var/lib/blueprint/pipeline-control-plane/beta-policy-screening /var/lib/blueprint/pipeline-control-plane/team-scene-packets
TasksMax=512
# Not measured on the host yet; the trial's tick ran these same duties under its 5.5G. A restore
# downloads and extracts one archive at a time, so it is bounded with the batch units. Batch job,
# retried: +200, so it goes before the always-on services, paid work and the money-safety units.
Slice=system-blueprintbatch.slice
MemoryMax=5.5G
OOMScoreAdjust=200
CPUQuota=200%
