[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-pipeline-control-plane.timer.json
Description=Run Blueprint live pipeline control-plane periodically

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Persistent=true
Unit=blueprint-pipeline-control-plane.service

[Install]
WantedBy=timers.target

