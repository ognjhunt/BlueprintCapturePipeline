[Unit]
Description=Compile a prepared website scene's robot-team half on the CPU and republish its job offer
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
# No-spend: no allocator, provider or GPU. It reads the scene's published
# revision documents, compiles on this host, records the derived team-registry
# row and posts the job's offer over the signed WebApp transport. One scene per
# run keeps each compile inside the timeout; the path unit starts the next.
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint /var/lib/blueprint/pipeline-control-plane/team-scene-packets /var/lib/blueprint/pipeline-control-plane/team-scene-packets/pending
TasksMax=512
LimitNOFILE=4096
MemoryMax=8G
# Host safety net (batch job, retried): the host has 8.3 GB and no swap, so
# MemoryMax above never binds and the kernel's OOM killer acts on the whole
# host. It counts this unit 20% of the host larger (+200), so a batch job goes
# before the always-on services and the money-safety units.
OOMScoreAdjust=200
CPUQuota=200%
TimeoutStartSec=1h
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_TEAM_SCENE_PACKET_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/team-scene-packets
# Where a request's own intent is read: an owner's success confirmation lives
# under it (read only; an env file below may name another root).
Environment=BLUEPRINT_TASK_EVALUATION_SCENE_INTAKE_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-scene-intents
# Where the compile runs: BLUEPRINT_TEAM_SCENE_PACKET_EXECUTION (host,
# cloud_run_shadow or cloud_run) comes from the shared environment file. Unset
# or empty it is auto: cloud_run once the config below is there and names
# team_scene_packet, host (today's path, byte for byte) without it. This unit
# holds no credential in any mode: in cloud_run it hands an eligible request to
# blueprint-team-scene-packet-remote.service, then records what that unit lands
# and republishes the offer. Set host to keep every compile on this host.
Environment=BLUEPRINT_REMOTE_CPU_JOBS_ROOT=/var/lib/blueprint/pipeline-control-plane/remote-cpu-jobs
Environment=BLUEPRINT_REMOTE_CPU_WORKERS_CONFIG=/etc/blueprint/remote-cpu-workers.json
# The same registry, capture partition, object store and WebApp bindings the
# scene progression and handoff listener read.
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-configuration-release.env
EnvironmentFile=-/etc/blueprint/task-evaluation-scene-progression.env
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.team_scene_packet_worker --max-messages 1'
