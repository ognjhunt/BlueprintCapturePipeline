[Unit]
Description=Retire terminal derived directories, reap unreferenced content-store blobs, and offload sealed evidence
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Cache trees contain both root-sealed receipts and blueprint-owned runtime
# projections. The reaper needs DAC override to remove the complete tree, but
# receives no other capability and can write only the classified roots below.
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint/task-evaluation-inputs/prepared-references /var/lib/blueprint/task-evaluation-inputs/compiled-episodes /var/lib/blueprint/task-evaluation-inputs/launch-activations /var/lib/blueprint/pipeline-control-plane/profile-install-staging /var/lib/blueprint/pipeline-control-plane/policy-canary-presubmission /var/lib/blueprint/pipeline-control-plane/storage-pins /var/lib/blueprint/pipeline-control-plane/storage-gc /var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs /var/lib/blueprint/pipeline-control-plane/task-evaluation-policy-canaries /var/lib/blueprint/pipeline-control-plane/task-evaluation-launches /var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-preparations /var/lib/blueprint/pipeline-control-plane/task-evaluation-episode-compilations /var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-activations /var/lib/blueprint/pipeline-control-plane/task-evaluation-policy-canary-dispatches /var/lib/blueprint/pipeline-control-plane/task-evaluation-scene-constructions -/var/lib/blueprint/pipeline-control-plane/episode-interpretation-backfills -/var/lib/blueprint/pipeline-control-plane/policy-canary-preprovider-audits -/var/lib/blueprint/pipeline-control-plane/engineering -/var/lib/blueprint/pipeline-control-plane/render-probes -/var/lib/blueprint/pipeline-control-plane/diagnostic-checkouts -/var/lib/blueprint/pipeline-control-plane/release-builds -/var/lib/blueprint/task-evaluation-inputs/render-probes
ReadOnlyPaths=/etc/blueprint/provider-secrets
ReadOnlyPaths=-/var/lib/blueprint/pubsub-handoffs -/var/lib/blueprint/spend-authority -/var/lib/blueprint/pipeline-control-plane/capture-reconstruction-derived -/var/lib/blueprint/pipeline-control-plane/capture-reconstruction-queue -/var/lib/blueprint/pipeline-control-plane/capture-reconstruction-runs -/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/billing-audit -/var/lib/blueprint/pipeline-control-plane/task-evaluation-terminal-resource-releases -/var/lib/blueprint/pipeline-control-plane/task-evaluation-terminal-resource-releases-state
TasksMax=512
LimitNOFILE=4096
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=3h
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
# Content stores whose blobs are implicitly pinned by hardlinks from derived directories.
Environment=BLUEPRINT_CONTROL_PLANE_GC_CONTENT_STORE_ROOTS=/var/lib/blueprint/task-evaluation-inputs/prepared-references/content-addressed/sha256:/var/lib/blueprint/task-evaluation-inputs/compiled-episodes/content-addressed/adapter-members/sha256
# Derived directories (cache class) retired once unpinned, aged, and unreferenced by any queue message.
Environment=BLUEPRINT_CONTROL_PLANE_GC_DERIVED_ROOTS=/var/lib/blueprint/task-evaluation-inputs/prepared-references:/var/lib/blueprint/task-evaluation-inputs/compiled-episodes:/var/lib/blueprint/task-evaluation-inputs/launch-activations:/var/lib/blueprint/pipeline-control-plane/profile-install-staging:/var/lib/blueprint/pipeline-control-plane/policy-canary-presubmission
Environment=BLUEPRINT_CONTROL_PLANE_GC_QUEUE_ROOTS=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launches:/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-preparations:/var/lib/blueprint/pipeline-control-plane/task-evaluation-episode-compilations:/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-activations:/var/lib/blueprint/pipeline-control-plane/task-evaluation-policy-canary-dispatches:/var/lib/blueprint/pipeline-control-plane/task-evaluation-scene-constructions
# Sealed run evidence eligible for offload after the hot window; offload itself stays dry-run until
# BLUEPRINT_CONTROL_PLANE_EVIDENCE_OFFLOAD=1 is set in the operator environment file.
Environment=BLUEPRINT_CONTROL_PLANE_GC_EVIDENCE_ROOTS=/var/lib/blueprint/pipeline-control-plane/task-evaluation-launch-runs:/var/lib/blueprint/pipeline-control-plane/task-evaluation-policy-canaries:/var/lib/blueprint/pipeline-control-plane/episode-interpretation-backfills:/var/lib/blueprint/pipeline-control-plane/policy-canary-preprovider-audits
# Offload itself stays an operator opt-in: BLUEPRINT_CONTROL_PLANE_EVIDENCE_OFFLOAD=1
# in the environment file.  Once opted in, the artifact store is the system of
# record for sealed run evidence and the host keeps a digest-bound pointer; two
# days covers every closeout that still reads a sealed run directory
# (interpretation, website sync, billing).
Environment=BLUEPRINT_CONTROL_PLANE_EVIDENCE_HOT_WINDOW_SECONDS=172800
# A run directory with no terminal receipt and no change for three days was
# abandoned by a superseded or torn-down worker; it is archived, not kept as live.
Environment=BLUEPRINT_CONTROL_PLANE_EVIDENCE_ABANDONED_AFTER_SECONDS=259200
Environment=BLUEPRINT_CONTROL_PLANE_GC_SCRATCH_ROOTS=/var/lib/blueprint/pipeline-control-plane/engineering:/var/lib/blueprint/pipeline-control-plane/render-probes:/var/lib/blueprint/pipeline-control-plane/diagnostic-checkouts:/var/lib/blueprint/pipeline-control-plane/release-builds:/var/lib/blueprint/task-evaluation-inputs/render-probes
Environment=BLUEPRINT_CONTROL_PLANE_GC_SCRATCH_MINIMUM_AGE_SECONDS=259200
Environment=BLUEPRINT_CONTROL_PLANE_STORAGE_PINS_ROOT=/var/lib/blueprint/pipeline-control-plane/storage-pins
Environment=BLUEPRINT_CONTROL_PLANE_GC_REPORT_ROOT=/var/lib/blueprint/pipeline-control-plane/storage-gc
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_ACCESS_KEY_ID_FILE=/etc/blueprint/provider-secrets/backblaze_b2_key_id
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_SECRET_ACCESS_KEY_FILE=/etc/blueprint/provider-secrets/backblaze_b2_application_key
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_BUCKET_FILE=/etc/blueprint/provider-secrets/backblaze_b2_bucket
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_ENDPOINT_URL_FILE=/etc/blueprint/provider-secrets/backblaze_b2_s3_endpoint_url
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_REGION_FILE=/etc/blueprint/provider-secrets/backblaze_b2_region
Environment=BLUEPRINT_TASK_EVALUATION_ARTIFACT_STORE_EXPECTED_BUCKET=blueprint-task-evaluation-artifacts-prod
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.control_plane_storage_gc run --apply --ack reclaim-control-plane-storage --report-out "$${BLUEPRINT_CONTROL_PLANE_GC_REPORT_ROOT}/latest.json"'
