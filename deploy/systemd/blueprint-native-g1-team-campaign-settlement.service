[Unit]
Description=Settle completed Blueprint G1 team campaigns and privately deliver review
Documentation=https://github.com/ognjhunt/BlueprintCapturePipeline
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=blueprint
Group=blueprint
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/blueprint
ReadOnlyPaths=/etc/blueprint/provider-secrets
TasksMax=512
LimitNOFILE=65536
MemoryMax=8G
CPUQuota=200%
TimeoutStartSec=30m
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_QUEUE_ROOT=/var/lib/blueprint/pipeline-control-plane/native-g1-team-campaigns
Environment=BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_WORK_ROOT=/var/lib/blueprint/pipeline-control-plane/native-g1-team-campaign-work
Environment=BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_RESULT_ROOT=/var/lib/blueprint/pipeline-control-plane/task-evaluation-policy-canaries
Environment=BLUEPRINT_PROVIDER_BILLING_AUDIT_ROOT=/var/lib/blueprint/pipeline-control-plane/gpu_spend_guard/billing-audit
Environment=PIPELINE_SYNC_WEBAPP_URL=https://tryblueprint.io
Environment=VAST_API_KEY_FILE=/etc/blueprint/provider-secrets/vast_api_key
EnvironmentFile=-/etc/blueprint/pipeline-control-plane.env
WorkingDirectory=/
ExecStart=/bin/bash -lc 'if [ ! -d "$${BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_QUEUE_ROOT}" ]; then exit 0; fi; cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" && export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}" && test -x "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" && exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.native_g1_team_campaign_settlement --queue-root "$${BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_QUEUE_ROOT}" --work-root "$${BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_WORK_ROOT}" --billing-audit-root "$${BLUEPRINT_PROVIDER_BILLING_AUDIT_ROOT}" --result-root "$${BLUEPRINT_NATIVE_G1_TEAM_CAMPAIGN_RESULT_ROOT}" --webapp-url "$${PIPELINE_SYNC_WEBAPP_URL}"'
