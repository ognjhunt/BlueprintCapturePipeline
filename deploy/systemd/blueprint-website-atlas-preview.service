[Unit]
Description=Advance consented website Atlas previews beside preparation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# One tick advances each preview job one bounded step (CPU depth fusion is the longest),
# then steps the jobs that advanced again at once for up to
# BLUEPRINT_WEBSITE_ATLAS_PREVIEW_CONTINUE_SECONDS (default 480, at most 3600; 0 turns
# it off). A job waiting on a provider, an admission or a budget is left to the timer;
# a hold, a deploy's quiesce (both stop the timer) or a new release ends the tick.
TimeoutStartSec=2h
User=blueprint
Group=blueprint
UMask=0077
# Intake reads BLUEPRINT_WEBSITE_ATLAS_ROUTING from the shared file; with it unset
# (routing off) no job exists and every tick is a no-op. Only this worker reads
# the Atlas key and provider settings, from its own optional file.
EnvironmentFile=/etc/blueprint/pipeline-control-plane.env
EnvironmentFile=-/etc/blueprint/website-atlas-preview.env
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO=/opt/blueprint/task-evaluation-control-plane
Environment=BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON=/opt/blueprint/BlueprintCapturePipeline/.venv/bin/python
Environment=BLUEPRINT_WEBSITE_ATLAS_PREVIEW_STORAGE_ROOT=/var/lib/blueprint/pubsub-handoffs
# Match numeric work to the worker's CPU quota; RGBD projections use small matrices.
Environment=OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
ExecStart=/bin/bash -lc 'cd -P "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_REPO}" || exit; export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$${PWD}"; exec env PYTHONPATH=src "$${BLUEPRINT_TASK_EVALUATION_CONTROL_PLANE_PYTHON}" -m blueprint_pipeline.website_atlas_preview tick --storage-root "$${BLUEPRINT_WEBSITE_ATLAS_PREVIEW_STORAGE_ROOT}"'
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/blueprint
TasksMax=512
MemoryMax=8G
CPUQuota=200%
Nice=10
