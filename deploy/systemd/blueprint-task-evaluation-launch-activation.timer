[Unit]
Wants=blueprint-operator-door-hold-sweep.service
After=blueprint-operator-door-hold-sweep.service
ConditionPathExists=!/var/lib/blueprint-operator-door/requests/holds/blueprint-task-evaluation-launch-activation.timer.json
Description=Run the Task Evaluation activation worker hourly so it retires claims a killed worker left

# The path unit starts the worker only when a pending/ row appears. This timer
# starts the same oneshot (never twice at once) so that the claim recovery at
# the start of every run also happens on an idle queue. A door hold on the path
# unit still stops every run: the service carries that hold's condition.
[Timer]
OnBootSec=10min
OnUnitInactiveSec=1h
RandomizedDelaySec=5min
Unit=blueprint-task-evaluation-launch-activation.service

[Install]
WantedBy=timers.target
