# Blueprint isolated staging intake environment.
# Copy to /etc/blueprint/pipeline-intake-staging.env with mode 0640,
# owner root, and group blueprint. Never commit a filled copy.

BLUEPRINT_PIPELINE_REPO=/opt/blueprint/BlueprintCapturePipeline-staging
# Must be the exact clean detached commit deployed in the staging checkout.
BLUEPRINT_SOURCE_COMMIT=

BLUEPRINT_LAUNCH_PROOF_MODE=production
PRIVACY_PIPELINE_ENABLED=true
PRIVACY_FAIL_CLOSED=true
PIPELINE_SYNC_REQUIRED=true
RETRIEVAL_REQUIRE_PRIVACY_SAFE_VIDEO=true

BLUEPRINT_LIVE_PIPELINE_INTAKE_HOST=127.0.0.1
PORT=8766
# Required staging-only HMAC secret. Do not reuse the production value.
BLUEPRINT_LIVE_PIPELINE_INTAKE_TOKEN=
BLUEPRINT_LIVE_PIPELINE_INTAKE_ALLOW_LEGACY_BEARER=false
BLUEPRINT_LIVE_PIPELINE_ALLOW_LEGACY_WEBAPP_HMAC_WITHOUT_CLIENT_ID=true
BLUEPRINT_LIVE_PIPELINE_INTAKE_WORK_DIR=/var/lib/blueprint-staging/pipeline-intake/incoming
BLUEPRINT_LIVE_PIPELINE_NONCE_STORE_DIR=/var/lib/blueprint-staging/pipeline-intake/nonces
BLUEPRINT_CONTROL_PLANE_OUTPUT_PATH=/var/lib/blueprint-staging/pipeline-intake/live_pipeline_control_plane_manifest.json

PIPELINE_CAPTURE_INTAKE_STORE_ROOT=/var/lib/blueprint-staging/capture-intakes
# Configure the exact signed-download host and an absolute scanner argv before
# exercising capture transfer. Health/version smoke does not upgrade this gate.
# PIPELINE_CAPTURE_TRANSFER_ALLOWED_HOSTS=f005.backblazeb2.com
# PIPELINE_CAPTURE_MALWARE_SCANNER_ARGV_JSON=["/usr/bin/clamdscan","--no-summary"]

# Staging intentionally has no control-plane trigger, provider credential,
# paid-compute gate, or physical action gate.
