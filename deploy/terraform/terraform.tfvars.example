# Blueprint Capture Pipeline - Terraform Variables
#
# Copy this file to terraform.tfvars and customize for your deployment.

# Required
project_id = "blueprint-8c1ca"

# Primary region for all resources
primary_region = "us-central1"

# Secondary regions for overflow and geographic distribution
# Set to [] for single-region deployment
secondary_regions = ["us-east1", "europe-west1"]

# Firebase Storage bucket (typically {project_id}.appspot.com)
storage_bucket = "blueprint-8c1ca.appspot.com"

# Release images for the pipeline and GPU services.
# Use the git-SHA tag produced by deploy/scripts/deploy.sh or immutable
# @sha256 digests from the deployment manifest; do not use :latest.
docker_image               = "gcr.io/blueprint-8c1ca/blueprint-pipeline:0123456789ab"
privacy_sam3_image         = "gcr.io/blueprint-8c1ca/sam3-privacy:0123456789ab"
privacy_vip_image          = "gcr.io/blueprint-8c1ca/vip-privacy:0123456789ab"
privacy_deepprivacy2_image = "gcr.io/blueprint-8c1ca/deepprivacy2-privacy:0123456789ab"
video_to_world_image       = "gcr.io/blueprint-8c1ca/video-to-world:0123456789ab"

# Maximum concurrent pipeline dispatches
max_concurrent_jobs = 25
pipeline_queue_depth_alert_threshold = 50
pipeline_queue_depth_alert_duration  = "300s"

# Per-service GPU runner caps. These intentionally stay below pipeline
# dispatch concurrency so an auth or retry failure cannot fan out to 25 GPU
# instances per expensive service.
privacy_sam3_max_instances         = 3
privacy_vip_max_instances          = 2
privacy_deepprivacy2_max_instances = 2
video_to_world_max_instances       = 2
gpu_runner_billable_instance_time_alert_threshold = 1.0
additional_privacy_runner_invoker_members = []

# Preview + World Labs request-manifest generation
blueprint_preview_provider = "world_labs"
worldlabs_default_model    = "Marble 0.1-mini"

# Privacy-safe video preparation
privacy_pipeline_enabled     = true
privacy_fail_closed          = true
video_to_world_runner_token  = ""
video_to_world_pipeline_preset = "preprocess_plus_alignment"
video_to_world_command_template = ""
sam3_weights_path            = ""
vip_model_path               = ""
deepprivacy2_model_path      = ""
depth_anything_model_path    = ""
huggingface_token_secret_name = ""

# Blueprint-WebApp sync-back
pipeline_sync_webapp_url = ""
pipeline_sync_token      = ""

# BlueprintCapture extractFrames publisher for large-video ingest requests.
capture_extract_frames_service_account_email = ""

# Optional GCP billing budget for the beta GPU/provider fleet.
billing_account_id                    = ""
gpu_fleet_billing_budget_usd          = 5000
gpu_fleet_billing_budget_thresholds   = [0.5, 0.8, 1.0]

# Enable push notifications via Firebase Cloud Messaging
enable_notifications = true
