# Canonical non-secret production profile. Copy to the deployment secret/config
# system; do not commit credentials or signed URLs here.
BLUEPRINT_ENV=production
GCS_ROOT=/mnt/gcs

# Current product path: capture -> qualification -> cards/packages -> Task Eval.
BLUEPRINT_SIM_ONLY_BETA_AUTONOMY=true
BLUEPRINT_SIM_ONLY_BETA_DEFAULT_TASK_EVAL=true

# Enables real local simulator execution only when the matching CLI allow flag
# and an explicit simulator command are also supplied.
BLUEPRINT_ALLOW_SIMULATOR_EXECUTION=true

# Paid allocation remains off in the base profile. Paid runs must use the shared
# paid_resource_allocator command and its separate admission evidence.
BLUEPRINT_ALLOW_GPU_PROVISIONING=false

# Training and live agent operators remain separate, explicit dual gates. The
# matching CLI flag is also required when either capability is intentionally enabled.
BLUEPRINT_ALLOW_COSMOS_TRAINING=false
BLUEPRINT_ALLOW_LIVE_AGENTS_SDK_OPERATORS=false

# Qualification computes core evidence and routing state, but launch/readiness/buyer
# trust projections remain an optional support edge.
BLUEPRINT_EMIT_READINESS_SUPPORT_OUTPUTS=false

# Hosted support rendering is provider-neutral by default. Select cosmos_wam
# only in a model-specific deployment that also provisions its explicit repo,
# checkpoint, and worker configuration.
BLUEPRINT_NATIVE_RUNTIME_BACKEND=site_splat

# Production WebApp handoff must be configured by the deployment secret store.
PIPELINE_SYNC_REQUIRED=true
PIPELINE_SYNC_WEBAPP_URL=https://REPLACE_WITH_WEBAPP_HOST/api/pipeline-sync
PIPELINE_SYNC_TOKEN_FILE=/run/secrets/pipeline_sync_token
