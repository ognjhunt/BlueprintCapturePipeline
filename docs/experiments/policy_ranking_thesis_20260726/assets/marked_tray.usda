#usda 1.0
(
    defaultPrim = "MarkedTray"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "MarkedTray" (
    kind = "component"
)
{
    custom string blueprint:asset_role = "task_target"
    custom string blueprint:success_region = "interior_aabb"

    def Cube "Base" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.22, -0.015, -0.16), (0.22, 0.015, 0.16)]
        color3f[] primvars:displayColor = [(0.08, 0.45, 0.95)]
        double3 xformOp:scale = (0.44, 0.03, 0.32)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Cube "WallLeft" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.08, 0.45, 0.95)]
        double3 xformOp:translate = (-0.215, 0.045, 0)
        double3 xformOp:scale = (0.03, 0.09, 0.32)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallRight" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.08, 0.45, 0.95)]
        double3 xformOp:translate = (0.215, 0.045, 0)
        double3 xformOp:scale = (0.03, 0.09, 0.32)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallFront" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.08, 0.45, 0.95)]
        double3 xformOp:translate = (0, 0.045, -0.145)
        double3 xformOp:scale = (0.40, 0.09, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallBack" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.08, 0.45, 0.95)]
        double3 xformOp:translate = (0, 0.045, 0.145)
        double3 xformOp:scale = (0.40, 0.09, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
