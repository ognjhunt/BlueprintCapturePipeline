{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/decision-evidence-router/v1/result.schema.json",
  "title": "Blueprint Decision Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "request_digest",
    "plan_digest",
    "testbed_digest",
    "decision_question",
    "overall_outcome",
    "per_claim_verdicts",
    "evidence_accepted",
    "evidence_rejected",
    "validation_envelope",
    "unsupported_conditions",
    "uncertainty",
    "severity_weighted_false_safe_risk",
    "false_reject_estimate",
    "evidence_coverage",
    "abstention_rate",
    "cross_method_disagreements",
    "shared_dependency_warnings",
    "claim_ceiling",
    "decision_rationale",
    "next_cheapest_experiment",
    "physical_evidence_still_required",
    "input_run_result_testbed_digests",
    "deployment_approval",
    "safety_certification",
    "raw_policy_values_persisted",
    "raw_secret_values_persisted",
    "decision_envelope_digest"
  ],
  "properties": {
    "schema_version": {"const": "decision_envelope.v1"},
    "decision_id": {"$ref": "#/$defs/identifier"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "testbed_digest": {"$ref": "#/$defs/digest"},
    "decision_question": {"type": "string", "minLength": 1},
    "overall_outcome": {"enum": ["decision", "partial_decision", "abstention"]},
    "per_claim_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "verdict", "rationale", "accepted_result_digests", "claim_ceiling"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/identifier"},
          "claim_type": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["supported", "not_supported", "abstention"]},
          "rationale": {"type": "string", "minLength": 1},
          "accepted_result_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
          "claim_ceiling": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "evidence_accepted": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "evidence_rejected": {"type": "array", "items": {"type": "object"}},
    "validation_envelope": {"type": "object", "minProperties": 1},
    "unsupported_conditions": {"type": "array"},
    "uncertainty": {"type": "object", "minProperties": 1},
    "severity_weighted_false_safe_risk": {"type": "number", "minimum": 0, "maximum": 1},
    "false_reject_estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "evidence_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "abstention_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "cross_method_disagreements": {"type": "array", "items": {"type": "object"}},
    "shared_dependency_warnings": {"type": "array", "items": {"type": "object"}},
    "claim_ceiling": {"type": "object", "minProperties": 1},
    "decision_rationale": {"type": "string", "minLength": 1},
    "next_cheapest_experiment": {"type": "string", "minLength": 1},
    "physical_evidence_still_required": {"type": "array"},
    "input_run_result_testbed_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
    "deployment_approval": {"const": false},
    "safety_certification": {"const": false},
    "raw_policy_values_persisted": {"const": false},
    "raw_secret_values_persisted": {"const": false},
    "decision_envelope_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
