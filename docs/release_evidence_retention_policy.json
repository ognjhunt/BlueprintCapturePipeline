{
  "schema_version": "blueprint.release_evidence_retention_policy.v1",
  "minimum_retention_days": 2555,
  "object_lock_mode": "COMPLIANCE",
  "require_bucket_object_lock": true,
  "require_version_id": true,
  "require_sha256_checksum_readback": true,
  "actions_artifact_transport_days": 90,
  "required_evidence_groups_by_scope": {
    "BASE": ["source", "ci", "full_test", "dependency", "sast", "coverage", "supply_chain", "codeql", "signature"],
    "SIM": ["source", "ci", "full_test", "dependency", "sast", "coverage", "supply_chain", "codeql", "signature", "sim_only"],
    "PTDP": ["source", "ci", "full_test", "dependency", "sast", "coverage", "supply_chain", "codeql", "signature", "ptdp", "native_lerobot"],
    "SC3": ["source", "ci", "full_test", "dependency", "sast", "coverage", "supply_chain", "codeql", "signature", "sim_only", "sc3", "gpu_canary", "native_lerobot"],
    "PAID": ["source", "ci", "full_test", "dependency", "sast", "coverage", "supply_chain", "codeql", "signature", "sim_only", "ptdp", "sc3", "gpu_canary", "restore_drill", "pubsub", "native_lerobot"],
    "LIVE": ["source", "ci", "full_test", "dependency", "sast", "coverage", "supply_chain", "codeql", "signature", "sim_only", "ptdp", "sc3", "gpu_canary", "restore_drill", "pubsub", "native_lerobot", "deployment_readback"]
  },
  "claim_boundary": {
    "github_actions_artifacts_are_transport_not_durable_archive": true,
    "bundle_creation_is_not_immutable_archive_proof": true,
    "archive_receipt_requires_object_lock_and_version_readback": true,
    "legal_hold_and_deletion_policy_require_separate_owner_approval": true
  }
}
