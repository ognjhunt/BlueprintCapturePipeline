{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/measurement-dlo-lab-cable-development-corpus.v1.schema.json",
  "title": "Blueprint DLO-Lab cable development corpus",
  "type": "object",
  "required": ["schema_version", "corpus_id", "description", "lane", "development_only", "synthetic_fixture", "held_out", "physical_measurements_included", "qualification_labels_included", "r5_evidence", "r6_decision", "r7_admission", "shared_operating_point", "metric_definitions", "cases"],
  "properties": {
    "schema_version": {"const": "measurement_dlo_lab_cable_development_corpus.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "cable"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {
      "type": "object",
      "required": ["adapter_protocol", "length_unit", "mass_unit", "time_unit", "n_vertices", "start_m", "direction", "gravity_m_s2", "timestep_s", "step_count", "substeps", "damping", "angular_damping", "maximum_segment_strain"],
      "properties": {
        "adapter_protocol": {"const": "dlo_lab_parameterized_rod_cantilever.v1"},
        "length_unit": {"const": "meters"},
        "mass_unit": {"const": "kilograms"},
        "time_unit": {"const": "seconds"},
        "n_vertices": {"type": "integer", "minimum": 6, "maximum": 256},
        "start_m": {"$ref": "#/$defs/vector3"},
        "direction": {"const": [1.0, 0.0, 0.0]},
        "gravity_m_s2": {"$ref": "#/$defs/vector3"},
        "timestep_s": {"type": "number", "minimum": 0.000001, "maximum": 0.01},
        "step_count": {"type": "integer", "minimum": 10, "maximum": 5000},
        "substeps": {"type": "integer", "minimum": 1, "maximum": 32},
        "damping": {"type": "number", "minimum": 0},
        "angular_damping": {"type": "number", "minimum": 0},
        "maximum_segment_strain": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "metric_definitions": {
      "type": "object",
      "required": ["state_trajectory", "force", "task_outcome"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "cases": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "case": {
      "type": "object",
      "required": ["case_id", "base_length_m", "base_radius_m", "segment_mass_kg", "youngs_modulus_pa", "shear_modulus_pa", "maximum_tip_displacement_m"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "base_length_m": {"type": "number", "exclusiveMinimum": 0},
        "base_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "segment_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "shear_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "maximum_tip_displacement_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
