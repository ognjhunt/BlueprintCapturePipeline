{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_rigid_destination_placement_qualification.v1.schema.json",
  "title": "Task Evaluation rigid destination placement qualification v1",
  "description": "Scene-specific deterministic qualification of one passive destination asset at one exact pose.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "producer",
    "native_observation_digest",
    "execution_commit",
    "runtime_identity",
    "container_identity",
    "destination_identity",
    "configured_scene_revision_digest",
    "configured_scene_collision_digest",
    "configured_scene_support_plane_digest",
    "destination_asset_digest",
    "destination_static_qualification_digest",
    "destination_native_import_qualification_digest",
    "destination_geometry_digest",
    "pose_world",
    "nonpenetration_passed",
    "support_stability_passed",
    "native_measurement_summary",
    "no_policy_execution",
    "camera_visibility",
    "repeated_reset_readback",
    "placement_qualification_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task_evaluation_rigid_destination_placement_qualification.v1"},
    "status": {"const": "qualified"},
    "producer": {"const": "task_evaluation_rigid_destination_placement_qualification"},
    "native_observation_digest": {"$ref": "#/$defs/digest"},
    "execution_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "runtime_identity": {"$ref": "#/$defs/versionedIdentity"},
    "container_identity": {
      "type": "object",
      "required": ["image", "digest"],
      "additionalProperties": false,
      "properties": {
        "image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "destination_identity": {"$ref": "#/$defs/versionedIdentity"},
    "configured_scene_revision_digest": {"$ref": "#/$defs/digest"},
    "configured_scene_collision_digest": {"$ref": "#/$defs/digest"},
    "configured_scene_support_plane_digest": {"$ref": "#/$defs/digest"},
    "destination_asset_digest": {"$ref": "#/$defs/digest"},
    "destination_static_qualification_digest": {"$ref": "#/$defs/digest"},
    "destination_native_import_qualification_digest": {"$ref": "#/$defs/digest"},
    "destination_geometry_digest": {"$ref": "#/$defs/digest"},
    "pose_world": {"$ref": "#/$defs/pose"},
    "nonpenetration_passed": {"const": true},
    "support_stability_passed": {"const": true},
    "native_measurement_summary": {
      "type": "object",
      "required": ["maximum_penetration_m", "minimum_support_contact_force_n", "maximum_forbidden_contact_force_n", "raw_measurement_artifact_count"],
      "additionalProperties": false,
      "properties": {
        "maximum_penetration_m": {"type": "number", "minimum": 0},
        "minimum_support_contact_force_n": {"type": "number", "minimum": 0},
        "maximum_forbidden_contact_force_n": {"type": "number", "minimum": 0},
        "raw_measurement_artifact_count": {"type": "integer", "minimum": 1}
      }
    },
    "no_policy_execution": {
      "type": "object",
      "required": ["policy_loaded", "candidate_policy_queried", "candidate_outcomes_accessed", "policy_actions_executed"],
      "additionalProperties": false,
      "properties": {
        "policy_loaded": {"const": false},
        "candidate_policy_queried": {"const": false},
        "candidate_outcomes_accessed": {"const": false},
        "policy_actions_executed": {"const": 0}
      }
    },
    "camera_visibility": {
      "type": "object",
      "required": ["external", "wrist", "overview"],
      "additionalProperties": false,
      "properties": {
        "external": {"const": true},
        "wrist": {"const": true},
        "overview": {"const": true}
      }
    },
    "repeated_reset_readback": {
      "type": "object",
      "required": [
        "repeat_count",
        "maximum_translation_error_m",
        "maximum_rotation_error_rad",
        "translation_tolerance_m",
        "rotation_tolerance_rad"
      ],
      "additionalProperties": false,
      "properties": {
        "repeat_count": {"type": "integer", "minimum": 3},
        "maximum_translation_error_m": {"type": "number", "minimum": 0},
        "maximum_rotation_error_rad": {"type": "number", "minimum": 0},
        "translation_tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "rotation_tolerance_rad": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "placement_qualification_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "versionedIdentity": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"}
      }
    },
    "pose": {
      "type": "object",
      "required": ["position_world_m", "orientation_xyzw"],
      "additionalProperties": false,
      "properties": {
        "position_world_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "orientation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        }
      }
    }
  }
}
