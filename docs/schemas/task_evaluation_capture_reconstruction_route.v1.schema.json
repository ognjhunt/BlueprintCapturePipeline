{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blueprint.ai/task_evaluation_capture_reconstruction_route.v1.schema.json",
  "title": "Task Evaluation Capture Reconstruction Route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_build_digest",
    "status",
    "capture_authority_profile",
    "declared_profile_candidates",
    "capture_profile_validation_status",
    "capture_profile_validation_digest",
    "requested_claim_types",
    "required_representations",
    "appearance_fidelity_requirements",
    "stages",
    "currently_registered_adapters",
    "blockers",
    "next_legal_action",
    "agent_selected_capture_profile",
    "execution_authorized_by_route",
    "route_is_reconstruction_evidence",
    "appearance_layer_is_metric_or_physics_truth",
    "physical_success_established",
    "proof_effect",
    "capture_reconstruction_route_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "task_evaluation_capture_reconstruction_route.v1"
    },
    "capture_build_digest": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "route_proposed",
        "capture_profile_required",
        "ambiguous_capture_profile",
        "capture_profile_validation_required",
        "capture_profile_validation_failed",
        "capture_profile_validation_invalid"
      ]
    },
    "capture_authority_profile": {
      "type": ["string", "null"],
      "enum": [
        "iphone_arkit_lidar",
        "iphone_arkit_non_lidar",
        "camera_360_equirectangular",
        "camera_360_native",
        "monocular_video",
        "precomputed_external_reconstruction",
        null
      ]
    },
    "declared_profile_candidates": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "capture_profile_validation_status": {
      "enum": [
        "not_applicable_to_profile",
        "required_raw_contract_gate",
        "required_missing",
        "validated",
        "blocked",
        "invalid"
      ]
    },
    "capture_profile_validation_digest": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "requested_claim_types": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "required_representations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "appearance_fidelity_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_resolution_source_is_appearance_truth",
        "unqualified_global_decimation_forbidden",
        "qualified_removal_reasons",
        "source_retained_ratio_required",
        "source_and_retained_bounds_required",
        "representation_coordinate_basis_and_camera_binding_required",
        "spherical_harmonics_degree_required",
        "reference_frame_comparison_required",
        "native_3dgs_renderer_required",
        "appearance_renderer_independent_from_dynamics_engine",
        "exact_camera_depth_aware_robot_composite_required",
        "presentation_derivative_evaluation_use_forbidden"
      ],
      "properties": {
        "full_resolution_source_is_appearance_truth": {"const": true},
        "unqualified_global_decimation_forbidden": {"const": true},
        "qualified_removal_reasons": {
          "const": ["low_opacity", "nonfinite", "robust_spatial_outlier"]
        },
        "source_retained_ratio_required": {"const": true},
        "source_and_retained_bounds_required": {"const": true},
        "representation_coordinate_basis_and_camera_binding_required": {"const": true},
        "spherical_harmonics_degree_required": {"const": true},
        "reference_frame_comparison_required": {"const": true},
        "native_3dgs_renderer_required": {"const": true},
        "appearance_renderer_independent_from_dynamics_engine": {"const": true},
        "exact_camera_depth_aware_robot_composite_required": {"const": true},
        "presentation_derivative_evaluation_use_forbidden": {"const": true}
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "stage_id",
          "method_kind",
          "implementation_status"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "stage_id": {"type": "string", "minLength": 1},
          "method_kind": {"type": "string", "minLength": 1},
          "implementation_status": {
            "enum": [
              "registered",
              "registered_conditional",
              "required_not_registered",
              "required_deterministic_gate"
            ]
          }
        }
      }
    },
    "currently_registered_adapters": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "next_legal_action": {
      "enum": [
        "compile_profile_specific_reconstruction_plan",
        "request_validated_capture_profile",
        "request_deterministic_capture_profile_validation",
        "request_corrected_capture_intake",
        "preserve_evidence_and_stop"
      ]
    },
    "agent_selected_capture_profile": {"const": false},
    "execution_authorized_by_route": {"const": false},
    "route_is_reconstruction_evidence": {"const": false},
    "appearance_layer_is_metric_or_physics_truth": {"const": false},
    "physical_success_established": {"const": false},
    "proof_effect": {"const": "none"},
    "capture_reconstruction_route_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
