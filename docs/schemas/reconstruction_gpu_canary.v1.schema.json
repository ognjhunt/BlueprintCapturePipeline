{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_gpu_canary.v1.schema.json",
  "title": "Reconstruction GPU Canary Request and Admission v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "operation", "capture_profile", "source_commit_sha", "worker_image_digest", "worker_stack_manifest_digest", "deterministic_configuration_digest", "operation_request_digest", "operation_input_bundle_digest", "expected_runtime_result_schema", "candidate_may_read_hidden_heldout", "trainer_may_grade_heldout", "max_spend_usd", "hard_ttl_seconds", "retry_cap", "authority_id", "proof_effect", "request_digest"],
      "properties": {
        "schema_version": {"const": "reconstruction_gpu_canary_request.v1"},
        "operation_request_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "operation_input_bundle_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "expected_runtime_result_schema": {"enum": ["reconstruction_vast_worker_smoke_result.v1", "pose_estimation_result.v1", "reconstruction_training_result.v1", "isaac_splat_nurec_render_result.v3", "provider_nurec_isaac_runtime_result.v1", "measurement_isaac_physx_vast_runtime_result.v1", "measurement_dlo_lab_cuda_vast_runtime_result.v1"]},
        "candidate_may_read_hidden_heldout": {"const": false},
        "trainer_may_grade_heldout": {"const": false},
        "proof_effect": {"const": "none"},
        "request_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {"enum": ["provider_nurec_isaac_canary", "external_scene_isaac_canary"]}
            },
            "required": ["operation"]
          },
          "then": {
            "required": [
              "source_relationship_to_blueprint_raw_capture",
              "external_derived_support_asset",
              "blueprint_raw_capture_truth"
            ],
            "properties": {
              "source_relationship_to_blueprint_raw_capture": {"const": "none"},
              "external_derived_support_asset": {"const": true},
              "blueprint_raw_capture_truth": {"const": false},
              "reconstruction_dataset_digest": false,
              "frozen_split_digest": false,
              "calibration_digest": false
            },
            "allOf": [
              {
                "if": {"properties": {"operation": {"const": "provider_nurec_isaac_canary"}}, "required": ["operation"]},
                "then": {
                  "required": ["external_import_receipt_digest", "provider_qualification_report_digest"],
                  "properties": {
                    "external_import_receipt_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
                    "provider_qualification_report_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
                  }
                }
              },
              {
                "if": {"properties": {"operation": {"const": "external_scene_isaac_canary"}}, "required": ["operation"]},
                "then": {
                  "required": [
                    "remote_processing_authorization_digest", "package_result_digest",
                    "collision_candidate_digest", "scene_frame_binding_digest",
                    "target_analysis_digest", "target_binding_digest", "placement_proposal_digest",
                    "source_video_available", "source_video_required_for_candidate_execution",
                    "independent_metric_scale_proven", "remote_upload_authorized", "paid_compute_authorized"
                  ],
                  "properties": {
                    "source_video_available": {"const": false},
                    "source_video_required_for_candidate_execution": {"const": false},
                    "independent_metric_scale_proven": {"const": false},
                    "remote_upload_authorized": {"const": true},
                    "paid_compute_authorized": {"const": true}
                  }
                }
              }
            ]
          },
          "else": {
            "required": [
              "reconstruction_dataset_digest",
              "frozen_split_digest",
              "calibration_digest"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schema_version", "status", "probe_kind", "provider", "blockers", "provider_mutations_performed", "paid_execution_started", "allocation_success_is_scientific_success", "proof_effect", "claim_ceiling", "admission_digest"],
      "properties": {
        "schema_version": {"const": "reconstruction_gpu_canary_admission.v1"},
        "status": {"enum": ["dry_run_ready", "execute_ready", "blocked"]},
        "provider": {"const": "vast"},
        "provider_mutations_performed": {"const": 0},
        "paid_execution_started": {"const": false},
        "allocation_success_is_scientific_success": {"const": false},
        "proof_effect": {"const": "none"},
        "admission_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    }
  ]
}
