{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_scene_policy_binding.v1.schema.json",
  "title": "Persistent owner checkpoint pair and reserved policy attempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_intent_digest", "attempt_id", "policy_candidates", "runtime_digest", "input_digest", "binding_digest"],
  "properties": {
    "schema_version": {"const": "task_evaluation_scene_policy_binding.v1"},
    "scene_intent_digest": {"$ref": "#/$defs/digest"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "binding_digest": {"$ref": "#/$defs/digest"},
    "policy_candidates": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "artifact_digest"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "artifact_digest": {"$ref": "#/$defs/digest", "description": "Admitted checkpoint inventory digest, not a model-name hash."}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
