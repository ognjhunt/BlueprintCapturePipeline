{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-geometry-contact-cross-engine-development-suite.v1.schema.json",
  "title": "Blueprint Capture-to-Geometry-and-Contact cross-engine development suite",
  "type": "object",
  "required": ["schema_version", "corpus_id", "corpus_digest", "benchmark_spec_digest", "method_ids", "execution_requested", "status", "case_pair_count", "method_execution_count", "all_methods_completed", "all_replays_deterministic", "case_pairs", "aggregate_cross_engine_deltas", "execution_bundle_digests", "development_only", "synthetic_fixture", "held_out", "physical_measurements_included", "qualification_labels_included", "independent_execution", "r5_evidence", "r6_decision", "r7_admission", "production_route_eligible", "physical_success_established", "agent_may_promote", "suite_digest"],
  "properties": {
    "schema_version": {"const": "capture_to_geometry_contact_cross_engine_development_suite.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_digest": {"$ref": "#/$defs/digest"},
    "benchmark_spec_digest": {"$ref": "#/$defs/digest"},
    "method_ids": {"const": ["mujoco-3", "newton-1-4"]},
    "execution_requested": {"type": "boolean"},
    "status": {"enum": ["planned_not_executed", "completed_development_only", "incomplete"]},
    "case_pair_count": {"type": "integer", "minimum": 2},
    "method_execution_count": {"type": "integer", "minimum": 4},
    "all_methods_completed": {"type": "boolean"},
    "all_replays_deterministic": {"type": "boolean"},
    "case_pairs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["case_id", "case_pair_digest", "body_shape", "all_methods_completed", "method_results", "cross_engine_deltas"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "case_pair_digest": {"$ref": "#/$defs/digest"},
          "body_shape": {"enum": ["sphere", "box"]},
          "all_methods_completed": {"type": "boolean"},
          "method_results": {
            "type": "object",
            "required": ["mujoco-3", "newton-1-4"],
            "properties": {
              "mujoco-3": {"type": "object"},
              "newton-1-4": {"type": "object"}
            },
            "additionalProperties": false
          },
          "cross_engine_deltas": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "aggregate_cross_engine_deltas": {"type": "object"},
    "execution_bundle_digests": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/digest"}},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "independent_execution": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "production_route_eligible": {"const": false},
    "physical_success_established": {"const": false},
    "agent_may_promote": {"const": false},
    "suite_digest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
