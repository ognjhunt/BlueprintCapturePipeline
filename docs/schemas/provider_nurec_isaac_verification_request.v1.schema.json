{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/provider_nurec_isaac_verification_request.v1.schema.json",
  "title": "Provider NuRec Isaac verification request v1",
  "type": "object",
  "required": [
    "schema_version", "source_commit_sha", "package_digest", "package_artifact_reference",
    "external_import_receipt_digest", "qualification_report_digest", "fixed_camera_spec_digest",
    "fixed_camera_ids", "runtime_implementation_digest", "runtime_container_image_digest",
    "expected_prim_paths", "physics_probe_request", "timeout_seconds", "spend_controls",
    "provider_authored_package", "exact_package_required", "headless", "display_attached",
    "execution_status", "provider_allocation_performed", "expected_runtime_schema", "proof_effect", "claim_ceiling",
    "isaac_verification_request_digest"
  ],
  "properties": {
    "schema_version": {"const": "provider_nurec_isaac_verification_request.v1"},
    "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
    "package_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_container_image_digest": {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "provider_authored_package": {"const": true},
    "exact_package_required": {"const": true},
    "headless": {"const": true},
    "display_attached": {"const": false},
    "execution_status": {"const": "awaiting_explicit_paid_runtime_authorization"},
    "provider_allocation_performed": {"const": false},
    "expected_runtime_schema": {"const": "provider_nurec_isaac_runtime_result.v1"},
    "proof_effect": {"const": "none"},
    "claim_ceiling": {"const": "request_only"},
    "isaac_verification_request_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
