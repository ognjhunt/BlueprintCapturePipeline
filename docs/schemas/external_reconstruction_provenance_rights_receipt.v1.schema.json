{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/external_reconstruction_provenance_rights_receipt.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "source_capture_identity", "source_capture_digest", "provider_identity", "product_tier", "terms_version", "provider_scan_or_job_identity", "ownership_or_license_confirmed", "commercial_use_status", "intended_uses", "consent_status", "privacy_status", "confidentiality_terms_status", "retention_status", "deletion_status", "model_training_terms_status", "competitive_use_status", "resale_status", "benchmarking_status", "user_managed_provider_processing_attested", "declaration_digest", "status", "blueprint_remote_upload_performed", "remote_upload_authorized_by_receipt", "provider_success_is_blueprint_qualification", "proof_effect", "claim_ceiling", "provenance_rights_receipt_digest"],
  "properties": {
    "schema_version": {"const": "external_reconstruction_provenance_rights_receipt.v1"},
    "source_capture_digest": {"$ref": "#/$defs/digest"},
    "provider_identity": {"enum": ["scaniverse", "polycam"]},
    "ownership_or_license_confirmed": {"const": true},
    "commercial_use_status": {"enum": ["permitted", "not_requested"]},
    "intended_uses": {"type": "array", "minItems": 1},
    "consent_status": {"enum": ["accepted", "not_required"]},
    "privacy_status": {"enum": ["cleared", "restricted_local_only"]},
    "user_managed_provider_processing_attested": {"const": true},
    "declaration_digest": {"$ref": "#/$defs/digest"},
    "status": {"const": "accepted_for_declared_local_import_only"},
    "blueprint_remote_upload_performed": {"const": false},
    "remote_upload_authorized_by_receipt": {"const": false},
    "provider_success_is_blueprint_qualification": {"const": false},
    "proof_effect": {"const": "provenance_and_rights_for_local_import_only"},
    "claim_ceiling": {"const": "external_reconstruction_import"},
    "provenance_rights_receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": true
}
