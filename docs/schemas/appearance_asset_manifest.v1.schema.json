{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/appearance_asset_manifest.v1.schema.json",
  "title": "Appearance Asset Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "stable_run_identity",
    "source_capture_identity",
    "source_capture_digest",
    "reconstruction_training_request_digest",
    "reconstruction_training_result_digest",
    "source_appearance_asset_reference",
    "source_appearance_asset_digest",
    "source_asset_format",
    "appearance_asset_reference",
    "appearance_asset_digest",
    "appearance_asset_format",
    "source_prim_path",
    "splat_count",
    "sh_degree",
    "coordinate_frame_declaration",
    "units",
    "metric_scale_status",
    "captured_observation",
    "raw_evidence",
    "metric_geometry_proven",
    "collision_geometry_proven",
    "heldout_evaluated",
    "proof_effect",
    "claim_ceiling",
    "appearance_asset_manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "appearance_asset_manifest.v1"},
    "source_capture_digest": {"$ref": "#/$defs/digest"},
    "reconstruction_training_request_digest": {"$ref": "#/$defs/digest"},
    "reconstruction_training_result_digest": {"$ref": "#/$defs/digest"},
    "source_appearance_asset_reference": {"type": "string", "pattern": "^[^/].*\\.ply$"},
    "source_appearance_asset_digest": {"$ref": "#/$defs/digest"},
    "source_asset_format": {"const": "standard_3dgs_ply"},
    "appearance_asset_reference": {"type": "string", "pattern": "^[^/].*\\.usd[ac]?$"},
    "appearance_asset_digest": {"$ref": "#/$defs/digest"},
    "appearance_asset_format": {"const": "particlefield_usd"},
    "source_prim_path": {"const": "/World/Appearance"},
    "splat_count": {"type": "integer", "minimum": 1},
    "sh_degree": {"type": "integer", "minimum": 0, "maximum": 3},
    "units": {"const": "meters"},
    "captured_observation": {"const": false},
    "raw_evidence": {"const": false},
    "metric_geometry_proven": {"const": false},
    "collision_geometry_proven": {"const": false},
    "heldout_evaluated": {"const": false},
    "proof_effect": {"const": "appearance_asset_candidate_only"},
    "claim_ceiling": {"const": "appearance_reconstruction"},
    "appearance_asset_manifest_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
