{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/teleport_sealed_evaluation_request.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "provider_received_hidden_views", "provider_received_hidden_pixels", "split_frozen_before_provider_execution", "thresholds_frozen_before_evaluation", "hidden_views", "evaluator_root", "reconstruction_dataset_digest", "evaluator_implementation_digest", "evaluator_identity", "evaluator_provider_identity", "thresholds", "timestamp"],
  "properties": {
    "schema_version": {"const": "teleport_sealed_evaluation_request.v1"},
    "provider_received_hidden_views": {"const": false},
    "provider_received_hidden_pixels": {"const": false},
    "split_frozen_before_provider_execution": {"const": true},
    "thresholds_frozen_before_evaluation": {"const": true},
    "hidden_views": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "reconstruction_dataset_digest": {"$ref": "#/$defs/digest"},
    "evaluator_implementation_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": true
}
