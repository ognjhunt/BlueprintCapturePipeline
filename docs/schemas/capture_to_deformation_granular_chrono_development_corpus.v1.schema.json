{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-deformation-granular-chrono-development-corpus.v1.schema.json",
  "title": "Blueprint PyChrono NSC granular development corpus",
  "type": "object",
  "required": ["schema_version", "corpus_id", "description", "lane", "development_only", "synthetic_fixture", "held_out", "physical_measurements_included", "physical_material_characterization_included", "qualification_labels_included", "r5_evidence", "r6_decision", "r7_admission", "shared_operating_point", "metric_definitions", "cases"],
  "properties": {
    "schema_version": {"const": "capture_to_deformation_granular_chrono_development_corpus.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "granular"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "physical_material_characterization_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {
      "type": "object",
      "required": ["adapter_protocol", "particle_shape", "particle_size_distribution", "cohesion_model", "material_characterization_scope", "contact_method", "collision_system", "count_x", "count_y", "count_z", "duration_s", "timestep_s", "minimum_settled_fraction", "minimum_spread_ratio", "maximum_spread_ratio", "maximum_penetration_m", "maximum_normal_contact_force_n"],
      "properties": {
        "adapter_protocol": {"const": "chrono_nsc_spherical_particle_column_collapse.v1"},
        "particle_shape": {"const": "sphere"},
        "particle_size_distribution": {"const": "monodisperse"},
        "cohesion_model": {"const": "none"},
        "material_characterization_scope": {"const": "synthetic_parameters_only"},
        "contact_method": {"const": "nonsmooth_contact"},
        "collision_system": {"const": "bullet"},
        "count_x": {"type": "integer", "minimum": 2, "maximum": 8},
        "count_y": {"type": "integer", "minimum": 2, "maximum": 8},
        "count_z": {"type": "integer", "minimum": 2, "maximum": 8},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "timestep_s": {"type": "number", "exclusiveMinimum": 0},
        "minimum_settled_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_spread_ratio": {"type": "number", "minimum": 1},
        "maximum_spread_ratio": {"type": "number", "minimum": 1},
        "maximum_penetration_m": {"type": "number", "minimum": 0},
        "maximum_normal_contact_force_n": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "metric_definitions": {"type": "object", "minProperties": 4},
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["case_id", "synthetic_material_id", "particle_radius_m", "particle_density_kg_m3", "contact_friction"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "synthetic_material_id": {"type": "string", "minLength": 1},
          "particle_radius_m": {"type": "number", "exclusiveMinimum": 0},
          "particle_density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
          "contact_friction": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
