{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-geometry-kinematic-development-suite.v1.schema.json",
  "title": "Blueprint planar kinematic development suite",
  "type": "object",
  "required": ["schema_version", "corpus_id", "corpus_digest", "benchmark_spec_digest", "lane", "method_id", "solver_scope", "execution_requested", "status", "case_count", "minimum_repeated_trials", "all_cases_completed", "all_replays_deterministic", "continuous_collision_evaluated", "cases", "aggregate_metrics", "execution_bundle_digests", "development_only", "synthetic_fixture", "held_out", "captured_mesh_included", "captured_registration_included", "physical_measurements_included", "qualification_labels_included", "independent_execution", "r5_evidence", "r6_decision", "r7_admission", "production_route_eligible", "physical_success_established", "agent_may_promote", "suite_digest"],
  "properties": {
    "schema_version": {"const": "capture_to_geometry_kinematic_development_suite.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_digest": {"$ref": "#/$defs/digest"},
    "benchmark_spec_digest": {"$ref": "#/$defs/digest"},
    "lane": {"const": "planar_reach_discrete_collision"},
    "method_id": {"const": "exact-geometry-stack"},
    "solver_scope": {"const": "pinocchio-analytic-two-link-coal-discrete-gjk"},
    "execution_requested": {"type": "boolean"},
    "status": {"enum": ["planned_not_executed", "completed_development_only", "incomplete"]},
    "case_count": {"type": "integer", "minimum": 3},
    "minimum_repeated_trials": {"type": "integer", "minimum": 2},
    "all_cases_completed": {"type": "boolean"},
    "all_replays_deterministic": {"type": "boolean"},
    "continuous_collision_evaluated": {"const": false},
    "cases": {"type": "array", "minItems": 3},
    "aggregate_metrics": {"type": "object"},
    "execution_bundle_digests": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/digest"}},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "captured_mesh_included": {"const": false},
    "captured_registration_included": {"const": false},
    "physical_measurements_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "independent_execution": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "production_route_eligible": {"const": false},
    "physical_success_established": {"const": false},
    "agent_may_promote": {"const": false},
    "suite_digest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
