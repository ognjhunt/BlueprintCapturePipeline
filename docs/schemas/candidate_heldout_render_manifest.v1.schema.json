{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blueprint.ai/candidate_heldout_render_manifest.v1.schema.json",
  "title": "Blueprint Candidate Held-out Render Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_capture_digest", "frozen_split_digest",
    "reconstruction_training_result_digest", "appearance_asset_digest",
    "candidate_method_id", "candidate_provider_identity", "renderer_identity",
    "renderer_implementation_digest", "hidden_pixels_read_by_candidate",
    "heldout_labels_read_by_candidate", "candidate_selected_heldout",
    "candidate_self_grading", "frozen_camera_parameters_only", "renders",
    "candidate_heldout_render_manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "candidate_heldout_render_manifest.v1"},
    "source_capture_digest": {"$ref": "#/$defs/sha256"},
    "frozen_split_digest": {"$ref": "#/$defs/sha256"},
    "reconstruction_training_result_digest": {"$ref": "#/$defs/sha256"},
    "appearance_asset_digest": {"$ref": "#/$defs/sha256"},
    "candidate_method_id": {"type": "string", "minLength": 1},
    "candidate_provider_identity": {"type": "string", "minLength": 1},
    "renderer_identity": {"type": "string", "minLength": 1},
    "renderer_implementation_digest": {"$ref": "#/$defs/sha256"},
    "hidden_pixels_read_by_candidate": {"const": false},
    "heldout_labels_read_by_candidate": {"const": false},
    "candidate_selected_heldout": {"const": false},
    "candidate_self_grading": {"const": false},
    "frozen_camera_parameters_only": {"const": true},
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/render"}
    },
    "candidate_heldout_render_manifest_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id", "real_view_digest", "candidate_render_relative_path",
        "candidate_render_digest", "projection_form"
      ],
      "properties": {
        "view_id": {"type": "string", "minLength": 1},
        "real_view_digest": {"$ref": "#/$defs/sha256"},
        "candidate_render_relative_path": {"$ref": "#/$defs/relative_path"},
        "candidate_render_digest": {"$ref": "#/$defs/sha256"},
        "projection_form": {"type": "string", "minLength": 1}
      }
    }
  }
}
