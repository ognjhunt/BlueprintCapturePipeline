{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_worker_remote_build.v2.schema.json",
  "title": "Reconstruction Worker Remote Build Packet and Receipt v2",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "packet_kind", "generated_at", "status", "blockers", "tarball_path", "tarball_sha256", "archive_members", "archive_member_sha256", "archive_member_manifest_sha256", "context_manifest_sha256", "dockerfile_sha256", "requirements_lock_sha256", "worker_stack_manifest_digest", "license_inventory_digest", "license_review_receipt_digest", "paid_execution_envelope_digest", "paid_execution_envelope", "image_ref", "source_commit", "source_worktree_dirty", "provider_launch_performed_by_packet", "raw_secret_values_recorded", "canonical_allocator_entrypoint", "claim_boundary", "remote_build_packet_digest"],
      "properties": {
        "schema_version": {"const": "reconstruction_worker_remote_build_packet.v2"},
        "packet_kind": {"const": "reconstruction_worker_image"},
        "status": {"enum": ["ready", "blocked"]},
        "tarball_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "archive_member_manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "context_manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "dockerfile_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "requirements_lock_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "license_inventory_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "license_review_receipt_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "paid_execution_envelope_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "paid_execution_envelope": {"type": "object"},
        "source_commit": {"pattern": "^[0-9a-f]{40}$"},
        "source_worktree_dirty": {"type": "boolean"},
        "provider_launch_performed_by_packet": {"const": false},
        "raw_secret_values_recorded": {"const": false},
        "remote_build_packet_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["schema_version", "timestamp", "worker_stack_manifest_digest", "license_inventory_digest", "license_review_receipt_digest", "paid_execution_envelope_digest", "status", "resolved_image_digest", "source_commit_sha", "build_context_digest", "duration_seconds", "cost_usd", "logs", "blockers", "scientific_qualification_inferred", "build_healthcheck_embedded", "runtime_gpu_healthcheck_completed", "raw_secret_values_recorded", "proof_effect", "claim_ceiling", "build_receipt_digest"],
      "properties": {
        "schema_version": {"const": "reconstruction_worker_build_receipt.v2"},
        "status": {"const": "built"},
        "resolved_image_digest": {"pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"},
        "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
        "license_inventory_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "license_review_receipt_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "paid_execution_envelope_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "scientific_qualification_inferred": {"const": false},
        "build_healthcheck_embedded": {"const": true},
        "runtime_gpu_healthcheck_completed": {"const": false},
        "raw_secret_values_recorded": {"const": false},
        "proof_effect": {"const": "none"},
        "claim_ceiling": {"const": "resolved_worker_image_build_only"},
        "build_receipt_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    }
  ]
}
