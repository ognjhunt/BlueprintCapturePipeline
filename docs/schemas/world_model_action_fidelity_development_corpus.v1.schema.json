{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/world-model-action-fidelity-development-corpus.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "corpus_id", "description", "development_only", "synthetic_fixture", "held_out", "physical_outcomes_included", "policy_ranking_labels_included", "provider_execution_included", "r5_evidence", "r6_decision", "r7_admission", "shared_operating_point", "cases"],
  "properties": {
    "schema_version": {"const": "world_model_action_fidelity_development_corpus.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_outcomes_included": {"const": false},
    "policy_ranking_labels_included": {"const": false},
    "provider_execution_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {
      "type": "object",
      "required": ["adapter_protocol", "data_origin", "claim_scope", "historical_policy_ranking_verdict", "policy_ranking_labels_included", "physical_outcomes_included", "provider_execution_included", "action_dimension", "action_unit", "action_units", "control_hz", "maximum_abs_error", "calibration_id", "calibration_sha256", "scorer_runtime_id"],
      "properties": {
        "adapter_protocol": {"const": "world_model_action_fidelity.v1"},
        "data_origin": {"const": "synthetic_development_fixture"},
        "claim_scope": {"const": "evaluator_support_only"},
        "historical_policy_ranking_verdict": {"const": "thesis_not_supported"},
        "policy_ranking_labels_included": {"const": false},
        "physical_outcomes_included": {"const": false},
        "provider_execution_included": {"const": false},
        "action_dimension": {"type": "integer", "minimum": 1, "maximum": 64},
        "action_unit": {"type": "string", "minLength": 1},
        "action_units": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "control_hz": {"type": "number", "exclusiveMinimum": 0},
        "maximum_abs_error": {"type": "number", "minimum": 0},
        "calibration_id": {"type": "string", "minLength": 1},
        "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scorer_runtime_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cases": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": ["step_index", "sim_time_s", "commanded_action", "recovered_action", "per_dimension_uncertainty", "motion_identity", "forward_consistent", "inverse_consistent"],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0},
        "sim_time_s": {"type": "number", "minimum": 0},
        "commanded_action": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "recovered_action": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "per_dimension_uncertainty": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
        "motion_identity": {"type": "string", "minLength": 1},
        "forward_consistent": {"type": "boolean"},
        "inverse_consistent": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "action_steps"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "action_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      },
      "additionalProperties": false
    }
  }
}
