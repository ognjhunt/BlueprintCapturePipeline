{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blueprint.ai/reconstruction_frame_dataset.v1.schema.json",
  "title": "Blueprint Reconstruction Frame Dataset Contracts v1",
  "oneOf": [
    {"$ref": "#/$defs/dataset"},
    {"$ref": "#/$defs/selection"},
    {"$ref": "#/$defs/split"},
    {"$ref": "#/$defs/candidate"},
    {"$ref": "#/$defs/heldout"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "digest"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "supporting_artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "digest", "artifact_type"],
      "properties": {
        "relative_path": {"$ref": "#/$defs/relative_path"},
        "digest": {"$ref": "#/$defs/sha256"},
        "artifact_type": {
          "type": "string", "pattern": "^[a-z0-9_.-]+\\.v[0-9]+$"
        }
      }
    },
    "selected_frame": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "source_camera_identity": ["observation_group_id"],
        "observation_group_id": ["source_camera_identity"]
      },
      "required": [
        "frame_id", "decoded_frame_index", "t_video_sec", "source_pts_seconds",
        "source_dts_seconds", "duration_seconds", "key_frame",
        "artifact_relative_path", "digest", "image_metadata", "quality_signals"
      ],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "decoded_frame_index": {"type": "integer", "minimum": 0},
        "t_video_sec": {"type": "number", "minimum": 0},
        "source_pts_seconds": {"type": ["number", "null"]},
        "source_dts_seconds": {"type": ["number", "null"]},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "key_frame": {"type": "boolean"},
        "artifact_relative_path": {"$ref": "#/$defs/relative_path"},
        "digest": {"$ref": "#/$defs/sha256"},
        "image_metadata": {"type": "object"},
        "quality_signals": {"type": "object"},
        "source_camera_identity": {"type": "string", "minLength": 1},
        "observation_group_id": {"type": "string", "minLength": 1}
      }
    },
    "split_assignment": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "source_camera_identity": ["observation_group_id"],
        "observation_group_id": ["source_camera_identity"]
      },
      "required": ["frame_id", "decoded_frame_index", "t_video_sec", "frame_digest", "split"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "decoded_frame_index": {"type": "integer", "minimum": 0},
        "t_video_sec": {"type": "number", "minimum": 0},
        "frame_digest": {"$ref": "#/$defs/sha256"},
        "split": {"enum": ["training", "validation", "held_out"]},
        "source_camera_identity": {"type": "string", "minLength": 1},
        "observation_group_id": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "capture_digest", "source_video_digest", "decoded_frame_count",
        "selected_frame_count", "selection_rule", "complete_retained_source_preserved",
        "source_video_relative_path", "frames", "selection_digest"
      ],
      "properties": {
        "schema_version": {"const": "retained_frame_selection_manifest.v1"},
        "capture_digest": {"$ref": "#/$defs/sha256"},
        "source_video_digest": {"$ref": "#/$defs/sha256"},
        "decoded_frame_count": {"type": "integer", "minimum": 1},
        "selected_frame_count": {"type": "integer", "minimum": 1},
        "selection_rule": {
          "type": "string",
          "enum": [
            "evenly_spaced_actual_decoded_pts_with_endpoints_v1",
            "arkitscenes_exact_trajectory_timestamp_even_coverage_v1"
          ]
        },
        "complete_retained_source_preserved": {"const": true},
        "source_video_relative_path": {"$ref": "#/$defs/relative_path"},
        "source_video_references": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact_reference"}
        },
        "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selected_frame"}},
        "selection_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "frozen", "capture_digest", "deterministic_configuration_digest",
        "split_seed_digest", "assignments", "candidate_can_change_assignments",
        "hidden_heldout_access", "split_digest"
      ],
      "properties": {
        "schema_version": {"const": "frozen_reconstruction_split_manifest.v1"},
        "frozen": {"const": true},
        "capture_digest": {"$ref": "#/$defs/sha256"},
        "deterministic_configuration_digest": {"$ref": "#/$defs/sha256"},
        "split_seed_digest": {"$ref": "#/$defs/sha256"},
        "assignments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/split_assignment"}},
        "candidate_can_change_assignments": {"const": false},
        "hidden_heldout_access": {"const": "independent_evaluator_only"},
        "split_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_frame": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "source_camera_identity": ["observation_group_id"],
        "observation_group_id": ["source_camera_identity"]
      },
      "required": [
        "frame_id", "decoded_frame_index", "t_video_sec", "frame_digest", "split",
        "candidate_relative_path", "image_metadata", "quality_signals"
      ],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "decoded_frame_index": {"type": "integer", "minimum": 0},
        "t_video_sec": {"type": "number", "minimum": 0},
        "frame_digest": {"$ref": "#/$defs/sha256"},
        "split": {"enum": ["training", "validation"]},
        "candidate_relative_path": {"$ref": "#/$defs/relative_path"},
        "image_metadata": {"type": "object"},
        "quality_signals": {"type": "object"},
        "source_camera_identity": {"type": "string", "minLength": 1},
        "observation_group_id": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "capture_digest", "split_digest", "training_and_validation_only",
        "heldout_pixels_included", "frames", "candidate_dataset_digest"
      ],
      "properties": {
        "schema_version": {"const": "candidate_reconstruction_dataset_manifest.v1"},
        "capture_digest": {"$ref": "#/$defs/sha256"},
        "split_digest": {"$ref": "#/$defs/sha256"},
        "training_and_validation_only": {"const": true},
        "heldout_pixels_included": {"const": false},
        "frames": {"type": "array", "items": {"$ref": "#/$defs/candidate_frame"}},
        "candidate_dataset_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "heldout_frame": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "source_camera_identity": ["observation_group_id"],
        "observation_group_id": ["source_camera_identity"]
      },
      "required": ["frame_id", "decoded_frame_index", "t_video_sec", "frame_digest", "evaluator_relative_path"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "decoded_frame_index": {"type": "integer", "minimum": 0},
        "t_video_sec": {"type": "number", "minimum": 0},
        "frame_digest": {"$ref": "#/$defs/sha256"},
        "evaluator_relative_path": {"$ref": "#/$defs/relative_path"},
        "source_camera_identity": {"type": "string", "minLength": 1},
        "observation_group_id": {"type": "string", "minLength": 1}
      }
    },
    "heldout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "capture_digest", "split_digest", "access_scope",
        "candidate_method_access_allowed", "frames", "hidden_heldout_digest"
      ],
      "properties": {
        "schema_version": {"const": "hidden_heldout_evaluator_manifest.v1"},
        "capture_digest": {"$ref": "#/$defs/sha256"},
        "split_digest": {"$ref": "#/$defs/sha256"},
        "access_scope": {"const": "independent_evaluator_only"},
        "candidate_method_access_allowed": {"const": false},
        "frames": {"type": "array", "items": {"$ref": "#/$defs/heldout_frame"}},
        "hidden_heldout_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "stable_run_identity", "source_capture_identity",
        "source_capture_digest", "original_file_references", "producing_method",
        "implementation_version", "container_image_digest", "source_commit_sha",
        "deterministic_configuration", "deterministic_configuration_digest",
        "input_digests", "output_digests", "train_heldout_split_digest",
        "camera_calibration_binding", "coordinate_frame_declaration", "units",
        "metric_scale_status", "capture_authority_profile", "stream_metadata",
        "provider_runtime_identity", "cost_usd", "duration_seconds", "duration_accounting",
        "authority_used", "warnings", "blockers", "proof_effect", "claim_ceiling",
        "parent_artifact_or_event", "timestamp", "artifact_references",
        "candidate_dataset_contains_hidden_heldout_pixels", "candidate_can_modify_split",
        "raw_capture_bytes_remain_authoritative", "dataset_manifest_digest"
      ],
      "properties": {
        "schema_version": {"const": "reconstruction_dataset_manifest.v1"},
        "stable_run_identity": {"type": "string", "minLength": 1},
        "source_capture_identity": {"type": "string", "minLength": 1},
        "source_capture_digest": {"$ref": "#/$defs/sha256"},
        "original_file_references": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["relative_path", "digest"],
            "properties": {
              "relative_path": {"$ref": "#/$defs/relative_path"},
              "digest": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "producing_method": {
          "enum": [
            "deterministic_retained_frame_compiler.v1",
            "deterministic_retained_frame_compiler.v2"
          ]
        },
        "implementation_version": {"$ref": "#/$defs/sha256"},
        "container_image_digest": {"type": ["string", "null"]},
        "source_commit_sha": {"$ref": "#/$defs/commit"},
        "deterministic_configuration": {"type": "object"},
        "deterministic_configuration_digest": {"$ref": "#/$defs/sha256"},
        "input_digests": {"type": "object"},
        "output_digests": {"type": "object"},
        "train_heldout_split_digest": {"$ref": "#/$defs/sha256"},
        "camera_calibration_binding": {"type": ["object", "null"]},
        "coordinate_frame_declaration": {"type": "object"},
        "units": {"const": "source_pixels_and_seconds"},
        "metric_scale_status": {"const": "not_established"},
        "capture_authority_profile": {"type": "string", "minLength": 1},
        "stream_metadata": {"type": "object"},
        "provider_runtime_identity": {"type": "object"},
        "cost_usd": {"const": 0.0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "duration_accounting": {"type": "string", "minLength": 1},
        "authority_used": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "proof_effect": {"const": "decoded_observation_availability_only"},
        "claim_ceiling": {"const": "decoded_observation_availability"},
        "parent_artifact_or_event": {"type": "object"},
        "timestamp": {"type": "string", "minLength": 1},
        "artifact_references": {
          "type": "object", "additionalProperties": false,
          "required": [
            "retained_frame_selection_manifest", "frozen_split_manifest",
            "candidate_dataset_manifest", "hidden_heldout_evaluator_manifest"
          ],
          "properties": {
            "retained_frame_selection_manifest": {"$ref": "#/$defs/artifact_reference"},
            "frozen_split_manifest": {"$ref": "#/$defs/artifact_reference"},
            "candidate_dataset_manifest": {"$ref": "#/$defs/artifact_reference"},
            "hidden_heldout_evaluator_manifest": {"$ref": "#/$defs/artifact_reference"}
          }
        },
        "supporting_artifact_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/supporting_artifact_reference"}
        },
        "candidate_dataset_contains_hidden_heldout_pixels": {"const": false},
        "candidate_can_modify_split": {"const": false},
        "raw_capture_bytes_remain_authoritative": {"const": true},
        "dataset_manifest_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
