{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-deformation-granular-development-corpus.v1.schema.json",
  "title": "Blueprint Capture-to-Deformation granular development corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "description",
    "lane",
    "development_only",
    "synthetic_fixture",
    "held_out",
    "physical_measurements_included",
    "physical_material_characterization_included",
    "qualification_labels_included",
    "r5_evidence",
    "r6_decision",
    "r7_admission",
    "shared_operating_point",
    "metric_definitions",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "capture_to_deformation_granular_development_corpus.v1"
    },
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "granular"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "physical_material_characterization_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {"$ref": "#/$defs/shared"},
    "metric_definitions": {
      "type": "object",
      "required": ["state_trajectory", "topology_contact", "force", "task_outcome"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "shared": {
      "type": "object",
      "required": [
        "adapter_protocol",
        "length_unit",
        "mass_unit",
        "time_unit",
        "particle_shape",
        "particle_size_distribution",
        "cohesion_model",
        "material_characterization_scope",
        "restitution_characterization",
        "count_x",
        "count_y",
        "count_z",
        "spacing_factor",
        "layer_stagger_x_fraction",
        "layer_stagger_y_fraction",
        "initial_ground_clearance_m",
        "ground_height_m",
        "gravity_m_s2",
        "contact_time_constant_s",
        "contact_damping_ratio",
        "contact_solimp",
        "duration_s",
        "timestep_s",
        "settle_speed_threshold_m_s",
        "minimum_settled_fraction",
        "minimum_spread_ratio",
        "maximum_spread_ratio",
        "maximum_penetration_m",
        "maximum_normal_contact_force_n"
      ],
      "properties": {
        "adapter_protocol": {"const": "mujoco_spherical_particle_column_collapse.v1"},
        "length_unit": {"const": "meters"},
        "mass_unit": {"const": "kilograms"},
        "time_unit": {"const": "seconds"},
        "particle_shape": {"const": "sphere"},
        "particle_size_distribution": {"const": "monodisperse"},
        "cohesion_model": {"const": "none"},
        "material_characterization_scope": {"const": "synthetic_parameters_only"},
        "restitution_characterization": {"const": "not_measured_contact_damping_only"},
        "count_x": {"type": "integer", "minimum": 2, "maximum": 8},
        "count_y": {"type": "integer", "minimum": 2, "maximum": 8},
        "count_z": {"type": "integer", "minimum": 2, "maximum": 8},
        "spacing_factor": {"type": "number", "minimum": 2, "maximum": 3},
        "layer_stagger_x_fraction": {"type": "number", "minimum": 0, "maximum": 0.99},
        "layer_stagger_y_fraction": {"type": "number", "minimum": 0, "maximum": 0.99},
        "initial_ground_clearance_m": {"type": "number", "minimum": 0},
        "ground_height_m": {"type": "number"},
        "gravity_m_s2": {"$ref": "#/$defs/vector3"},
        "contact_time_constant_s": {"type": "number", "exclusiveMinimum": 0},
        "contact_damping_ratio": {"type": "number", "exclusiveMinimum": 0},
        "contact_solimp": {"$ref": "#/$defs/vector3"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "timestep_s": {"type": "number", "exclusiveMinimum": 0},
        "settle_speed_threshold_m_s": {"type": "number", "exclusiveMinimum": 0},
        "minimum_settled_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_spread_ratio": {"type": "number", "minimum": 1},
        "maximum_spread_ratio": {"type": "number", "minimum": 1},
        "maximum_penetration_m": {"type": "number", "minimum": 0},
        "maximum_normal_contact_force_n": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "synthetic_material_id",
        "particle_radius_m",
        "particle_density_kg_m3",
        "contact_friction",
        "free_joint_damping"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "synthetic_material_id": {"type": "string", "minLength": 1},
        "particle_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "particle_density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
        "contact_friction": {"$ref": "#/$defs/vector3"},
        "free_joint_damping": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
