{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-geometry-contact-articulation-development-corpus.v1.schema.json",
  "title": "Blueprint Capture-to-Geometry-and-Contact articulation development corpus",
  "type": "object",
  "required": ["schema_version", "corpus_id", "description", "lane", "development_only", "synthetic_fixture", "held_out", "physical_measurements_included", "instrumented_force_included", "qualification_labels_included", "r5_evidence", "r6_decision", "r7_admission", "shared_operating_point", "metric_definitions", "cases"],
  "properties": {
    "schema_version": {"const": "capture_to_geometry_contact_articulation_development_corpus.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "articulated_rigid_contact"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "instrumented_force_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {"$ref": "#/$defs/shared"},
    "metric_definitions": {"type": "object", "required": ["drawer_door_force_travel_error", "contact_sequence", "replay"], "additionalProperties": {"type": "string", "minLength": 1}},
    "cases": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "shared": {
      "type": "object",
      "required": ["adapter_protocol", "reference_origin", "physical_force_measurement", "position_unit", "effort_unit", "time_unit", "body_mass_kg", "duration_s", "timestep_s", "maximum_travel_error"],
      "properties": {
        "adapter_protocol": {"const": "mujoco_articulated_joint_travel.v1"},
        "reference_origin": {"const": "synthetic_public_target"},
        "physical_force_measurement": {"const": false},
        "position_unit": {"const": "joint_native_radian_or_meter"},
        "effort_unit": {"const": "joint_native_newton_meter_or_newton"},
        "time_unit": {"const": "seconds"},
        "body_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "timestep_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05},
        "maximum_travel_error": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["case_id", "articulation_type", "joint_limit", "joint_damping", "applied_effort", "target_joint_position"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "articulation_type": {"enum": ["door_hinge", "drawer_slide"]},
        "joint_limit": {"type": "number", "exclusiveMinimum": 0},
        "joint_damping": {"type": "number", "minimum": 0},
        "applied_effort": {"type": "number", "exclusiveMinimum": 0},
        "target_joint_position": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
