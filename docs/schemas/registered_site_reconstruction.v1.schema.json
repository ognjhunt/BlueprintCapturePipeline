{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/registered_site_reconstruction.v1.schema.json",
  "title": "Qualified appearance and dynamics-geometry reconstruction",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "missingMeasurement": {
      "type": "object",
      "required": ["code", "instruction", "stage"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "source_profile_digest",
    "source_capture_digest",
    "native_3dgs_candidate_digest",
    "appearance_format",
    "appearance_asset_digest",
    "full_resolution_appearance_preserved",
    "derived_site_geometry_digest",
    "geometry_asset_digest",
    "geometry_qualification_status",
    "scene_registration_digest",
    "registration_transform_digest",
    "residual_measurement_digest",
    "registration_qualification_digest",
    "registration_status",
    "source_scene_digest",
    "presentation_output_used_as_evaluation_evidence",
    "claim_boundary",
    "smallest_missing_measurement",
    "reconstruction_digest"
  ],
  "properties": {
    "schema_version": {"const": "registered_site_reconstruction.v1"},
    "status": {"enum": ["qualified", "abstained"]},
    "source_profile_digest": {"$ref": "#/$defs/digest"},
    "source_capture_digest": {"$ref": "#/$defs/digest"},
    "native_3dgs_candidate_digest": {"$ref": "#/$defs/nullableDigest"},
    "appearance_format": {"const": "native_3dgs"},
    "appearance_asset_digest": {"$ref": "#/$defs/nullableDigest"},
    "full_resolution_appearance_preserved": {"type": "boolean"},
    "derived_site_geometry_digest": {"$ref": "#/$defs/nullableDigest"},
    "geometry_asset_digest": {"$ref": "#/$defs/nullableDigest"},
    "geometry_qualification_status": {
      "enum": ["qualified", "unqualified", "missing"]
    },
    "scene_registration_digest": {"$ref": "#/$defs/nullableDigest"},
    "registration_transform_digest": {"$ref": "#/$defs/nullableDigest"},
    "residual_measurement_digest": {"$ref": "#/$defs/nullableDigest"},
    "registration_qualification_digest": {"$ref": "#/$defs/nullableDigest"},
    "registration_status": {"enum": ["qualified", "abstained"]},
    "source_scene_digest": {"$ref": "#/$defs/nullableDigest"},
    "presentation_output_used_as_evaluation_evidence": {"const": false},
    "claim_boundary": {
      "type": "object",
      "required": [
        "appearance_quality_is_metric_registration",
        "appearance_used_as_dynamics_authority",
        "collision_geometry_proven",
        "registration_proven",
        "physical_success_proven"
      ],
      "properties": {
        "appearance_quality_is_metric_registration": {"const": false},
        "appearance_used_as_dynamics_authority": {"const": false},
        "collision_geometry_proven": {"type": "boolean"},
        "registration_proven": {"type": "boolean"},
        "physical_success_proven": {"const": false}
      },
      "additionalProperties": false
    },
    "smallest_missing_measurement": {
      "oneOf": [{"$ref": "#/$defs/missingMeasurement"}, {"type": "null"}]
    },
    "reconstruction_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "qualified"}}},
      "then": {
        "properties": {
          "native_3dgs_candidate_digest": {"$ref": "#/$defs/digest"},
          "appearance_asset_digest": {"$ref": "#/$defs/digest"},
          "full_resolution_appearance_preserved": {"const": true},
          "derived_site_geometry_digest": {"$ref": "#/$defs/digest"},
          "geometry_asset_digest": {"$ref": "#/$defs/digest"},
          "geometry_qualification_status": {"const": "qualified"},
          "scene_registration_digest": {"$ref": "#/$defs/digest"},
          "registration_transform_digest": {"$ref": "#/$defs/digest"},
          "residual_measurement_digest": {"$ref": "#/$defs/digest"},
          "registration_qualification_digest": {"$ref": "#/$defs/digest"},
          "registration_status": {"const": "qualified"},
          "source_scene_digest": {"$ref": "#/$defs/digest"},
          "smallest_missing_measurement": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "registration_status": {"const": "abstained"},
          "smallest_missing_measurement": {"$ref": "#/$defs/missingMeasurement"}
        }
      }
    }
  ],
  "additionalProperties": false
}
