{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blueprint.ai/arkit_raw_contract_validation.v1.schema.json",
  "title": "Blueprint ARKit Raw Contract Validation v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "stable_run_identity", "source_capture_identity",
    "source_capture_digest", "capture_profile", "raw_contract_version",
    "original_file_references_and_digests", "producing_method",
    "implementation_version", "container_image_digest", "source_commit_sha",
    "deterministic_configuration_digest", "input_digests", "output_digests",
    "train_heldout_split_digest", "camera_calibration_binding",
    "coordinate_frame_declaration", "units", "metric_scale_status",
    "provider_runtime_identity", "cost_usd", "duration_seconds", "authority_used",
    "warnings", "blockers", "proof_effect", "claim_ceiling",
    "parent_artifact_or_event", "timestamp", "decoded_pts_verified",
    "retention_mapping_verified", "poses_intrinsics_bound",
    "depth_confidence_presence_bound", "raw_capture_remains_authoritative",
    "agent_changed_profile_or_evidence", "metric_scale_proven",
    "metric_geometry_proven", "collision_geometry_proven",
    "isaac_compatibility_proven", "physical_success_proven",
    "deployment_readiness_proven", "arkit_raw_contract_validation_digest"
  ],
  "properties": {
    "schema_version": {"const": "arkit_raw_contract_validation.v1"},
    "source_capture_digest": {"$ref": "#/$defs/sha256"},
    "capture_profile": {"const": "iphone_arkit_lidar"},
    "raw_contract_version": {"const": "3.2.0"},
    "implementation_version": {"$ref": "#/$defs/sha256"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deterministic_configuration_digest": {"$ref": "#/$defs/sha256"},
    "train_heldout_split_digest": {"$ref": "#/$defs/sha256"},
    "camera_calibration_binding": {"$ref": "#/$defs/sha256"},
    "units": {"const": "meters"},
    "metric_scale_status": {"const": "sensor_declared_not_independently_validated"},
    "proof_effect": {"const": "raw_contract_and_calibrated_trajectory_only"},
    "claim_ceiling": {"const": "calibrated_camera_trajectory"},
    "decoded_pts_verified": {"const": true},
    "retention_mapping_verified": {"const": true},
    "poses_intrinsics_bound": {"const": true},
    "depth_confidence_presence_bound": {"const": true},
    "raw_capture_remains_authoritative": {"const": true},
    "agent_changed_profile_or_evidence": {"const": false},
    "metric_scale_proven": {"const": false},
    "metric_geometry_proven": {"const": false},
    "collision_geometry_proven": {"const": false},
    "isaac_compatibility_proven": {"const": false},
    "physical_success_proven": {"const": false},
    "deployment_readiness_proven": {"const": false},
    "arkit_raw_contract_validation_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
