{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-deformation-cable-development-corpus.v1.schema.json",
  "title": "Blueprint Capture-to-Deformation cable development corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "description",
    "lane",
    "development_only",
    "synthetic_fixture",
    "held_out",
    "physical_measurements_included",
    "qualification_labels_included",
    "r5_evidence",
    "r6_decision",
    "r7_admission",
    "shared_operating_point",
    "metric_definitions",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "capture_to_deformation_cable_development_corpus.v1"
    },
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "cable"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {"$ref": "#/$defs/shared"},
    "metric_definitions": {
      "type": "object",
      "required": ["state_trajectory", "force", "task_outcome"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "shared": {
      "type": "object",
      "required": [
        "adapter_protocol",
        "length_unit",
        "mass_unit",
        "time_unit",
        "n_elements",
        "start_m",
        "direction",
        "normal",
        "gravity_m_s2",
        "duration_s",
        "timestep_s",
        "damping_constant",
        "maximum_segment_strain"
      ],
      "properties": {
        "adapter_protocol": {"const": "pyelastica_cantilever_cable.v1"},
        "length_unit": {"const": "meters"},
        "mass_unit": {"const": "kilograms"},
        "time_unit": {"const": "seconds"},
        "n_elements": {"type": "integer", "minimum": 6, "maximum": 128},
        "start_m": {"$ref": "#/$defs/vector3"},
        "direction": {"$ref": "#/$defs/vector3"},
        "normal": {"$ref": "#/$defs/vector3"},
        "gravity_m_s2": {"$ref": "#/$defs/vector3"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "timestep_s": {"type": "number", "exclusiveMinimum": 0},
        "damping_constant": {"type": "number", "minimum": 0},
        "maximum_segment_strain": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "base_length_m",
        "base_radius_m",
        "density_kg_m3",
        "youngs_modulus_pa",
        "maximum_tip_displacement_m"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "base_length_m": {"type": "number", "exclusiveMinimum": 0},
        "base_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
        "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "maximum_tip_displacement_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
