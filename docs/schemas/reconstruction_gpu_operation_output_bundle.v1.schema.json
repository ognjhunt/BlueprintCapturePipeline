{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_gpu_operation_output_bundle.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version", "status", "operation", "operation_request_schema",
    "operation_request_digest", "runtime_result_schema", "runtime_result_digest",
    "source_commit_sha", "worker_image_digest", "artifact_members",
    "artifact_member_count", "artifact_total_bytes", "runtime_result_archive_path",
    "heldout_labels_included", "candidate_self_graded",
    "scientific_qualification_inferred", "output_manifest_digest",
    "operation_output_bundle_digest", "operation_output_bundle_bytes", "cost_usd",
    "proof_effect", "claim_ceiling", "output_bundle_receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "reconstruction_gpu_operation_output_bundle.v1"},
    "status": {"const": "validated"},
    "operation": {"enum": ["pose_canary", "trainer_canary"]},
    "operation_request_schema": {
      "enum": ["pose_estimation_request.v1", "reconstruction_training_request.v1"]
    },
    "operation_request_digest": {"$ref": "#/$defs/digest"},
    "runtime_result_schema": {
      "enum": ["pose_estimation_result.v1", "reconstruction_training_result.v1"]
    },
    "runtime_result_digest": {"$ref": "#/$defs/digest"},
    "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
    "worker_image_digest": {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "artifact_members": {
      "type": "array",
      "maxItems": 50000,
      "items": {"$ref": "#/$defs/artifact_member"}
    },
    "artifact_member_count": {"type": "integer", "minimum": 0, "maximum": 50000},
    "artifact_total_bytes": {"type": "integer", "minimum": 0},
    "runtime_result_archive_path": {"const": "runtime_result.json"},
    "heldout_labels_included": {"const": false},
    "candidate_self_graded": {"const": false},
    "scientific_qualification_inferred": {"const": false},
    "output_manifest_digest": {"$ref": "#/$defs/digest"},
    "operation_output_bundle_digest": {"$ref": "#/$defs/digest"},
    "operation_output_bundle_bytes": {"type": "integer", "minimum": 1},
    "cost_usd": {"const": 0.0},
    "proof_effect": {"const": "none"},
    "claim_ceiling": {"const": "unaccepted_candidate_result_transport_only"},
    "output_bundle_receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_member": {
      "type": "object",
      "required": ["artifact_id", "archive_path", "digest", "bytes"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "archive_path": {
          "type": "string",
          "pattern": "^artifacts/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "digest": {"$ref": "#/$defs/digest"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "pose_canary"}}},
      "then": {
        "properties": {
          "operation_request_schema": {"const": "pose_estimation_request.v1"},
          "runtime_result_schema": {"const": "pose_estimation_result.v1"}
        }
      },
      "else": {
        "properties": {
          "operation_request_schema": {"const": "reconstruction_training_request.v1"},
          "runtime_result_schema": {"const": "reconstruction_training_result.v1"}
        }
      }
    }
  ],
  "additionalProperties": true
}
