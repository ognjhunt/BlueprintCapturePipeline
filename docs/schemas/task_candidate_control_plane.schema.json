{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/task-candidate-control-plane.v1.schema.json",
  "title": "Blueprint task discovery and customer-intent approval artifacts",
  "oneOf": [
    {"$ref": "#/$defs/discovery"},
    {"$ref": "#/$defs/decision"},
    {"$ref": "#/$defs/approvedTask"},
    {"$ref": "#/$defs/customerReceipt"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,191}$"},
    "actor": {
      "type": "object",
      "required": ["role", "identity"],
      "properties": {
        "role": {"enum": ["customer", "operator"]},
        "identity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sourceCapture": {
      "type": "object",
      "required": ["intake_id", "capture_digest", "capture_authority_profile"],
      "properties": {
        "intake_id": {"$ref": "#/$defs/identifier"},
        "capture_digest": {"$ref": "#/$defs/digest"},
        "capture_authority_profile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "groundedRow": {
      "type": "object",
      "required": ["description", "confidence", "supporting_frames", "supporting_3d_regions", "observation_status", "row_digest"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "supporting_frames": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supporting_3d_regions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "observation_status": {"enum": ["directly_observed", "inferred"]},
        "row_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": true
    },
    "successCondition": {
      "type": "object",
      "required": ["metric", "operator", "threshold", "units"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "proposalMethod": {
      "type": "object",
      "required": ["method_id", "version", "implementation_digest", "proposer_identity", "origin"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_digest": {"$ref": "#/$defs/digest"},
        "proposer_identity": {"type": "string", "minLength": 1},
        "origin": {"enum": ["local_rule", "model", "provider", "model_provider"]}
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": [
        "task_candidate_id",
        "candidate_digest",
        "description",
        "observed_objects",
        "target_regions",
        "required_robot_capabilities",
        "likely_task_family",
        "proposed_measurable_success_condition",
        "required_site_reset",
        "supporting_frames",
        "supporting_3d_regions",
        "confidence",
        "coverage",
        "assumptions",
        "missing_evidence",
        "prohibited_claims",
        "estimated_evaluation_cost_usd",
        "expected_customer_value",
        "proposal_method",
        "approval_status"
      ],
      "properties": {
        "task_candidate_id": {"$ref": "#/$defs/identifier"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "description": {"type": "string", "minLength": 1},
        "observed_objects": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "target_regions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "required_robot_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "likely_task_family": {"type": "string", "minLength": 1},
        "proposed_measurable_success_condition": {"$ref": "#/$defs/successCondition"},
        "required_site_reset": {"type": "string", "minLength": 1},
        "supporting_frames": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supporting_3d_regions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"type": "object", "minProperties": 1},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "estimated_evaluation_cost_usd": {"type": "number", "minimum": 0},
        "proposal_method": {"$ref": "#/$defs/proposalMethod"},
        "approval_status": {"const": "approval_required"}
      },
      "additionalProperties": true
    },
    "sceneAnalysis": {
      "type": "object",
      "required": ["observed_site_facts", "inferred_objects_and_affordances", "unsupported_or_occluded_regions", "hazards", "privacy_sensitive_areas"],
      "properties": {
        "observed_site_facts": {"type": "array", "items": {"$ref": "#/$defs/groundedRow"}},
        "inferred_objects_and_affordances": {"type": "array", "items": {"$ref": "#/$defs/groundedRow"}},
        "unsupported_or_occluded_regions": {"type": "array", "items": {"$ref": "#/$defs/groundedRow"}},
        "hazards": {"type": "array", "items": {"$ref": "#/$defs/groundedRow"}},
        "privacy_sensitive_areas": {"type": "array", "items": {"$ref": "#/$defs/groundedRow"}}
      },
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "required": ["schema_version", "discovery_id", "source_capture", "capture_qa_report_digest", "scene_analysis", "proposal_method", "task_candidates", "approval_state", "claim_boundaries", "discovery_digest"],
      "properties": {
        "schema_version": {"const": "task_candidate_discovery.v1"},
        "discovery_id": {"$ref": "#/$defs/identifier"},
        "source_capture": {"$ref": "#/$defs/sourceCapture"},
        "capture_qa_report_digest": {"$ref": "#/$defs/digest"},
        "scene_analysis": {"$ref": "#/$defs/sceneAnalysis"},
        "proposal_method": {"$ref": "#/$defs/proposalMethod"},
        "task_candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "approval_state": {"enum": ["task_approval_required", "no_candidates"]},
        "claim_boundaries": {
          "type": "object",
          "required": ["candidate_is_customer_intent", "candidate_is_task_success_evidence", "generated_or_inferred_content_upgrades_capture_authority"],
          "properties": {
            "candidate_is_customer_intent": {"const": false},
            "candidate_is_task_success_evidence": {"const": false},
            "generated_or_inferred_content_upgrades_capture_authority": {"const": false}
          },
          "additionalProperties": false
        },
        "discovery_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["schema_version", "discovery_id", "discovery_digest", "task_candidate_id", "candidate_digest", "action", "actor", "idempotency_key", "rationale", "edited_task", "decision_id", "decision_digest"],
      "properties": {
        "schema_version": {"const": "task_candidate_decision.v1"},
        "discovery_id": {"$ref": "#/$defs/identifier"},
        "discovery_digest": {"$ref": "#/$defs/digest"},
        "task_candidate_id": {"$ref": "#/$defs/identifier"},
        "candidate_digest": {"$ref": "#/$defs/digest"},
        "action": {"enum": ["approve", "edit_and_approve", "reject", "request_more_capture"]},
        "actor": {"$ref": "#/$defs/actor"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "edited_task": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "decision_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "taskBody": {
      "type": "object",
      "required": ["description", "task_family", "measurable_success_conditions", "reset_contract"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "task_family": {"type": "string", "minLength": 1},
        "measurable_success_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/successCondition"}},
        "reset_contract": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": true
    },
    "approvedTask": {
      "type": "object",
      "required": ["schema_version", "approved_task_id", "source_capture", "discovery_id", "discovery_digest", "task_candidate_id", "candidate_digest", "approval_decision_id", "approval_decision_digest", "approval_actor", "intent_source", "task", "proposer_identity", "prohibited_evaluator_identities", "approval_status", "approved_task_digest"],
      "properties": {
        "schema_version": {"const": "approved_task_definition.v1"},
        "approved_task_id": {"$ref": "#/$defs/identifier"},
        "source_capture": {"$ref": "#/$defs/sourceCapture"},
        "discovery_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "discovery_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "task_candidate_id": {"oneOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "candidate_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "approval_decision_id": {"$ref": "#/$defs/identifier"},
        "approval_decision_digest": {"$ref": "#/$defs/digest"},
        "approval_actor": {"$ref": "#/$defs/actor"},
        "intent_source": {"enum": ["customer_supplied", "customer_approved_candidate", "customer_edited_candidate"]},
        "task": {"$ref": "#/$defs/taskBody"},
        "proposer_identity": {"type": "string", "minLength": 1},
        "prohibited_evaluator_identities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "approval_status": {"const": "approved"},
        "approved_task_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "customerReceipt": {
      "type": "object",
      "required": ["schema_version", "source_capture", "task", "actor", "idempotency_key", "receipt_id", "receipt_digest"],
      "properties": {
        "schema_version": {"const": "customer_supplied_task_receipt.v1"},
        "source_capture": {"$ref": "#/$defs/sourceCapture"},
        "task": {"$ref": "#/$defs/taskBody"},
        "actor": {"$ref": "#/$defs/actor"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "receipt_id": {"$ref": "#/$defs/identifier"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
