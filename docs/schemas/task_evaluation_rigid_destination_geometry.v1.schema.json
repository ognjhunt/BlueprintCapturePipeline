{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_rigid_destination_geometry.v1.schema.json",
  "title": "Task Evaluation rigid destination geometry v1",
  "description": "Qualified, task-authored world-space scoring and contact geometry for one fixed passive SimReady destination asset.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "subject_identity",
    "destination_identity",
    "relation",
    "pose_world",
    "subject_static_qualification_digest",
    "destination_static_qualification_digest",
    "subject_collision_bounds_scoring_frame_m",
    "destination_interior_bounds_body_frame_m",
    "destination_position_bounds_destination_frame_m",
    "subject_orientation_destination_frame_xyzw",
    "support_height_interval_m",
    "intended_support_prim_paths",
    "insertion_withdrawal_unit_destination_frame",
    "whole_subject_containment_encoded_by_shrunk_bounds",
    "geometry_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task_evaluation_rigid_destination_geometry.v1"},
    "status": {"const": "qualified"},
    "subject_identity": {"$ref": "#/$defs/versionedIdentity"},
    "destination_identity": {"$ref": "#/$defs/versionedIdentity"},
    "relation": {"enum": ["inside", "on"]},
    "pose_world": {"$ref": "#/$defs/pose"},
    "subject_static_qualification_digest": {"$ref": "#/$defs/digest"},
    "destination_static_qualification_digest": {"$ref": "#/$defs/digest"},
    "subject_collision_bounds_scoring_frame_m": {"$ref": "#/$defs/bounds"},
    "destination_interior_bounds_body_frame_m": {"$ref": "#/$defs/bounds"},
    "destination_position_bounds_destination_frame_m": {"$ref": "#/$defs/bounds"},
    "subject_orientation_destination_frame_xyzw": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "support_height_interval_m": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "intended_support_prim_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/[^\\s]+$"}
    },
    "insertion_withdrawal_unit_destination_frame": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "whole_subject_containment_encoded_by_shrunk_bounds": {"const": true},
    "geometry_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "versionedIdentity": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/identifier"}
      }
    },
    "pose": {
      "type": "object",
      "required": ["position_world_m", "orientation_xyzw"],
      "additionalProperties": false,
      "properties": {
        "position_world_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "orientation_xyzw": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        }
      }
    },
    "bounds": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "maximum": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        }
      }
    }
  }
}
