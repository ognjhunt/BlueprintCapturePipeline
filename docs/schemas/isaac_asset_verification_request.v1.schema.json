{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/isaac_asset_verification_request.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "stable_run_identity",
    "source_capture_identity",
    "source_capture_digest",
    "original_file_references",
    "producing_method",
    "implementation_version",
    "source_commit_sha",
    "deterministic_configuration_digest",
    "input_digests",
    "output_digests",
    "train_heldout_split_digest",
    "camera_calibration_binding",
    "coordinate_frame_declaration",
    "units",
    "provider_runtime_identity",
    "cost_usd",
    "duration_seconds",
    "authority_used",
    "warnings",
    "blockers",
    "parent_artifact_or_event",
    "timestamp",
    "packaging_result",
    "packaging_result_digest",
    "package_artifact_reference",
    "package_digest",
    "fixed_camera_spec_digest",
    "fixed_camera_ids",
    "runtime_container_image_digest",
    "runtime_implementation_digest",
    "expected_prim_paths",
    "physics_probe_request",
    "headless",
    "display_attached",
    "timeout_seconds",
    "resource_request",
    "proof_effect",
    "claim_ceiling",
    "isaac_verification_request_digest"
  ],
  "properties": {
    "schema_version": {"const": "isaac_asset_verification_request.v1"},
    "stable_run_identity": {"type": "string", "minLength": 1},
    "source_capture_identity": {"type": "string", "minLength": 1},
    "source_capture_digest": {"$ref": "#/$defs/digest"},
    "original_file_references": {"type": "array"},
    "producing_method": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deterministic_configuration_digest": {"$ref": "#/$defs/digest"},
    "input_digests": {"type": "array", "minItems": 4},
    "output_digests": {"const": []},
    "train_heldout_split_digest": {"$ref": "#/$defs/digest"},
    "camera_calibration_binding": {"type": "object"},
    "coordinate_frame_declaration": {"type": "object"},
    "units": {"const": "meters"},
    "provider_runtime_identity": {"type": "object"},
    "cost_usd": {"type": "number", "minimum": 0},
    "duration_seconds": {"type": "number", "minimum": 0},
    "authority_used": {"type": "object"},
    "warnings": {"type": "array"},
    "blockers": {"type": "array"},
    "parent_artifact_or_event": {"type": "object"},
    "timestamp": {"type": "string", "minLength": 1},
    "packaging_result": {"type": "object"},
    "packaging_result_digest": {"$ref": "#/$defs/digest"},
    "package_artifact_reference": {"type": "string", "pattern": "^[^/].*\\.usdz$"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "fixed_camera_spec_digest": {"$ref": "#/$defs/digest"},
    "fixed_camera_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      }
    },
    "runtime_container_image_digest": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "runtime_implementation_digest": {"$ref": "#/$defs/digest"},
    "expected_prim_paths": {
      "const": {
        "appearance": "/World/BlueprintReconstruction/Appearance",
        "collision": "/World/BlueprintReconstruction/Collision"
      }
    },
    "physics_probe_request": {
      "type": "object",
      "required": [
        "steps",
        "manufacture_ground_plane",
        "require_contact_event",
        "test_body",
        "gravity_m_s2",
        "physics_dt_seconds"
      ],
      "properties": {
        "steps": {"type": "integer", "minimum": 2},
        "manufacture_ground_plane": {"const": false},
        "require_contact_event": {"const": true},
        "test_body": {
          "const": {
            "shape": "cube",
            "size_m": 0.1,
            "mass_kg": 1.0,
            "spawn_height_above_ground_m": 0.5
          }
        },
        "gravity_m_s2": {"const": -9.81},
        "physics_dt_seconds": {"const": 0.016666666666666666}
      }
    },
    "headless": {"const": true},
    "display_attached": {"const": false},
    "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 14400},
    "resource_request": {
      "type": "object",
      "required": ["gpu_count", "minimum_vram_gb"],
      "properties": {
        "gpu_count": {"const": 1},
        "minimum_vram_gb": {"type": "integer", "minimum": 16}
      }
    },
    "proof_effect": {"const": "none"},
    "claim_ceiling": {"const": "request_only"},
    "isaac_verification_request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
