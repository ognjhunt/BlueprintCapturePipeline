{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/capture-to-deformation-cloth-development-corpus.v1.schema.json",
  "title": "Blueprint Capture-to-Deformation cloth development corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "description",
    "lane",
    "development_only",
    "synthetic_fixture",
    "held_out",
    "physical_measurements_included",
    "qualification_labels_included",
    "r5_evidence",
    "r6_decision",
    "r7_admission",
    "shared_operating_point",
    "metric_definitions",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "capture_to_deformation_cloth_development_corpus.v1"
    },
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "cloth"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {"$ref": "#/$defs/shared"},
    "metric_definitions": {
      "type": "object",
      "required": ["state_trajectory", "topology_contact", "force", "task_outcome"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "items": false
    },
    "shared": {
      "type": "object",
      "required": [
        "adapter_protocol",
        "length_unit",
        "mass_unit",
        "time_unit",
        "pin_pattern",
        "elastic_formulation",
        "self_collision",
        "count_x",
        "count_y",
        "spacing_m",
        "ground_height_m",
        "total_mass_kg",
        "collision_radius_m",
        "poisson_ratio",
        "thickness_m",
        "edge_damping",
        "gravity_m_s2",
        "contact_friction",
        "duration_s",
        "timestep_s",
        "maximum_edge_strain",
        "maximum_penetration_m"
      ],
      "properties": {
        "adapter_protocol": {"const": "mujoco_flex_cloth_sag.v1"},
        "length_unit": {"const": "meters"},
        "mass_unit": {"const": "kilograms"},
        "time_unit": {"const": "seconds"},
        "pin_pattern": {"const": "four_corners"},
        "elastic_formulation": {"const": "stretch_only"},
        "self_collision": {"const": "none"},
        "count_x": {"type": "integer", "minimum": 4, "maximum": 32},
        "count_y": {"type": "integer", "minimum": 4, "maximum": 32},
        "spacing_m": {"type": "number", "exclusiveMinimum": 0},
        "ground_height_m": {"type": "number"},
        "total_mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "collision_radius_m": {"type": "number", "minimum": 0},
        "poisson_ratio": {"type": "number", "minimum": 0, "maximum": 0.49},
        "thickness_m": {"type": "number", "exclusiveMinimum": 0},
        "edge_damping": {"type": "number", "minimum": 0},
        "gravity_m_s2": {"$ref": "#/$defs/vector3"},
        "contact_friction": {"$ref": "#/$defs/vector3"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "timestep_s": {"type": "number", "exclusiveMinimum": 0},
        "maximum_edge_strain": {"type": "number", "minimum": 0},
        "maximum_penetration_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "initial_height_m",
        "youngs_modulus_pa",
        "maximum_sag_m"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "initial_height_m": {"type": "number", "exclusiveMinimum": 0},
        "youngs_modulus_pa": {"type": "number", "exclusiveMinimum": 0},
        "maximum_sag_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
