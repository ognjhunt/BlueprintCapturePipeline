{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_training_request.v1.schema.json",
  "title": "Reconstruction Training Request v1",
  "type": "object",
  "required": ["schema_version", "stable_run_identity", "source_capture_digest", "container_image_digest", "source_commit_sha", "reconstruction_dataset_digest", "train_heldout_split_digest", "calibration_digest", "initialization_geometry_digest", "pose_result_digest", "worker_stack_manifest_digest", "method_profile_id", "camera_model", "densification_configuration", "random_seed", "iteration_budget", "resource_request", "timeout_seconds", "spend_cap_usd", "output_contract", "evaluation_contract_digest", "candidate_dataset_contains_hidden_heldout_pixels", "candidate_can_change_split", "candidate_may_read_hidden_heldout", "trainer_may_grade_heldout", "reconstruction_training_request_digest"],
  "properties": {
    "schema_version": {"const": "reconstruction_training_request.v1"},
    "candidate_dataset_contains_hidden_heldout_pixels": {"const": false},
    "candidate_can_change_split": {"const": false},
    "candidate_may_read_hidden_heldout": {"const": false},
    "trainer_may_grade_heldout": {"const": false},
    "iteration_budget": {"type": "integer", "minimum": 1},
    "reconstruction_training_request_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
