{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_policy_canary_setup.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "source_launch_id", "offering_digest", "scene_revision_digest", "run_kind", "claim_ceiling", "registry_digest", "robot_presets", "episode_presets", "diagnostics", "task_success_contract", "task_success_contract_digest", "setup_digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task_evaluation_policy_canary_setup.v1"},
    "source_launch_id": {"$ref": "#/$defs/id"},
    "offering_digest": {"$ref": "#/$defs/digest"},
    "scene_revision_digest": {"$ref": "#/$defs/digest"},
    "run_kind": {"const": "internal_policy_canary"},
    "claim_ceiling": {"const": "diagnostic_policy_execution"},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "robot_presets": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/robot"}},
    "episode_presets": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/preset"}},
    "diagnostics": {"type": "object", "required": ["zero_action", "deterministic_scripted_positive"], "additionalProperties": false, "properties": {"zero_action": {"enum": ["nonblocking", "not_configured"]}, "deterministic_scripted_positive": {"enum": ["nonblocking", "not_configured"]}}},
    "task_success_contract": {"$ref": "#/$defs/taskSuccessContract"},
    "task_success_contract_digest": {"$ref": "#/$defs/digest"},
    "setup_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "object", "required": ["uri", "digest"], "additionalProperties": false, "properties": {"uri": {"type": "string", "minLength": 1, "maxLength": 2048}, "digest": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "readiness": {"type": "object", "required": ["status", "receipt", "reason"], "additionalProperties": false, "properties": {"status": {"enum": ["verified_runnable", "unavailable"]}, "receipt": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "reason": {"type": ["string", "null"], "maxLength": 512}}},
    "compatibility": {"type": "object", "required": ["robot_preset_ids", "embodiment_ids", "observation_schema_ids", "action_schema_ids", "simulator_runtime_ids", "task_family_ids"], "additionalProperties": false, "properties": {"robot_preset_ids": {"$ref": "#/$defs/ids"}, "embodiment_ids": {"$ref": "#/$defs/ids"}, "observation_schema_ids": {"$ref": "#/$defs/ids"}, "action_schema_ids": {"$ref": "#/$defs/ids"}, "simulator_runtime_ids": {"$ref": "#/$defs/ids"}, "task_family_ids": {"$ref": "#/$defs/ids"}}},
    "candidate": {"type": "object", "required": ["candidate_id", "display_name", "checkpoint", "adapter_id", "license_id", "compatibility", "readiness"], "additionalProperties": false, "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 128}, "checkpoint": {"$ref": "#/$defs/ref"}, "adapter_id": {"$ref": "#/$defs/id"}, "license_id": {"$ref": "#/$defs/id"}, "compatibility": {"$ref": "#/$defs/compatibility"}, "readiness": {"$ref": "#/$defs/readiness"}}},
    "robot": {"type": "object", "required": ["robot_preset_id", "display_name", "embodiment_id", "task_family_id", "simulator_runtime_id", "runtime_image", "observation_schema", "action_schema", "readiness", "policy_candidates"], "additionalProperties": false, "properties": {"robot_preset_id": {"$ref": "#/$defs/id"}, "display_name": {"type": "string", "minLength": 1, "maxLength": 128}, "embodiment_id": {"$ref": "#/$defs/id"}, "task_family_id": {"$ref": "#/$defs/id"}, "simulator_runtime_id": {"$ref": "#/$defs/id"}, "runtime_image": {"$ref": "#/$defs/ref"}, "observation_schema": {"type": "object", "required": ["schema_id", "cameras", "modalities"], "additionalProperties": false, "properties": {"schema_id": {"$ref": "#/$defs/id"}, "cameras": {"$ref": "#/$defs/ids"}, "modalities": {"$ref": "#/$defs/ids"}}}, "action_schema": {"type": "object", "required": ["schema_id", "space", "control_hz"], "additionalProperties": false, "properties": {"schema_id": {"$ref": "#/$defs/id"}, "space": {"type": "string", "minLength": 1, "maxLength": 128}, "control_hz": {"type": "number", "exclusiveMinimum": 0}}}, "readiness": {"$ref": "#/$defs/readiness"}, "policy_candidates": {"type": "array", "minItems": 2, "maxItems": 50, "items": {"$ref": "#/$defs/candidate"}}}},
    "familyCounts": {"type": "object", "required": ["canonical_anchor", "placement_approach", "illumination", "camera_sensor", "bounded_physics", "admitted_object_material_cousin", "pairwise_stress", "held_out_composition"], "additionalProperties": false, "properties": {"canonical_anchor": {"type": "integer", "minimum": 0}, "placement_approach": {"type": "integer", "minimum": 0}, "illumination": {"type": "integer", "minimum": 0}, "camera_sensor": {"type": "integer", "minimum": 0}, "bounded_physics": {"type": "integer", "minimum": 0}, "admitted_object_material_cousin": {"type": "integer", "minimum": 0}, "pairwise_stress": {"type": "integer", "minimum": 0}, "held_out_composition": {"type": "integer", "minimum": 0}}},
    "cell": {"type": "object", "required": ["cell_id", "family", "seed", "partition", "label", "cell_digest"], "additionalProperties": false, "properties": {"cell_id": {"$ref": "#/$defs/id"}, "family": {"enum": ["canonical_anchor", "placement_approach", "illumination", "camera_sensor", "bounded_physics", "admitted_object_material_cousin", "pairwise_stress", "held_out_composition"]}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "partition": {"enum": ["canonical", "stress", "held_out"]}, "label": {"type": "string", "minLength": 1, "maxLength": 256}, "cell_digest": {"$ref": "#/$defs/digest"}}},
    "gap": {"type": "object", "required": ["family", "code", "explanation", "deterministic_fallback_family"], "additionalProperties": false, "properties": {"family": {"type": "string", "minLength": 1, "maxLength": 128}, "code": {"$ref": "#/$defs/id"}, "explanation": {"type": "string", "minLength": 1, "maxLength": 512}, "deterministic_fallback_family": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "estimate": {"type": "object", "required": ["duration_minutes", "maximum_authorized_cost_usd", "hard_ttl_seconds", "basis_digest", "as_of"], "additionalProperties": false, "properties": {"duration_minutes": {"type": "object", "required": ["minimum", "maximum"], "additionalProperties": false, "properties": {"minimum": {"type": "number", "minimum": 0}, "maximum": {"type": "number", "minimum": 0}}}, "maximum_authorized_cost_usd": {"type": "number", "exclusiveMinimum": 0}, "hard_ttl_seconds": {"type": "integer", "minimum": 1}, "basis_digest": {"$ref": "#/$defs/digest"}, "as_of": {"type": "string", "format": "date-time"}}},
    "preset": {"type": "object", "required": ["preset_id", "label", "episodes_per_policy", "availability", "recommended", "matrix", "estimate"], "additionalProperties": false, "properties": {"preset_id": {"enum": ["quick_10", "standard_100", "deep_500"]}, "label": {"enum": ["Quick", "Standard", "Deep"]}, "episodes_per_policy": {"enum": [10, 100, 500]}, "availability": {"enum": ["enabled", "coming_later"]}, "recommended": {"type": "boolean"}, "matrix": {"type": "object", "required": ["matrix_digest", "resolver_id", "resolver_version", "deterministic", "cells", "expected_family_counts", "coverage_gaps"], "additionalProperties": false, "properties": {"matrix_digest": {"$ref": "#/$defs/digest"}, "resolver_id": {"$ref": "#/$defs/id"}, "resolver_version": {"$ref": "#/$defs/id"}, "deterministic": {"const": true}, "cells": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/cell"}}, "expected_family_counts": {"$ref": "#/$defs/familyCounts"}, "coverage_gaps": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/gap"}}}}, "estimate": {"$ref": "#/$defs/estimate"}}},
    "taskSuccessContract": {"$ref": "rigid_task_success_contract.v1.schema.json"}
  }
}
