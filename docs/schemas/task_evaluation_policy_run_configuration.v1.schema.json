{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_policy_run_configuration.v1.schema.json",
  "title": "Task Evaluation policy-run compiled configuration v1",
  "type": "object",
  "required": ["schema_version", "run_id", "source_launch_id", "offering_digest", "setup_digest", "embodiment_id", "candidate_ids", "preset_id", "scenario_count_per_policy", "compiler", "matrix", "counts", "execution_guards", "evidence_requirements", "configuration_digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task_evaluation_policy_run_configuration.v1"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_launch_id": {"$ref": "#/$defs/identifier"},
    "offering_digest": {"$ref": "#/$defs/digest"},
    "setup_digest": {"$ref": "#/$defs/digest"},
    "embodiment_id": {"const": "franka_panda_robotiq_2f85_v1"},
    "candidate_ids": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"const": "pi05_droid"}, {"const": "groot_n17_droid"}], "items": false},
    "preset_id": {"enum": ["quick_10", "standard_100", "deep_500"]},
    "scenario_count_per_policy": {"enum": [10, 100, 500]},
    "compiler": {"type": "object", "required": ["compiler_id", "compiler_version", "selection_rule", "outcome_independent", "agent_may_select_cells"], "additionalProperties": false, "properties": {"compiler_id": {"const": "franka_rigid_relocation_nested_prefix"}, "compiler_version": {"const": "v1"}, "selection_rule": {"const": "published_ordered_prefix"}, "outcome_independent": {"const": true}, "agent_may_select_cells": {"const": false}}},
    "matrix": {
      "type": "object",
      "required": ["profile_id", "preregistration_digest", "scenario_set_digest", "cells"],
      "additionalProperties": false,
      "properties": {
        "profile_id": {"const": "franka_rigid_relocation_nested_v1"},
        "preregistration_digest": {"$ref": "#/$defs/digest"},
        "scenario_set_digest": {"$ref": "#/$defs/digest"},
        "cells": {"type": "array", "minItems": 10, "maxItems": 500, "items": {"type": "object", "required": ["cell_id", "family", "partition", "scored", "cell_spec_digest", "seed"], "additionalProperties": false, "properties": {"cell_id": {"$ref": "#/$defs/identifier"}, "family": {"enum": ["canonical_anchor", "placement_approach", "illumination", "camera_sensor", "bounded_physics", "pairwise", "held_out"]}, "partition": {"enum": ["qualification", "held_out"]}, "scored": {"const": true}, "cell_spec_digest": {"$ref": "#/$defs/digest"}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}}}}
      }
    },
    "counts": {"type": "object", "required": ["learned_episode_count", "control_episode_count", "total_episode_count"], "additionalProperties": false, "properties": {"learned_episode_count": {"type": "integer", "minimum": 20, "maximum": 1000}, "control_episode_count": {"type": "integer", "minimum": 20, "maximum": 1000}, "total_episode_count": {"type": "integer", "minimum": 40, "maximum": 2000}}},
    "execution_guards": {"type": "object", "required": ["candidate_cells_and_seeds_must_match", "policy_specific_scenario_changes_prohibited", "zero_action_negative_every_scored_cell", "deterministic_scripted_positive_every_scored_cell", "retry_cap"], "additionalProperties": false, "properties": {"candidate_cells_and_seeds_must_match": {"const": true}, "policy_specific_scenario_changes_prohibited": {"const": true}, "zero_action_negative_every_scored_cell": {"const": true}, "deterministic_scripted_positive_every_scored_cell": {"const": true}, "retry_cap": {"const": 0}}},
    "evidence_requirements": {"type": "object", "required": ["lossless_policy_input_frames_required", "digest_bound_frame_manifest_required", "derived_review_video_required", "typed_media_gap_before_first_observation_required", "grader_authority", "policy_self_grading_forbidden"], "additionalProperties": false, "properties": {"lossless_policy_input_frames_required": {"const": true}, "digest_bound_frame_manifest_required": {"const": true}, "derived_review_video_required": {"const": true}, "typed_media_gap_before_first_observation_required": {"const": true}, "grader_authority": {"const": "deterministic_simulator_state"}, "policy_self_grading_forbidden": {"const": true}}},
    "configuration_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
