{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_policy_run_configuration.v1.schema.json",
  "title": "Task Evaluation policy-run compiled configuration v1",
  "type": "object",
  "required": ["schema_version", "run_id", "source_launch_id", "offering_digest", "setup_digest", "embodiment_id", "candidate_ids", "preset_id", "scenario_count_per_policy", "compiler", "matrix", "counts", "execution_guards", "evidence_requirements", "configuration_digest"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task_evaluation_policy_run_configuration.v1"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "source_launch_id": {"$ref": "#/$defs/identifier"},
    "offering_digest": {"$ref": "#/$defs/digest"},
    "setup_digest": {"$ref": "#/$defs/digest"},
    "run_kind": {"enum": ["qualified_evaluation", "internal_policy_canary"]},
    "claim_ceiling": {"const": "diagnostic_policy_execution"},
    "scene_revision_digest": {"$ref": "#/$defs/digest"},
    "scene_controls_status_at_submission": {"const": "configured_controls_pending"},
    "robot_preset_id": {"$ref": "#/$defs/identifier"},
    "policy_candidate_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "notification": {"type": "object", "required": ["email", "notify_on"], "additionalProperties": false, "properties": {"email": {"type": "string", "format": "email", "maxLength": 254}, "notify_on": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"const": "completed"}, {"const": "blocked"}, {"const": "cancelled"}], "items": false}}},
    "website_request_digest": {"$ref": "#/$defs/digest"},
    "task_success_contract": {"$ref": "#/$defs/taskSuccessContract"},
    "task_success_contract_digest": {"$ref": "#/$defs/digest"},
    "unqualified_warning": {"const": "Controls pending — results are unqualified."},
    "embodiment_id": {"$ref": "#/$defs/identifier"},
    "candidate_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "preset_id": {"enum": ["quick_10", "standard_100", "deep_500"]},
    "scenario_count_per_policy": {"enum": [10, 100, 500]},
    "compiler": {"type": "object", "required": ["compiler_id", "compiler_version", "selection_rule", "outcome_independent", "agent_may_select_cells"], "additionalProperties": false, "properties": {"compiler_id": {"$ref": "#/$defs/identifier"}, "compiler_version": {"$ref": "#/$defs/identifier"}, "selection_rule": {"const": "published_ordered_prefix"}, "outcome_independent": {"const": true}, "agent_may_select_cells": {"const": false}}},
    "matrix": {
      "type": "object",
      "required": ["profile_id", "preregistration_digest", "scenario_set_digest", "cells"],
      "additionalProperties": false,
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "preregistration_digest": {"$ref": "#/$defs/digest"},
        "scenario_set_digest": {"$ref": "#/$defs/digest"},
        "cells": {"type": "array", "minItems": 10, "maxItems": 500, "items": {"type": "object", "required": ["cell_id", "family", "partition", "scored", "cell_spec_digest", "seed"], "additionalProperties": false, "properties": {"cell_id": {"$ref": "#/$defs/identifier"}, "family": {"enum": ["canonical_anchor", "placement_approach", "illumination", "camera_sensor", "bounded_physics", "admitted_object_material_cousin", "pairwise_stress", "held_out_composition"]}, "partition": {"enum": ["qualification", "held_out"]}, "scored": {"const": true}, "cell_spec_digest": {"$ref": "#/$defs/digest"}, "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "resolved_scenario": {"type": "object", "minProperties": 1}, "coverage_status": {"enum": ["available", "typed_gap_fallback"]}, "coverage_gap": {"type": "string", "minLength": 1, "maxLength": 512}, "fallback_source_family": {"type": "string", "minLength": 1, "maxLength": 128}}}}
      }
    },
    "counts": {"type": "object", "required": ["learned_episode_count", "control_episode_count", "total_episode_count", "policy_count", "episodes_per_policy", "learned_policy_rollout_count", "diagnostic_control_rollout_count"], "additionalProperties": false, "properties": {"learned_episode_count": {"type": "integer", "minimum": 20, "maximum": 1000}, "control_episode_count": {"type": "integer", "minimum": 20, "maximum": 1000}, "total_episode_count": {"type": "integer", "minimum": 40, "maximum": 2000}, "policy_count": {"const": 2}, "episodes_per_policy": {"enum": [10, 100, 500]}, "learned_policy_rollout_count": {"type": "integer", "minimum": 20, "maximum": 1000}, "diagnostic_control_rollout_count": {"type": "integer", "minimum": 20, "maximum": 1000}}},
    "execution_guards": {"type": "object", "required": ["candidate_cells_and_seeds_must_match", "policy_specific_scenario_changes_prohibited", "zero_action_negative_every_scored_cell", "deterministic_scripted_positive_every_scored_cell", "retry_cap", "maximum_provider_allocations"], "additionalProperties": false, "properties": {"candidate_cells_and_seeds_must_match": {"const": true}, "policy_specific_scenario_changes_prohibited": {"const": true}, "zero_action_negative_every_scored_cell": {"const": true}, "deterministic_scripted_positive_every_scored_cell": {"const": true}, "retry_cap": {"const": 0}, "maximum_provider_allocations": {"const": 1}, "controls_gate_policy_execution": {"type": "boolean"}, "failed_controls_preserved": {"const": true}, "scene_promotion_forbidden": {"const": true}, "official_ranking_forbidden": {"const": true}, "winner_selection_forbidden": {"const": true}}},
    "evidence_requirements": {"type": "object", "required": ["lossless_policy_input_frames_required", "digest_bound_frame_manifest_required", "derived_review_video_required", "typed_media_gap_before_first_observation_required", "grader_authority", "policy_self_grading_forbidden", "policy_query_receipt_required", "action_sequence_required", "action_delivery_readback_required", "joint_pose_state_trace_required", "contact_force_evidence_required", "task_object_trajectory_required"], "additionalProperties": false, "properties": {"lossless_policy_input_frames_required": {"const": true}, "digest_bound_frame_manifest_required": {"const": true}, "derived_review_video_required": {"const": true}, "typed_media_gap_before_first_observation_required": {"const": true}, "grader_authority": {"const": "deterministic_simulator_state"}, "policy_self_grading_forbidden": {"const": true}, "policy_query_receipt_required": {"const": true}, "action_sequence_required": {"const": true}, "action_delivery_readback_required": {"const": true}, "joint_pose_state_trace_required": {"const": true}, "contact_force_evidence_required": {"const": true}, "task_object_trajectory_required": {"const": true}}},
    "configuration_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [{"if": {"properties": {"run_kind": {"const": "internal_policy_canary"}}, "required": ["run_kind"]}, "then": {"required": ["claim_ceiling", "scene_revision_digest", "scene_controls_status_at_submission", "robot_preset_id", "policy_candidate_ids", "notification", "website_request_digest", "task_success_contract", "task_success_contract_digest", "unqualified_warning"]}}],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "taskSuccessContract": {"$ref": "rigid_task_success_contract.v1.schema.json"}
  }
}
