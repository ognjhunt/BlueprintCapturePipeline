{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_worker_stack_manifest.v1.schema.json",
  "title": "Reconstruction Worker Stack Manifest v1",
  "type": "object",
  "required": ["schema_version", "worker_family", "runnable_platform", "headless_required", "display_required", "source_commit_sha", "qualification_status", "components", "model_assets", "hidden_heldout_access", "trainer_self_grading", "worker_stack_manifest_digest"],
  "properties": {
    "schema_version": {"const": "reconstruction_worker_stack_manifest.v1"},
    "worker_family": {"const": "blueprint-reconstruction-worker"},
    "runnable_platform": {"const": "linux/amd64"},
    "headless_required": {"const": true},
    "display_required": {"const": false},
    "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
    "qualification_status": {"const": "candidate_unbuilt"},
    "components": {"type": "array", "minItems": 5},
    "model_assets": {"type": "array"},
    "hidden_heldout_access": {"const": false},
    "trainer_self_grading": {"const": false},
    "worker_stack_manifest_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
