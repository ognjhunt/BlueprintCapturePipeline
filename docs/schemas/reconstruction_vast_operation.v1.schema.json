{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_vast_operation.v1.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/execution"},
    {"$ref": "#/$defs/replay"},
    {"$ref": "#/$defs/teardown"},
    {"$ref": "#/$defs/provider_zero"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "enum": ["pose_canary", "trainer_canary"]
    },
    "common_boundary": {
      "type": "object",
      "properties": {
        "scientific_qualification_inferred": {"const": false},
        "proof_effect": {"const": "none"}
      }
    },
    "execution": {
      "allOf": [
        {"$ref": "#/$defs/common_boundary"},
        {
          "type": "object",
          "required": [
            "schema_version", "status", "operation", "request_digest",
            "bound_request_digest", "operation_request_digest",
            "operation_input_bundle_digest", "worker_image_digest",
            "source_commit_sha", "provider", "instance_id", "fetch_attempts",
            "operation_output_bundle_digest", "output_bundle_receipt_digest",
            "provider_runtime_result_digest", "operation_result_status",
            "operation_scientific_success_inferred",
            "output_retrieved_before_teardown", "duration_seconds", "cost_usd",
            "provider_mutations_performed", "provider_mutation_outcome_ambiguous",
            "blockers", "teardown_receipt_digest", "provider_zero_digest",
            "provider_zero_verified", "scientific_qualification_inferred",
            "proof_effect", "claim_ceiling", "execution_result_digest"
          ],
          "properties": {
            "schema_version": {"const": "reconstruction_vast_operation_execution.v1"},
            "status": {"enum": ["completed", "failed"]},
            "operation": {"$ref": "#/$defs/operation"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "bound_request_digest": {"$ref": "#/$defs/digest"},
            "operation_request_digest": {"$ref": "#/$defs/digest"},
            "operation_input_bundle_digest": {"$ref": "#/$defs/digest"},
            "worker_image_digest": {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
            "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
            "provider": {"const": "vast"},
            "instance_id": {"type": ["string", "null"]},
            "fetch_attempts": {"type": "integer", "minimum": 0},
            "operation_output_bundle_digest": {
              "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
            },
            "output_bundle_receipt_digest": {
              "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
            },
            "provider_runtime_result_digest": {
              "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
            },
            "operation_result_status": {
              "type": ["string", "null"]
            },
            "operation_scientific_success_inferred": {"const": false},
            "output_retrieved_before_teardown": {"type": "boolean"},
            "duration_seconds": {"type": "number", "minimum": 0},
            "cost_usd": {"type": "number", "minimum": 0},
            "provider_mutations_performed": {"type": "integer", "minimum": 0},
            "provider_mutation_outcome_ambiguous": {"type": "boolean"},
            "blockers": {"type": "array", "items": {"type": "string"}},
            "teardown_receipt_digest": {"$ref": "#/$defs/digest"},
            "provider_zero_digest": {"$ref": "#/$defs/digest"},
            "provider_zero_verified": {"type": "boolean"},
            "claim_ceiling": {"const": "provider_execution_and_candidate_transport_only"},
            "execution_result_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "replay": {
      "allOf": [
        {"$ref": "#/$defs/common_boundary"},
        {
          "type": "object",
          "required": [
            "schema_version", "status", "operation", "request_digest",
            "bound_request_digest", "execution_result_digest",
            "operation_result_status", "blockers", "live_provider_accessed",
            "scientific_qualification_inferred", "proof_effect", "claim_ceiling",
            "replay_digest"
          ],
          "properties": {
            "schema_version": {"const": "reconstruction_vast_operation_replay.v1"},
            "status": {"enum": ["replay_verified", "replay_rejected"]},
            "operation": {"$ref": "#/$defs/operation"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "bound_request_digest": {"$ref": "#/$defs/digest"},
            "execution_result_digest": {
              "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
            },
            "operation_result_status": {"type": ["string", "null"]},
            "blockers": {"type": "array", "items": {"type": "string"}},
            "live_provider_accessed": {"const": false},
            "claim_ceiling": {
              "const": "recorded_provider_execution_and_candidate_transport_only"
            },
            "replay_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "teardown": {
      "type": "object",
      "required": [
        "schema_version", "status", "provider", "operation", "request_digest",
        "bound_request_digest", "worker_image_digest", "instance_id",
        "output_retrieved_before_teardown", "terminate_result",
        "provider_zero_verified", "timestamp", "teardown_receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "reconstruction_vast_operation_teardown.v1"},
        "status": {"enum": ["PASS", "FAIL"]},
        "provider": {"const": "vast"},
        "operation": {"$ref": "#/$defs/operation"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "bound_request_digest": {"$ref": "#/$defs/digest"},
        "worker_image_digest": {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
        "instance_id": {"type": ["string", "null"]},
        "output_retrieved_before_teardown": {"type": "boolean"},
        "terminate_result": {"type": "object"},
        "provider_zero_verified": {"type": "boolean"},
        "timestamp": {"type": "string", "minLength": 1},
        "teardown_receipt_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provider_zero": {
      "type": "object",
      "required": [
        "schema_version", "status", "provider", "operation", "request_digest",
        "bound_request_digest", "scoped_live_resource_count",
        "global_live_resource_count", "api_confirmed", "timestamp",
        "provider_zero_digest"
      ],
      "properties": {
        "schema_version": {"const": "reconstruction_vast_operation_provider_zero.v1"},
        "status": {"enum": ["PASS", "FAIL"]},
        "provider": {"const": "vast"},
        "operation": {"$ref": "#/$defs/operation"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "bound_request_digest": {"$ref": "#/$defs/digest"},
        "scoped_live_resource_count": {"type": "integer", "minimum": 0},
        "global_live_resource_count": {"type": "integer", "minimum": 0},
        "api_confirmed": {"type": "boolean"},
        "timestamp": {"type": "string", "minLength": 1},
        "provider_zero_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
