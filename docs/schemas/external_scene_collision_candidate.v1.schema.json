{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external_scene_collision_candidate.v1.schema.json",
  "title": "External scene collision candidate v1",
  "type": "object",
  "required": ["schema_version", "status", "request_digest", "source_asset_digest", "source_video_available", "source_video_required_for_candidate_compilation", "output_coordinate_frame", "metric_scale_status", "independent_known_distance_anchor", "vertex_count", "triangle_count", "bounds_stage_units", "obvious_scale_mismatch_detected", "collider_prim_path", "collider_asset_digest", "collision_api_configured", "static_triangle_mesh", "generated_fill_used", "collision_validated", "blockers", "qualification_gaps", "proof_effect", "claim_ceiling", "unsupported_claims", "collision_candidate_digest"],
  "properties": {
    "schema_version": {"const": "external_scene_collision_candidate.v1"},
    "status": {"const": "candidate_compiled"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "source_asset_digest": {"$ref": "#/$defs/digest"},
    "source_video_available": {"type": "boolean"},
    "source_video_required_for_candidate_compilation": {"const": false},
    "metric_scale_status": {"type": "string"},
    "independent_known_distance_anchor": {"type": "boolean"},
    "vertex_count": {"type": "integer", "minimum": 3},
    "triangle_count": {"type": "integer", "minimum": 1},
    "bounds_stage_units": {"type": "object"},
    "obvious_scale_mismatch_detected": {"type": "boolean"},
    "output_coordinate_frame": {"type": "object"},
    "collider_prim_path": {"const": "/World/BlueprintReconstruction/Collision/ExternalSceneMesh"},
    "collider_asset_path": {"type": "string"},
    "collider_asset_digest": {"$ref": "#/$defs/digest"},
    "collision_api_configured": {"const": true},
    "static_triangle_mesh": {"const": true},
    "generated_fill_used": {"const": false},
    "collision_validated": {"const": false},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "qualification_gaps": {"type": "array", "items": {"type": "string"}},
    "proof_effect": {"const": "external_scene_collision_candidate_only"},
    "claim_ceiling": {"const": "isaac_collision_candidate"},
    "unsupported_claims": {"type": "array", "items": {"type": "string"}},
    "collision_candidate_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
