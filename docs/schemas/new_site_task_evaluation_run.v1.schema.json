{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/new_site_task_evaluation_run.v1.schema.json",
  "title": "Provider-neutral new-site Task Evaluation Run result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "status",
    "source_profile_digest",
    "terminal_stage",
    "blockers",
    "smallest_missing_measurement",
    "robot_id",
    "policy_attempt_count",
    "supported_ranking_candidate_count",
    "ranking",
    "claim_boundary",
    "run_digest"
  ],
  "properties": {
    "schema_version": {"const": "new_site_task_evaluation_run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "abstained"]},
    "source_profile_digest": {
      "oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "terminal_stage": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "smallest_missing_measurement": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "instruction", "stage"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "instruction": {"type": "string", "minLength": 1},
            "stage": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "robot_id": {"enum": ["franka_panda", "unitree_g1", null]},
    "policy_attempt_count": {"type": "integer", "minimum": 0, "maximum": 5},
    "supported_ranking_candidate_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "ranking": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "candidate_id",
          "policy_identity_digest",
          "attempt_digest",
          "metric_value"
        ],
        "properties": {
          "rank": {"type": "integer", "minimum": 1, "maximum": 5},
          "candidate_id": {"type": "string", "minLength": 1},
          "policy_identity_digest": {"$ref": "#/$defs/digest"},
          "attempt_digest": {"$ref": "#/$defs/digest"},
          "metric_value": {"type": "number"}
        },
        "additionalProperties": false
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "task_evaluation_run_completed",
        "learned_policy_attempts_observed",
        "learned_policy_ranking_proven",
        "physical_success_proven",
        "deployment_readiness_proven"
      ],
      "properties": {
        "task_evaluation_run_completed": {"type": "boolean"},
        "learned_policy_attempts_observed": {"type": "boolean"},
        "learned_policy_ranking_proven": {"type": "boolean"},
        "physical_success_proven": {"const": false},
        "deployment_readiness_proven": {"const": false}
      },
      "additionalProperties": true
    },
    "run_digest": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": true,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
