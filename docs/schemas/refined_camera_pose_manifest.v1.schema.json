{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blueprint.ai/refined_camera_pose_manifest.v1.schema.json",
  "title": "Blueprint Refined Camera Pose Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "stable_run_identity",
    "source_capture_identity",
    "source_capture_digest",
    "original_file_references",
    "producing_method",
    "implementation_version",
    "implementation_digest",
    "container_image_digest",
    "source_commit_sha",
    "deterministic_configuration_digest",
    "input_digests",
    "output_digests",
    "frozen_split_digest",
    "camera_calibration_digest",
    "initial_pose_manifest_digest",
    "pose_refinement_execution_request_digest",
    "method_id",
    "coordinate_frame_declaration",
    "units",
    "metric_scale_status",
    "provider_runtime_identity",
    "cost_usd",
    "duration_seconds",
    "authority_used",
    "warnings",
    "blockers",
    "parent_artifact_or_event",
    "observations",
    "raw_arkit_poses_modified",
    "hidden_heldout_observations_included",
    "proof_effect",
    "claim_ceiling",
    "timestamp",
    "refined_camera_pose_manifest_digest"
  ],
  "properties": {
    "schema_version": {"const": "refined_camera_pose_manifest.v1"},
    "stable_run_identity": {"type": "string", "minLength": 1},
    "source_capture_identity": {"type": "string", "minLength": 1},
    "source_capture_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "original_file_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "digest"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": true
      }
    },
    "producing_method": {"type": "string", "minLength": 1},
    "implementation_version": {"type": "string", "minLength": 1},
    "implementation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "container_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deterministic_configuration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_digests": {"type": "array"},
    "output_digests": {"type": "array"},
    "frozen_split_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "camera_calibration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "initial_pose_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pose_refinement_execution_request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "method_id": {"enum": ["arkit_anchored_bundle_adjustment_v1", "arkit_anchored_pose_graph_refinement_v1"]},
    "coordinate_frame_declaration": {"type": "object"},
    "units": {"const": "meters"},
    "metric_scale_status": {"enum": ["sensor_metric_unvalidated", "independently_validated_metric"]},
    "provider_runtime_identity": {"type": "object"},
    "cost_usd": {"type": "number", "minimum": 0},
    "duration_seconds": {"type": "number", "minimum": 0},
    "authority_used": {"type": "object"},
    "warnings": {"type": "array"},
    "blockers": {"type": "array"},
    "parent_artifact_or_event": {"type": "object"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["observation_id", "T_world_camera"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "T_world_camera": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "number"}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "raw_arkit_poses_modified": {"const": false},
    "hidden_heldout_observations_included": {"const": false},
    "proof_effect": {"const": "bounded_refined_trajectory_candidate_only"},
    "claim_ceiling": {"const": "calibrated_camera_trajectory"},
    "timestamp": {"type": "string", "minLength": 1},
    "refined_camera_pose_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
