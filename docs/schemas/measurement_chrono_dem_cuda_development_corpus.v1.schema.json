{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/measurement-chrono-dem-cuda-development-corpus.v1.schema.json",
  "title": "Blueprint Chrono DEM CUDA development corpus",
  "type": "object",
  "required": ["schema_version", "corpus_id", "description", "lane", "development_only", "synthetic_fixture", "held_out", "physical_measurements_included", "physical_material_characterization_included", "qualification_labels_included", "r5_evidence", "r6_decision", "r7_admission", "shared_operating_point", "metric_definitions", "cases"],
  "properties": {
    "schema_version": {"const": "measurement_chrono_dem_cuda_development_corpus.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "lane": {"const": "granular"},
    "development_only": {"const": true},
    "synthetic_fixture": {"const": true},
    "held_out": {"const": false},
    "physical_measurements_included": {"const": false},
    "physical_material_characterization_included": {"const": false},
    "qualification_labels_included": {"const": false},
    "r5_evidence": {"const": false},
    "r6_decision": {"const": false},
    "r7_admission": {"const": false},
    "shared_operating_point": {
      "type": "object",
      "required": ["adapter_protocol", "source_commit", "module", "native_length_unit", "native_mass_unit", "native_time_unit", "output_length_unit", "output_force_unit", "particle_shape", "particle_size_distribution", "cohesion_model", "material_characterization_scope", "count_x", "count_y", "count_z", "particle_radius_cm", "gravity_cm_s2", "rolling_friction", "duration_s", "timestep_s", "settle_speed_threshold_cm_s", "minimum_settled_fraction", "minimum_spread_ratio", "maximum_spread_ratio", "maximum_penetration_m", "maximum_static_weight_relative_error"],
      "properties": {
        "adapter_protocol": {"const": "chrono_dem_cuda_synthetic_particle_settling.v1"},
        "source_commit": {"const": "9faf13dd8f1128dd75ed233a9627027b0422c3f7"},
        "module": {"const": "chrono_dem"},
        "native_length_unit": {"const": "centimeters"},
        "native_mass_unit": {"const": "grams"},
        "native_time_unit": {"const": "seconds"},
        "output_length_unit": {"const": "meters"},
        "output_force_unit": {"const": "newtons"},
        "particle_shape": {"const": "sphere"},
        "particle_size_distribution": {"const": "monodisperse"},
        "cohesion_model": {"const": "none"},
        "material_characterization_scope": {"const": "synthetic_parameters_only"},
        "count_x": {"const": 3}, "count_y": {"const": 3}, "count_z": {"const": 3},
        "particle_radius_cm": {"const": 1.0},
        "gravity_cm_s2": {"const": -980.0},
        "rolling_friction": {"type": "number", "minimum": 0, "maximum": 1},
        "duration_s": {"type": "number", "minimum": 0.1, "maximum": 2},
        "timestep_s": {"type": "number", "minimum": 0.000001, "maximum": 0.001},
        "settle_speed_threshold_cm_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "minimum_settled_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_spread_ratio": {"type": "number", "minimum": 0.5},
        "maximum_spread_ratio": {"type": "number", "minimum": 0.5},
        "maximum_penetration_m": {"type": "number", "minimum": 0},
        "maximum_static_weight_relative_error": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "metric_definitions": {
      "type": "object",
      "required": ["state_trajectory", "topology_contact", "force", "task_outcome"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": ["case_id", "synthetic_material_id", "density_g_cm3", "friction"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "synthetic_material_id": {"type": "string", "minLength": 1},
        "density_g_cm3": {"type": "number", "minimum": 0.1, "maximum": 20},
        "friction": {"type": "number", "minimum": 0, "maximum": 2}
      },
      "additionalProperties": false
    }
  }
}
