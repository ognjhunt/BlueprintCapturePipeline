{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/schemas/task_evaluation_shared_mutation_window.v1.schema.json",
  "title": "Task Evaluation shared mutation window v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "window_id",
    "activation_id",
    "team_namespace",
    "expected_production_commit",
    "allowed_mutations",
    "provider_allowlist",
    "maximum_hard_cap_usd",
    "issued_at",
    "expires_at",
    "released_by",
    "release_reference",
    "provider_resource_allocation_allowed",
    "paid_request_allowed",
    "window_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "task_evaluation_shared_mutation_window.v1"},
    "status": {"const": "released"},
    "window_id": {"$ref": "#/$defs/identifier"},
    "activation_id": {"$ref": "#/$defs/identifier"},
    "team_namespace": {"$ref": "#/$defs/identifier"},
    "expected_production_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "allowed_mutations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "profile_publication",
          "catalog_synchronization",
          "standing_authorization"
        ]
      },
      "allOf": [
        {"contains": {"const": "profile_publication"}},
        {"contains": {"const": "catalog_synchronization"}},
        {"contains": {"const": "standing_authorization"}}
      ]
    },
    "provider_allowlist": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"enum": ["vast", "runpod", "gcp", "aws", "azure"]}
    },
    "maximum_hard_cap_usd": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "released_by": {"$ref": "#/$defs/identifier"},
    "release_reference": {"type": "string", "minLength": 1, "maxLength": 1000},
    "provider_resource_allocation_allowed": {"const": false},
    "paid_request_allowed": {"const": false},
    "window_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 192, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
