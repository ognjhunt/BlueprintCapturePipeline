{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene_task_target_analysis_request.v1.schema.json",
  "title": "Scene task target analysis request v1",
  "type": "object",
  "required": ["schema_version", "scene_id", "source_scene_digest", "source_video_available", "source_observation_profile", "rendered_views", "object_affordance_proposals", "minimum_visual_confidence", "threshold_frozen_before_analysis", "candidate_may_self_authorize", "analyzer_provenance", "robot_id", "metric_scale_status", "collision_support", "reach_support", "request_digest"],
  "properties": {
    "schema_version": {"const": "scene_task_target_analysis_request.v1"},
    "scene_id": {"type": "string", "minLength": 1},
    "source_scene_digest": {"$ref": "#/$defs/digest"},
    "source_video_available": {"type": "boolean"},
    "source_observation_profile": {"enum": ["raw_capture_and_reconstruction_views", "authorized_external_reconstruction_views"]},
    "rendered_views": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "object_affordance_proposals": {"type": "array", "items": {"type": "object"}},
    "minimum_visual_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "threshold_frozen_before_analysis": {"const": true},
    "candidate_may_self_authorize": {"const": false},
    "analyzer_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzer_id", "implementation_version", "analyzer_contract_digest", "proposal_generation_is_dynamic", "candidate_may_self_authorize"],
      "properties": {
        "analyzer_id": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "analyzer_contract_digest": {"$ref": "#/$defs/digest"},
        "proposal_generation_is_dynamic": {"const": true},
        "candidate_may_self_authorize": {"const": false}
      }
    },
    "robot_id": {"enum": ["franka_panda", "unitree_g1"]},
    "metric_scale_status": {"enum": ["validated", "provider_declared_not_independently_validated", "sensor_metric_unvalidated", "unverified"]},
    "collision_support": {"type": "object"},
    "reach_support": {"type": "object"},
    "request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
