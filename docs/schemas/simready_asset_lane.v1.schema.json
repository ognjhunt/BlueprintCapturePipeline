{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryblueprint.io/contracts/simready-asset-lane.v1.schema.json",
  "title": "Blueprint on-demand SimReady object lane contracts",
  "description": "Doctrine-safe SimReady generation: estimates stay flagged, candidates stay unvalidated, providers stay R2-gated, and no artifact grants physics authority.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/providerPlan"},
    {"$ref": "#/$defs/sceneBinding"},
    {"$ref": "#/$defs/preflightToolchain"},
    {"$ref": "#/$defs/preflight"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "required": ["schema_version", "request_id", "object_id", "bundle_id", "bundle_hash", "source_references", "target_formats", "generation_mode", "density_class", "rights_gates", "simready_request_digest"],
      "properties": {
        "schema_version": {"const": "simready_asset_request.v1"},
        "request_id": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "bundle_id": {"type": "string", "minLength": 1},
        "bundle_hash": {"$ref": "#/$defs/digest"},
        "source_references": {"type": "object"},
        "target_formats": {
          "type": "array", "minItems": 1,
          "items": {"enum": ["mjcf", "usd"]}
        },
        "generation_mode": {"enum": ["local_geometry_pipeline", "external_provider"]},
        "provider_candidate_id": {"type": "string"},
        "density_class": {"type": "string", "minLength": 1},
        "rights_gates": {
          "type": "object",
          "required": ["provider_training_use_allowed", "data_retention_allowed"],
          "properties": {
            "provider_training_use_allowed": {"const": false},
            "data_retention_allowed": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "simready_request_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["schema_version", "asset_id", "object_id", "simready_request_digest", "bundle_id", "bundle_hash", "generated_on", "generator", "geometry", "colliders", "mass_estimate", "friction_estimate", "articulation", "exports", "candidate_site_evidence", "validation", "physics_authority_granted", "routing_eligibility_granted", "execution_authorized", "simready_asset_digest"],
      "properties": {
        "schema_version": {"const": "simready_asset_manifest.v1"},
        "mass_estimate": {
          "type": "object",
          "required": ["estimated"],
          "properties": {"estimated": {"const": true}},
          "additionalProperties": true
        },
        "friction_estimate": {
          "type": "object",
          "required": ["estimated"],
          "properties": {"estimated": {"const": true}},
          "additionalProperties": true
        },
        "articulation": {
          "type": "object",
          "required": ["estimated"],
          "properties": {"estimated": {"const": true}},
          "additionalProperties": true
        },
        "candidate_site_evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidence_id", "available", "validated", "record_id"],
            "properties": {"validated": {"const": false}},
            "additionalProperties": true
          }
        },
        "validation": {
          "type": "object",
          "required": ["validated", "qualification_status"],
          "properties": {
            "validated": {"const": false},
            "qualification_status": {"const": "unvalidated_candidate"}
          },
          "additionalProperties": true
        },
        "physics_authority_granted": {"const": false},
        "routing_eligibility_granted": {"const": false},
        "execution_authorized": {"const": false},
        "simready_asset_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": true
    },
    "providerPlan": {
      "type": "object",
      "required": ["schema_version", "simready_request_digest", "provider_candidate_id", "required_r2_gates", "resolved_r2_gates", "unresolved_r2_gates", "status", "live_call_performed", "network_used", "provider_output_would_enter_evidence_validated", "agent_may_resolve_gates", "simready_provider_plan_digest"],
      "properties": {
        "schema_version": {"const": "simready_provider_generation_plan.v1"},
        "status": {
          "enum": ["blocked_r2_gates_unresolved", "gates_resolved_pending_r3_adapter_admission"]
        },
        "live_call_performed": {"const": false},
        "network_used": {"const": false},
        "provider_output_would_enter_evidence_validated": {"const": false},
        "agent_may_resolve_gates": {"const": false},
        "simready_provider_plan_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": true
    },
    "sceneBinding": {
      "type": "object",
      "required": ["schema_version", "site_evidence_profile_id", "site_evidence_digest", "appearance_layer", "object_slots", "appearance_stays_3dgs", "dynamic_rendering_requires_gaussian_object_partition", "physics_authority_granted", "world_model_physics_used", "routing_still_requires_validated_evidence", "simready_scene_binding_digest"],
      "properties": {
        "schema_version": {"const": "simready_scene_binding.v1"},
        "appearance_stays_3dgs": {"const": true},
        "dynamic_rendering_requires_gaussian_object_partition": {"const": true},
        "physics_authority_granted": {"const": false},
        "world_model_physics_used": {"const": false},
        "routing_still_requires_validated_evidence": {"const": true},
        "object_slots": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["object_id", "simready_asset_digest", "physics_source", "appearance_source", "object_absent_from_static_background", "dynamic_object_renderable_without_duplicate"],
            "properties": {
              "physics_source": {"const": "simready_draft_unvalidated"},
              "appearance_source": {"enum": ["scene_gaussian_splat_static_only", "movable_object_gaussian_partition"]},
              "object_absent_from_static_background": {"type": "boolean"},
              "dynamic_object_renderable_without_duplicate": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "simready_scene_binding_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": true
    },
    "preflightToolchain": {
      "type": "object",
      "required": ["schema_version", "tools", "current_required_toolchain_available", "optional_validator_absence_blocks_current_preflight", "install_performed", "network_used", "provider_call_performed", "simready_preflight_toolchain_probe_digest"],
      "properties": {
        "schema_version": {"const": "simready_preflight_toolchain_probe.v1"},
        "tools": {"type": "object"},
        "current_required_toolchain_available": {"type": "boolean"},
        "optional_validator_absence_blocks_current_preflight": {"const": false},
        "install_performed": {"const": false},
        "network_used": {"const": false},
        "provider_call_performed": {"const": false},
        "simready_preflight_toolchain_probe_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "preflight": {
      "type": "object",
      "required": ["schema_version", "toolchain_probe", "assets", "asset_count", "passed", "preflight_pass_means_loadable_and_stable_only", "physical_validity_established", "qualification_created", "simready_preflight_digest"],
      "properties": {
        "schema_version": {"const": "simready_scene_preflight.v1"},
        "toolchain_probe": {"$ref": "#/$defs/preflightToolchain"},
        "assets": {"type": "array", "minItems": 1},
        "asset_count": {"type": "integer", "minimum": 1},
        "passed": {"type": "boolean"},
        "preflight_pass_means_loadable_and_stable_only": {"const": true},
        "physical_validity_established": {"const": false},
        "qualification_created": {"const": false},
        "simready_preflight_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  }
}
