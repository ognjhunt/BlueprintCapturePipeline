{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/nurec_openusd_packaging_result.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "appearance_asset_digest",
    "metric_geometry_manifest_digest",
    "collider_candidate_manifest_digest",
    "collider_qualification_digest",
    "collider_qualification_decision",
    "packaging_request_digest",
    "package_digest",
    "package_artifact_reference",
    "package_format",
    "self_contained",
    "deterministic_archive",
    "package_member_count",
    "particlefield_prim_count",
    "collision_api_prim_count",
    "missing_asset_count",
    "stage_meters_per_unit",
    "up_axis",
    "shared_visual_physics_frame",
    "appearance_prim_present",
    "collision_prim_present",
    "collision_api_configured",
    "proof_effect",
    "claim_ceiling",
    "packaging_result_digest"
  ],
  "properties": {
    "schema_version": {"const": "nurec_openusd_packaging_result.v1"},
    "appearance_asset_digest": {"$ref": "#/$defs/digest"},
    "metric_geometry_manifest_digest": {"$ref": "#/$defs/digest"},
    "collider_candidate_manifest_digest": {"$ref": "#/$defs/digest"},
    "collider_qualification_digest": {"$ref": "#/$defs/digest"},
    "collider_qualification_decision": {"const": "accepted_bounded_navigation"},
    "packaging_request_digest": {"$ref": "#/$defs/digest"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "package_artifact_reference": {"type": "string", "pattern": "^[^/].*\\.usdz$"},
    "package_format": {"const": "usdz"},
    "self_contained": {"const": true},
    "deterministic_archive": {"const": true},
    "package_member_count": {"type": "integer", "minimum": 1},
    "particlefield_prim_count": {"type": "integer", "minimum": 1},
    "collision_api_prim_count": {"type": "integer", "minimum": 1},
    "missing_asset_count": {"const": 0},
    "stage_meters_per_unit": {"const": 1.0},
    "up_axis": {"const": "Z"},
    "shared_visual_physics_frame": {"const": true},
    "appearance_prim_present": {"const": true},
    "collision_prim_present": {"const": true},
    "collision_api_configured": {"const": true},
    "proof_effect": {"const": "packaging_compatibility_candidate_only"},
    "claim_ceiling": {"const": "openusd_package"},
    "packaging_result_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
