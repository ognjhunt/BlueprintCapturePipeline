{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/reconstruction_worker_license_inventory.v1.schema.json",
  "title": "Reconstruction Worker License Inventory v1",
  "type": "object",
  "required": ["schema_version", "source_commit_sha", "worker_stack_manifest_digest", "requirements_lock_digest", "license_policy_schema_version", "license_policy_digest", "license_policy_reviewed_on", "as_of", "status", "dependency_count", "dependency_reviews", "source_component_reviews", "model_asset_reviews", "blockers", "agent_approval_permitted", "internal_build_authorized", "redistribution_authorized", "commercial_distribution_authorized", "proof_effect", "claim_ceiling", "license_inventory_digest"],
  "properties": {
    "schema_version": {"const": "reconstruction_worker_license_inventory.v1"},
    "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
    "worker_stack_manifest_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "requirements_lock_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "license_policy_schema_version": {"const": "blueprint.runtime_dependency_license_policy.v1"},
    "license_policy_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "license_policy_reviewed_on": {"format": "date"},
    "as_of": {"format": "date"},
    "status": {"enum": ["policy_approved", "review_required"]},
    "dependency_count": {"type": "integer", "minimum": 1},
    "dependency_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "recorded_name", "version", "exact_requirement", "hashes", "review_status", "license_expression", "review_owner", "reviewed_on", "expires_on", "review_source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "recorded_name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "exact_requirement": {"pattern": "^[a-z0-9][a-z0-9.-]*==\\S+$"},
          "hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^sha256:[0-9a-f]{64}$"}},
          "review_status": {"enum": ["approved", "review_required"]},
          "license_expression": {"type": ["string", "null"]},
          "review_owner": {"type": ["string", "null"]},
          "reviewed_on": {"type": ["string", "null"]},
          "expires_on": {"type": ["string", "null"]},
          "review_source": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "source_component_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component_id", "name", "version", "source_revision", "license", "redistribution", "review_status"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "redistribution": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["declared", "review_required"]}
        },
        "additionalProperties": false
      }
    },
    "model_asset_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_id", "url", "digest", "license", "review_status"],
        "properties": {
          "model_id": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
          "license": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["declared", "review_required"]}
        },
        "additionalProperties": false
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "agent_approval_permitted": {"const": false},
    "internal_build_authorized": {"const": false},
    "redistribution_authorized": {"const": false},
    "commercial_distribution_authorized": {"const": false},
    "proof_effect": {"const": "none"},
    "claim_ceiling": {"const": "license_inventory_and_review_gap_only"},
    "license_inventory_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
