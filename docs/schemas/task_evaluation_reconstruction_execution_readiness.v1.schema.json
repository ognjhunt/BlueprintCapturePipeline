{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.blueprint.ai/task_evaluation_reconstruction_execution_readiness.v1.schema.json",
  "title": "Task Evaluation Reconstruction Execution Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "capture_build_digest",
    "source_binding",
    "capture_reconstruction_route_digest",
    "capture_authority_profile",
    "tool_registry_digest",
    "bound_tool_ids",
    "control_plane_binding",
    "source_commit_sha",
    "recorded_at",
    "status",
    "stages",
    "blockers",
    "next_legal_actions",
    "proof_boundary",
    "reconstruction_execution_readiness_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "task_evaluation_reconstruction_execution_readiness.v1"
    },
    "readiness_id": {
      "type": "string",
      "pattern": "^reconstruction-readiness-[0-9a-f]{24}$"
    },
    "capture_build_digest": {"$ref": "#/$defs/digest"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "capture_build_digest",
        "capture_session_id",
        "intake_id",
        "capture_digest",
        "envelope_digest",
        "qa_report_digest",
        "object_manifest_digest",
        "raw_media_included",
        "source_binding_is_proof_upgrade",
        "source_binding_digest"
      ],
      "properties": {
        "schema_version": {"const": "task_evaluation_capture_source_binding.v1"},
        "capture_build_digest": {"$ref": "#/$defs/digest"},
        "capture_session_id": {"type": ["string", "null"]},
        "intake_id": {"type": ["string", "null"]},
        "capture_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "envelope_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "qa_report_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "object_manifest_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "raw_media_included": {"const": false},
        "source_binding_is_proof_upgrade": {"const": false},
        "source_binding_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "capture_reconstruction_route_digest": {"$ref": "#/$defs/digest"},
    "capture_authority_profile": {
      "type": ["string", "null"]
    },
    "tool_registry_digest": {"$ref": "#/$defs/digest"},
    "bound_tool_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "control_plane_binding": {
      "type": ["object", "null"]
    },
    "source_commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "Z$"
    },
    "status": {
      "enum": [
        "route_unresolved",
        "source_binding_mismatch",
        "not_ready",
        "ready_for_bounded_execution"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "stage_id",
          "method_kind",
          "implementation_status",
          "typed_tool_registered",
          "runtime_bound",
          "control_plane_authority_status",
          "readiness_status",
          "blockers"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "stage_id": {"type": "string", "minLength": 1},
          "method_kind": {"type": "string", "minLength": 1},
          "implementation_status": {"type": "string", "minLength": 1},
          "typed_tool_registered": {"type": "boolean"},
          "runtime_bound": {"type": "boolean"},
          "control_plane_authority_status": {"type": "string", "minLength": 1},
          "readiness_status": {"type": "string", "minLength": 1},
          "blockers": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "next_legal_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "proof_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness_is_execution_authority",
        "readiness_is_reconstruction_evidence",
        "agent_can_grant_authority",
        "agent_can_change_proof_state",
        "raw_capture_remains_authoritative",
        "appearance_is_metric_or_collision_truth",
        "isaac_compatibility_is_physical_success",
        "proof_effect",
        "claim_ceiling"
      ],
      "properties": {
        "readiness_is_execution_authority": {"const": false},
        "readiness_is_reconstruction_evidence": {"const": false},
        "agent_can_grant_authority": {"const": false},
        "agent_can_change_proof_state": {"const": false},
        "raw_capture_remains_authoritative": {"const": true},
        "appearance_is_metric_or_collision_truth": {"const": false},
        "isaac_compatibility_is_physical_success": {"const": false},
        "proof_effect": {"const": "none"},
        "claim_ceiling": {"const": "execution_readiness_support_only"}
      }
    },
    "reconstruction_execution_readiness_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
