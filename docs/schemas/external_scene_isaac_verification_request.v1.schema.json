{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/external_scene_isaac_verification_request.v1.schema.json",
  "title": "Authorized external scene Isaac verification request v1",
  "type": "object",
  "required": [
    "schema_version", "source_commit_sha", "package_digest", "package_result_digest",
    "package_artifact_reference", "appearance_scene_digest", "collision_candidate_digest",
    "scene_frame_binding_digest", "target_analysis_digest", "target_binding_digest",
    "placement_proposal_digest", "render_options_digest", "fixed_camera_spec_digest",
    "fixed_camera_ids", "runtime_implementation_digest", "runtime_container_image_digest",
    "expected_prim_paths", "physics_probe_request", "remote_processing_authorization",
    "remote_processing_authorization_digest", "timeout_seconds", "spend_controls",
    "external_derived_support_asset", "source_relationship_to_blueprint_raw_capture",
    "blueprint_raw_capture_truth", "source_video_available",
    "source_video_required_for_candidate_execution", "independent_metric_scale_proven",
    "provider_authored_package", "blueprint_compiled_package", "exact_package_required",
    "headless", "display_attached", "execution_status", "provider_allocation_performed",
    "expected_runtime_schema", "proof_effect", "claim_ceiling",
    "isaac_verification_request_digest"
  ],
  "properties": {
    "schema_version": {"const": "external_scene_isaac_verification_request.v1"},
    "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
    "package_artifact_reference": {"type": "string", "pattern": "^[^/].*\\.usdz$"},
    "fixed_camera_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "runtime_container_image_digest": {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "expected_prim_paths": {"const": {"appearance": "/World/BlueprintReconstruction/Appearance", "collision": "/World/BlueprintReconstruction/Collision"}},
    "external_derived_support_asset": {"const": true},
    "source_relationship_to_blueprint_raw_capture": {"const": "none"},
    "blueprint_raw_capture_truth": {"const": false},
    "source_video_available": {"const": false},
    "source_video_required_for_candidate_execution": {"const": false},
    "independent_metric_scale_proven": {"const": false},
    "provider_authored_package": {"const": false},
    "blueprint_compiled_package": {"const": true},
    "exact_package_required": {"const": true},
    "headless": {"const": true},
    "display_attached": {"const": false},
    "execution_status": {"const": "awaiting_canonical_paid_runtime_authorization"},
    "provider_allocation_performed": {"const": false},
    "expected_runtime_schema": {"const": "isaac_splat_nurec_render_result.v3"},
    "proof_effect": {"const": "none"},
    "claim_ceiling": {"const": "request_only"},
    "isaac_verification_request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": true
}
