{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/provider_nurec_isaac_worker_bundle.v1.schema.json",
  "title": "Provider NuRec Isaac worker bundle v1",
  "type": "object",
  "required": [
    "schema_version", "isaac_verification_request_digest", "package_digest",
    "fixed_camera_spec_digest", "runtime_implementation_digest", "runtime_container_image_digest",
    "source_commit_sha", "fixed_camera_ids", "command", "expected_runtime_schema",
    "verification_request_member", "raw_secret_values_included", "provider_allocation_performed",
    "paid_execution_authorized_by_bundle", "canonical_allocator_command", "bundle_manifest_digest",
    "bundle_digest", "bundle_artifact_reference", "bundle_member_count", "bundle_bytes",
    "receipt_digest", "cost_usd", "proof_effect", "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "provider_nurec_isaac_worker_bundle.v1"},
    "isaac_verification_request_digest": {"$ref": "#/$defs/digest"},
    "package_digest": {"$ref": "#/$defs/digest"},
    "fixed_camera_spec_digest": {"$ref": "#/$defs/digest"},
    "render_options_digest": {"$ref": "#/$defs/digest"},
    "runtime_implementation_digest": {"$ref": "#/$defs/digest"},
    "runtime_container_image_digest": {"pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"},
    "source_commit_sha": {"pattern": "^[0-9a-f]{40}$"},
    "fixed_camera_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "command": {
      "type": "array",
      "minItems": 26,
      "contains": {"const": "--provider-package-mode"}
    },
    "expected_runtime_schema": {"const": "provider_nurec_isaac_runtime_result.v1"},
    "verification_request_member": {"const": "provider_nurec_isaac_verification_request.v1.json"},
    "raw_secret_values_included": {"const": false},
    "provider_allocation_performed": {"const": false},
    "paid_execution_authorized_by_bundle": {"const": false},
    "canonical_allocator_command": {"const": "python -m blueprint_pipeline.paid_resource_allocator gpu-canary"},
    "bundle_manifest_digest": {"$ref": "#/$defs/digest"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "bundle_member_count": {"enum": [5, 6]},
    "bundle_bytes": {"type": "integer", "minimum": 1},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "cost_usd": {"const": 0.0},
    "proof_effect": {"const": "none"},
    "claim_ceiling": {"const": "request_only"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
  "additionalProperties": true
}
