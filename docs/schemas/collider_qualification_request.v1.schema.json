{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprint.example/schemas/collider_qualification_request.v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "source_capture_digest",
    "train_heldout_split_digest",
    "collider_candidate_manifest_digest",
    "metric_scale_status",
    "measurement_artifact",
    "thresholds",
    "qa_thresholds_digest",
    "independent_evaluator",
    "task_region_ids",
    "collider_qualification_request_digest"
  ],
  "properties": {
    "schema_version": {"const": "collider_qualification_request.v1"},
    "source_capture_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "train_heldout_split_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "collider_candidate_manifest_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "metric_scale_status": {
      "enum": ["validated", "sensor_metric_unvalidated", "anchor_required"]
    },
    "measurement_artifact": {
      "type": "object",
      "required": ["relative_path", "digest"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": [
        "scale_error_fraction",
        "gravity_alignment_error_deg",
        "floor_height_residual_m",
        "wall_offset_residual_m",
        "visual_to_collider_disagreement_m",
        "clearance_error_m",
        "mesh_coverage_fraction",
        "minimum_obstacle_thickness_m"
      ],
      "properties": {
        "scale_error_fraction": {"type": "number", "minimum": 0},
        "gravity_alignment_error_deg": {"type": "number", "minimum": 0},
        "floor_height_residual_m": {"type": "number", "minimum": 0},
        "wall_offset_residual_m": {"type": "number", "minimum": 0},
        "visual_to_collider_disagreement_m": {"type": "number", "minimum": 0},
        "clearance_error_m": {"type": "number", "minimum": 0},
        "mesh_coverage_fraction": {"type": "number", "minimum": 0},
        "minimum_obstacle_thickness_m": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "qa_thresholds_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "independent_evaluator": {
      "type": "object",
      "required": ["method_id", "method_version", "candidate_method_independent"],
      "properties": {
        "method_id": {"type": "string", "minLength": 1},
        "method_version": {"type": "string", "minLength": 1},
        "candidate_method_independent": {"const": true}
      },
      "additionalProperties": false
    },
    "task_region_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "collider_qualification_request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
