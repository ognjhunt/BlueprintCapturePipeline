{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rendered_scene_task_target_pipeline_request.v1.schema.json",
  "title": "Rendered scene task target pipeline request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer",
    "analysis_splat_path",
    "scene_id",
    "source_scene_digest",
    "rendered_views",
    "source_video_available",
    "robot_id",
    "metric_scale_status",
    "collision_support",
    "reach_support",
    "task_context",
    "pipeline_request_digest"
  ],
  "properties": {
    "schema_version": {"const": "rendered_scene_task_target_pipeline_request.v1"},
    "analyzer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyzer_id",
        "implementation_version",
        "analyzer_contract_digest",
        "command",
        "command_execution_authorized",
        "candidate_may_self_authorize"
      ],
      "properties": {
        "analyzer_id": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "analyzer_contract_digest": {"$ref": "#/$defs/digest"},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "command_execution_authorized": {"const": true},
        "candidate_may_self_authorize": {"const": false},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "maximum_output_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "analysis_splat_path": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "source_scene_digest": {"$ref": "#/$defs/digest"},
    "rendered_views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "view_id",
          "rgb_path",
          "rgb_digest",
          "observation_source",
          "camera_spec_digest",
          "image_size",
          "camera"
        ]
      }
    },
    "source_video_available": {"type": "boolean"},
    "robot_id": {"enum": ["franka_panda", "unitree_g1"]},
    "metric_scale_status": {"type": "string", "minLength": 1},
    "collision_support": {"type": "object"},
    "reach_support": {"type": "object"},
    "task_context": {"type": "object"},
    "minimum_visual_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "minimum_opacity": {"type": "number", "minimum": 0},
    "front_depth_fraction": {"type": "number", "exclusiveMinimum": 0},
    "minimum_projected_splats": {"type": "integer", "minimum": 1},
    "pipeline_request_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
