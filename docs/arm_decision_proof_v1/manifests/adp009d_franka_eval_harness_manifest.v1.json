  "task": {
    "task_id": "pick_lift_translate_place_settle_same_support",
    "phases": [
      "approach",
      "grasp",
      "lift",
      "translate",
      "place",
      "release",
      "settle"
    ],
    "success_thresholds": {
      "minimum_lift_m": 0.08,
      "minimum_translation_m": 0.15,
      "maximum_center_error_m": 0.05,
      "maximum_tilt_degrees": 15.0,
      "minimum_settle_duration_s": 1.0,
      "maximum_settled_linear_speed_m_s": 0.02,
      "maximum_settled_angular_speed_rad_s": 0.15,
      "same_support_surface_required": true,
      "grasp_required": true
    },
    "grader_authority": "deterministic_simulator_state",
    "policy_may_grade_itself": false,
    "terminal_precedence": [
      "camera_failure",
      "invalid_observation",
      "policy_runtime_failure",
      "joint_limit_violation",
      "collision_violation",
      "drop",
      "support_loss",
      "success",
      "timeout"
    ],
    "terminal_definitions": {
      "success": {
        "condition": "grasp established, lift >=0.08 m, transport >=0.15 m, released on preregistered target on the same support, settled >=1.0 s, center error <=0.05 m, tilt <=15 degrees"
      },
      "timeout": {
        "condition": "episode horizon expires before another terminal"
      },
      "drop": {
        "condition": "after grasp, object loses gripper support and falls below the support height minus 0.03 m or contacts a forbidden lower surface"
      },
      "support_loss": {
        "condition": "terminal object center or contact footprint leaves the admitted support polygon outside the frozen edge margin"
      },
      "collision_violation": {
        "condition": "robot or object contacts a forbidden environment prim or exceeds the frozen impulse limit"
      },
      "joint_limit_violation": {
        "condition": "any joint exceeds its hard position, velocity, effort, or torque limit after tolerance"
      },
      "camera_failure": {
        "condition": "a required external or wrist frame, calibration, timestamp, metric depth, or segmentation output is missing or stale"
      },
      "invalid_observation": {
        "condition": "policy observation has the wrong schema, shape, device, timing, calibration, finite-value status, or retained-frame digest"
      },
      "policy_runtime_failure": {
        "condition": "policy process errors, misses the frozen deadline, returns an invalid action, or violates its admitted runtime contract"
      }
    }
  },
