FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HOME=/opt/hf
ENV THREEDGRUT_DIR=/opt/3dgrut
ENV FIXER_DIR=/opt/Fixer
ENV FIXER_WEIGHTS_DIR=/opt/Fixer/weights
ENV DA3_MODEL_PATH=/opt/da3/weights/metric_large
ENV COLMAP_CUDA_ARCHS=89

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
    git \
    tmux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app

RUN chmod +x /app/scripts/install_colmap_cuda.sh /app/scripts/install_ml_stack.sh && \
    /app/scripts/install_ml_stack.sh

# Vast.ai launches containers expecting an always-running process.
ENTRYPOINT ["bash", "-lc", "sleep infinity"]
